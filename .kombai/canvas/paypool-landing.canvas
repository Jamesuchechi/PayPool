 data-kid=\"1-7-1\" data-name=\"section content wrapper\">\n            <div class=\"reveal border border-white/12 bg-[#002147]/50\" data-kid=\"1-7-1-1\" data-name=\"code editor box\">\n                <div class=\"flex items-center gap-2 px-4 py-2.5 border-b border-white/10 bg-[#010B13]\" data-kid=\"1-7-1-1-1\" data-name=\"editor header\">\n                    <span class=\"w-2.5 h-2.5 rounded-full bg-[#FF00FF]/70\" data-kid=\"1-7-1-1-1-1\">\n                    </span>\n                    <span class=\"w-2.5 h-2.5 rounded-full bg-white/25\" data-kid=\"1-7-1-1-1-2\">\n                    </span>\n                    <span class=\"w-2.5 h-2.5 rounded-full bg-[#00FF40]/70\" data-kid=\"1-7-1-1-1-3\">\n                    </span>\n                    <span class=\"fm text-[11px] text-white/45 ml-2\" data-kid=\"1-7-1-1-1-4\">\n                        contracts/src/PayPool.sol\n                    </span>\n                    <button class=\"ml-auto fm text-[10px] text-[#00FF40] border border-[#00FF40]/35 px-2.5 py-1 hover:bg-[#00FF40]/10 flex items-center gap-1.5\" data-kid=\"1-7-1-1-1-5\" data-name=\"copy button\">\n                        <i class=\"ti ti-copy text-[11px]\" data-kid=\"1-7-1-1-1-5-1\">\n                        </i>\n                        copy\n                    </button>\n                </div>\n                <pre class=\"fm text-[11.5px] leading-[1.95] p-5 overflow-x-auto\" data-kid=\"1-7-1-1-2\" data-name=\"contract code content\"><span class=\"text-white/30\" data-kid=\"1-7-1-1-2-1\">// SPDX-License-Identifier: MIT</span>\n<span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-2\">pragma</span> solidity <span class=\"text-[#00FF40]\" data-kid=\"1-7-1-1-2-3\">^0.8.24</span>;\n\n<span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-4\">interface</span> <span class=\"text-white\" data-kid=\"1-7-1-1-2-5\">IPayPool</span> {\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-6\">event</span> PaymentReceived(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-7\">address</span> indexed from, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-8\">address</span> indexed token, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-9\">uint256</span> amount);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-10\">event</span> PaymentReleased(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-11\">address</span> indexed to, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-12\">address</span> indexed token, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-13\">uint256</span> amount);\n\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-14\">function</span> initialize(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-15\">address[]</span> calldata payees, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-16\">uint256[]</span> calldata shares) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-17\">external</span>;\n\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-18\">receive</span>() <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-19\">external payable</span>;\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-20\">function</span> depositERC20(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-21\">address</span> token, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-22\">uint256</span> amount) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-23\">external</span>;\n\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-24\">function</span> <span class=\"bg-[#00FF40]/15 text-[#00FF40] px-1\" data-kid=\"1-7-1-1-2-25\">release</span>(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-26\">address</span> payee, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-27\">address</span> token) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-28\">external</span>;\n\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-29\">function</span> <span class=\"bg-[#00FF40]/15 text-[#00FF40] px-1\" data-kid=\"1-7-1-1-2-30\">pendingPayment</span>(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-31\">address</span> payee, <span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-32\">address</span> token) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-33\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-34\">uint256</span>);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-35\">function</span> <span class=\"bg-[#00FF40]/15 text-[#00FF40] px-1\" data-kid=\"1-7-1-1-2-36\">totalReceived</span>(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-37\">address</span> token) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-38\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-39\">uint256</span>);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-40\">function</span> totalReleased(<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-41\">address</span> token) <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-42\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-43\">uint256</span>);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-44\">function</span> getPayees() <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-45\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-46\">address[]</span> memory);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-47\">function</span> getShares() <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-48\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-49\">uint256[]</span> memory);\n  <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-1-2-50\">function</span> totalShares() <span class=\"text-white/45\" data-kid=\"1-7-1-1-2-51\">external view returns</span> (<span class=\"text-[#60A5FA]\" data-kid=\"1-7-1-1-2-52\">uint256</span>);\n}</pre>\n                <div class=\"fm text-[10.5px] text-white/40 px-5 py-3 border-t border-white/10 bg-[#010B13] leading-relaxed\" data-kid=\"1-7-1-1-3\" data-name=\"editor footer note\">\n                    <span class=\"text-white/70\" data-kid=\"1-7-1-1-3-1\">\n                        address(0)\n                    </span>\n                    == native ETH throughout the contract and every event ·\n                    <span class=\"text-white/70\" data-kid=\"1-7-1-1-3-2\">\n                        TOTAL_SHARE_UNITS = 10_000\n                    </span>\n                </div>\n            </div>\n            <div class=\"lg:pt-6\" data-kid=\"1-7-1-2\" data-name=\"formula explanation container\">\n                <div class=\"reveal fm text-[11px] text-[#FF00FF] uppercase tracking-[0.22em]\" data-kid=\"1-7-1-2-1\" data-name=\"section subheadline\">\n                    Payout formula\n                </div>\n                <div class=\"reveal fm text-[17px] xl:text-[20px] leading-[1.75] mt-5 text-white/85 border-l-2 border-[#00FF40] pl-5\" data-kid=\"1-7-1-2-2\" data-name=\"payout formula display\">\n                    pending = (\n                    <span class=\"text-[#00FF40]\" data-kid=\"1-7-1-2-2-1\">\n                        totalReceived\n                    </span>\n                    * shares / totalShares)\n                    <br data-kid=\"1-7-1-2-2-2\"/>\n                    −\n                    <span class=\"text-[#FF00FF]\" data-kid=\"1-7-1-2-2-3\">\n                        released\n                    </span>\n                </div>\n                <p class=\"reveal text-[15px] text-white/55 mt-7 leading-relaxed\" data-kid=\"1-7-1-2-3\" data-name=\"formula description\">\n                    Shares are basis points out of a fixed\n                    <span class=\"fm text-white/85\" data-kid=\"1-7-1-2-3-1\">\n                        10_000\n                    </span>\n                    . Initialization reverts unless\n                    <span class=\"fm text-white/85\" data-kid=\"1-7-1-2-3-2\">\n                        sum(shares) == 10_000\n                    </span>\n                    , payee count is between 2 and 20, and no address is zero or duplicated.\n                </p>\n                <div class=\"reveal mt-8 grid grid-cols-2 gap-3 fm text-[10.5px]\" data-kid=\"1-7-1-2-4\" data-name=\"technical details grid\">\n                    <div class=\"border border-white/10 bg-[#002147]/50 p-3\" data-kid=\"1-7-1-2-4-1\">\n                        <div class=\"text-white/40\" data-kid=\"1-7-1-2-4-1-1\">\n                            deploy pattern\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-7-1-2-4-1-2\">\n                            Clones.clone()\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 bg-[#002147]/50 p-3\" data-kid=\"1-7-1-2-4-2\">\n                        <div class=\"text-white/40\" data-kid=\"1-7-1-2-4-2-1\">\n                            reinit guard\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-7-1-2-4-2-2\">\n                            initialized bool\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 bg-[#002147]/50 p-3\" data-kid=\"1-7-1-2-4-3\">\n                        <div class=\"text-white/40\" data-kid=\"1-7-1-2-4-3-1\">\n                            approve flow\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-7-1-2-4-3-2\">\n                            ERC-20 approve()\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 bg-[#002147]/50 p-3\" data-kid=\"1-7-1-2-4-4\">\n                        <div class=\"text-white/40\" data-kid=\"1-7-1-2-4-4-1\">\n                            license\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-7-1-2-4-4-2\">\n                            MIT\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ARCHITECTURE BENTO -->\n    <section class=\"max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-8\" data-name=\"architecture bento section\" id=\"arch\">\n        <h2 class=\"reveal fh text-[44px] leading-[1] font-bold tracking-[-0.02em] mb-4\" data-kid=\"1-8-1\" data-name=\"section headline\">\n            Architecture & stack\n        </h2>\n        <p class=\"reveal text-white/55 max-w-xl mb-6 text-[16px]\" data-kid=\"1-8-2\" data-name=\"section description\">\n            Cell size tracks actual complexity — the contract and the indexer carry the weight.\n        </p>\n        <div class=\"reveal fm text-[11px] text-white/45 border border-white/10 bg-[#002147]/40 px-4 py-3 mb-8 flex flex-wrap items-center gap-x-3 gap-y-2\" data-kid=\"1-8-3\" data-name=\"tech stack flow chart\">\n            <span class=\"text-[#00FF40]\" data-kid=\"1-8-3-1\">\n                chain logs\n            </span>\n            <span class=\"text-white/25\" data-kid=\"1-8-3-2\">\n                →\n            </span>\n            <span data-kid=\"1-8-3-3\">\n                eth_getLogs backfill\n            </span>\n            <span class=\"text-white/25\" data-kid=\"1-8-3-4\">\n                →\n            </span>\n            <span data-kid=\"1-8-3-5\">\n                Postgres\n            </span>\n            <span class=\"text-white/25\" data-kid=\"1-8-3-6\">\n                →\n            </span>\n            <span data-kid=\"1-8-3-7\">\n                REST\n            </span>\n            <span class=\"text-white/25\" data-kid=\"1-8-3-8\">\n                →\n            </span>\n            <span class=\"text-[#FF00FF]\" data-kid=\"1-8-3-9\">\n                dashboard\n            </span>\n        </div>\n        <div class=\"grid lg:grid-cols-3 gap-5\" data-kid=\"1-8-4\" data-name=\"bento grid layout\">\n            <div class=\"reveal lg:col-span-2 lg:row-span-2 border border-white/12 bg-[#002147]/50 p-7 relative overflow-hidden\" data-kid=\"1-8-4-1\" data-name=\"contracts card\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-8-4-1-1\">\n                    <div data-kid=\"1-8-4-1-1-1\">\n                        <div class=\"text-[#00FF40] text-[22px]\" data-kid=\"1-8-4-1-1-1-1\">\n                            <i class=\"ti ti-code\" data-kid=\"1-8-4-1-1-1-1-1\">\n                            </i>\n                        </div>\n                        <h3 class=\"fh text-[26px] font-bold mt-3\" data-kid=\"1-8-4-1-1-1-2\">\n                            Contracts\n                        </h3>\n                        <p class=\"fm text-[11px] text-white/45 mt-1\" data-kid=\"1-8-4-1-1-1-3\">\n                            Solidity 0.8.24 · Foundry · OpenZeppelin Clones\n                        </p>\n                    </div>\n                    <span class=\"fm text-[10px] text-[#00FF40] border border-[#00FF40]/30 px-2 py-1\" data-kid=\"1-8-4-1-1-2\">\n                        core\n                    </span>\n                </div>\n                <p class=\"text-[14.5px] text-white/60 mt-5 max-w-lg leading-relaxed\" data-kid=\"1-8-4-1-2\">\n                    Two files: an implementation cloned per pool, and a factory that deploys and initializes in a single transaction. No proxies, no upgrades, no owner.\n                </p>\n                <div class=\"grid sm:grid-cols-3 gap-3 mt-6 fm text-[10.5px]\" data-kid=\"1-8-4-1-3\">\n                    <div class=\"border border-white/10 bg-[#010B13] p-3\" data-kid=\"1-8-4-1-3-1\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-3-1-1\">\n                            PayPool.sol\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-8-4-1-3-1-2\">\n                            impl · cloned\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 bg-[#010B13] p-3\" data-kid=\"1-8-4-1-3-2\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-3-2-1\">\n                            SplitterFactory.sol\n                        </div>\n                        <div class=\"text-white/85 mt-1.5\" data-kid=\"1-8-4-1-3-2-2\">\n                            CREATE clone\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 bg-[#010B13] p-3\" data-kid=\"1-8-4-1-3-3\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-3-3-1\">\n                            forge test\n                        </div>\n                        <div class=\"text-[#00FF40] mt-1.5\" data-kid=\"1-8-4-1-3-3-2\">\n                            8 specs · 1 invariant\n                        </div>\n                    </div>\n                </div>\n                <pre class=\"fm text-[10.5px] leading-[1.9] mt-6 border border-white/10 bg-[#010B13] p-4 overflow-x-auto text-white/70\" data-kid=\"1-8-4-1-4\"><span class=\"text-[#FF00FF]\" data-kid=\"1-8-4-1-4-1\">event</span> SplitterCreated(<span class=\"text-[#60A5FA]\" data-kid=\"1-8-4-1-4-2\">address</span> indexed pool, <span class=\"text-[#60A5FA]\" data-kid=\"1-8-4-1-4-3\">address</span> indexed creator,\n                      <span class=\"text-[#60A5FA]\" data-kid=\"1-8-4-1-4-4\">address[]</span> payees, <span class=\"text-[#60A5FA]\" data-kid=\"1-8-4-1-4-5\">uint256[]</span> shares, <span class=\"text-[#60A5FA]\" data-kid=\"1-8-4-1-4-6\">string</span> name);</pre>\n                <div class=\"mt-6 grid sm:grid-cols-4 gap-3 fm text-[10.5px]\" data-kid=\"1-8-4-1-5\">\n                    <div class=\"border border-white/10 px-3 py-2.5\" data-kid=\"1-8-4-1-5-1\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-5-1-1\">\n                            clone deploy\n                        </div>\n                        <div class=\"text-[#00FF40] mt-1\" data-kid=\"1-8-4-1-5-1-2\">\n                            ~112k gas\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 px-3 py-2.5\" data-kid=\"1-8-4-1-5-2\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-5-2-1\">\n                            full deploy\n                        </div>\n                        <div class=\"text-white/80 mt-1\" data-kid=\"1-8-4-1-5-2-2\">\n                            ~1.24M gas\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 px-3 py-2.5\" data-kid=\"1-8-4-1-5-3\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-5-3-1\">\n                            release(ETH)\n                        </div>\n                        <div class=\"text-white/80 mt-1\" data-kid=\"1-8-4-1-5-3-2\">\n                            ~38k gas\n                        </div>\n                    </div>\n                    <div class=\"border border-white/10 px-3 py-2.5\" data-kid=\"1-8-4-1-5-4\">\n                        <div class=\"text-white/40\" data-kid=\"1-8-4-1-5-4-1\">\n                            owner role\n                        </div>\n                        <div class=\"text-[#FF00FF] mt-1\" data-kid=\"1-8-4-1-5-4-2\">\n                            none\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"reveal border border-white/12 bg-[#002147]/50 p-6\" data-kid=\"1-8-4-2\" data-name=\"indexer card\">\n                <div class=\"text-[#FF00FF] text-[20px]\" data-kid=\"1-8-4-2-1\">\n                    <i class=\"ti ti-server\" data-kid=\"1-8-4-2-1-1\">\n                    </i>\n                </div>\n                <h3 class=\"fh text-[20px] font-bold mt-3\" data-kid=\"1-8-4-2-2\">\n                    Indexer\n                </h3>\n                <p class=\"fm text-[11px] text-white/45 mt-1\" data-kid=\"1-8-4-2-3\">\n                    Python · FastAPI · ARQ\n                </p>\n                <div class=\"mt-4 space-y-1.5 fm text-[10.5px]\" data-kid=\"1-8-4-2-4\">\n                    <div class=\"flex justify-between border-b border-white/5 pb-1.5\" data-kid=\"1-8-4-2-4-1\">\n                        <span class=\"text-white/40\" data-kid=\"1-8-4-2-4-1-1\">\n                            CONFIRMATION_DEPTH\n                        </span>\n                        <span class=\"text-[#00FF40]\" data-kid=\"1-8-4-2-4-1-2\">\n                            5\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between border-b border-white/5 pb-1.5\" data-kid=\"1-8-4-2-4-2\">\n                        <span class=\"text-white/40\" data-kid=\"1-8-4-2-4-2-1\">\n                            BATCH_SIZE\n                        </span>\n                        <span class=\"text-[#00FF40]\" data-kid=\"1-8-4-2-4-2-2\">\n                            2000\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between border-b border-white/5 pb-1.5\" data-kid=\"1-8-4-2-4-3\">\n                        <span class=\"text-white/40\" data-kid=\"1-8-4-2-4-3-1\">\n                            POLL_INTERVAL\n                        </span>\n                        <span class=\"text-[#00FF40]\" data-kid=\"1-8-4-2-4-3-2\">\n                            15s\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between\" data-kid=\"1-8-4-2-4-4\">\n                        <span class=\"text-white/40\" data-kid=\"1-8-4-2-4-4-1\">\n                            CHAIN_ID\n                        </span>\n                        <span class=\"text-[#00FF40]\" data-kid=\"1-8-4-2-4-4-2\">\n                            84532\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"reveal border border-white/12 bg-[#002147]/50 p-6\" data-kid=\"1-8-4-3\" data-name=\"database card\">\n                <div class=\"text-[#00FF40] text-[20px]\" data-kid=\"1-8-4-3-1\">\n                    <i class=\"ti ti-database\" data-kid=\"1-8-4-3-1-1\">\n                    </i>\n                </div>\n                <h3 class=\"fh text-[20px] font-bold mt-3\" data-kid=\"1-8-4-3-2\">\n                    Database\n                </h3>\n                <p class=\"fm text-[11px] text-white/45 mt-1\" data-kid=\"1-8-4-3-3\">\n                    PostgreSQL\n                </p>\n                <pre class=\"fm text-[10px] leading-[1.85] mt-4 border border-white/10 bg-[#010B13] p-3 overflow-x-auto text-white/70\" data-kid=\"1-8-4-3-4\">UNIQUE (tx_hash, log_index)\n<span class=\"text-[#00FF40]\" data-kid=\"1-8-4-3-4-1\">ON CONFLICT DO NOTHING</span></pre>\n                <p class=\"text-[13px] text-white/55 mt-3 leading-relaxed\" data-kid=\"1-8-4-3-5\">\n                    Idempotent upserts make the backfill loop safe to re-run from any block.\n                </p>\n            </div>\n            <div class=\"reveal lg:col-span-3 border border-white/12 bg-[#002147]/50 p-6 flex flex-col lg:flex-row lg:items-center gap-6\" data-kid=\"1-8-4-4\" data-name=\"frontend card\">\n                <div class=\"lg:w-1/3\" data-kid=\"1-8-4-4-1\">\n                    <div class=\"text-[#60A5FA] text-[20px]\" data-kid=\"1-8-4-4-1-1\">\n                        <i class=\"ti ti-layout\" data-kid=\"1-8-4-4-1-1-1\">\n                        </i>\n                    </div>\n                    <h3 class=\"fh text-[20px] font-bold mt-3\" data-kid=\"1-8-4-4-1-2\">\n                        Frontend\n                    </h3>\n                    <p class=\"fm text-[11px] text-white/45 mt-1\" data-kid=\"1-8-4-4-1-3\">\n                        React · Vite · viem / wagmi\n                    </p>\n                </div>\n                <p class=\"text-[14px] text-white/60 lg:w-1/3 leading-relaxed\" data-kid=\"1-8-4-4-2\">\n                    Reads the REST API for history, and the chain directly for anything a payee needs to trust. The dashboard never custodies a key or a token.\n                </p>\n                <div class=\"lg:w-1/3 fm text-[10.5px] grid grid-cols-2 gap-2\" data-kid=\"1-8-4-4-3\">\n                    <div class=\"border border-white/10 bg-[#010B13] px-3 py-2 text-white/70\" data-kid=\"1-8-4-4-3-1\">\n                        GET /pools\n                    </div>\n                    <div class=\"border border-white/10 bg-[#010B13] px-3 py-2 text-white/70\" data-kid=\"1-8-4-4-3-2\">\n                        GET /health\n                    </div>\n                    <div class=\"border border-white/10 bg-[#010B13] px-3 py-2 text-white/70\" data-kid=\"1-8-4-4-3-3\">\n                        /deposits\n                    </div>\n                    <div class=\"border border-white/10 bg-[#010B13] px-3 py-2 text-white/70\" data-kid=\"1-8-4-4-3-4\">\n                        /earnings\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- USE CASES -->\n    <section class=\"border-y border-white/10 bg-[#002147]/15\" data-kid=\"1-9\" data-name=\"use cases section\">\n        <div class=\"max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-9-1\" data-name=\"section container\">\n            <h2 class=\"reveal fh text-[44px] leading-[1] font-bold tracking-[-0.02em] mb-12\" data-kid=\"1-9-1-1\" data-name=\"section headline\">\n                Who splits what\n            </h2>\n            <div class=\"grid lg:grid-cols-[0.85fr_1.15fr] gap-8\" data-kid=\"1-9-1-2\" data-name=\"navigation and pane grid\">\n                <div class=\"uc-nav divide-y divide-white/10 border-y border-white/10\" data-kid=\"1-9-1-2-1\" data-name=\"use case navigation list\">\n                    <button class=\"uc-item w-full text-left px-5 py-5 flex items-center gap-4\" data-kid=\"1-9-1-2-1-1\" data-uc=\"0\">\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-9-1-2-1-1-1\">\n                            01\n                        </span>\n                        <span class=\"fh text-[19px] font-medium flex-1\" data-kid=\"1-9-1-2-1-1-2\">\n                            Band royalties\n                        </span>\n                        <i class=\"ti ti-arrow-right text-[16px] uc-arrow text-white/30\" data-kid=\"1-9-1-2-1-1-3\">\n                        </i>\n                    </button>\n                    <button class=\"uc-item w-full text-left px-5 py-5 flex items-center gap-4\" data-kid=\"1-9-1-2-1-2\" data-uc=\"1\">\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-9-1-2-1-2-1\">\n                            02\n                        </span>\n                        <span class=\"fh text-[19px] font-medium flex-1\" data-kid=\"1-9-1-2-1-2-2\">\n                            Grant disbursement\n                        </span>\n                        <i class=\"ti ti-arrow-right text-[16px] uc-arrow text-white/30\" data-kid=\"1-9-1-2-1-2-3\">\n                        </i>\n                    </button>\n                    <button class=\"uc-item w-full text-left px-5 py-5 flex items-center gap-4\" data-kid=\"1-9-1-2-1-3\" data-uc=\"2\">\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-9-1-2-1-3-1\">\n                            03\n                        </span>\n                        <span class=\"fh text-[19px] font-medium flex-1\" data-kid=\"1-9-1-2-1-3-2\">\n                            OSS contributor payouts\n                        </span>\n                        <i class=\"ti ti-arrow-right text-[16px] uc-arrow text-white/30\" data-kid=\"1-9-1-2-1-3-3\">\n                        </i>\n                    </button>\n                    <button class=\"uc-item w-full text-left px-5 py-5 flex items-center gap-4\" data-kid=\"1-9-1-2-1-4\" data-uc=\"3\">\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-9-1-2-1-4-1\">\n                            04\n                        </span>\n                        <span class=\"fh text-[19px] font-medium flex-1\" data-kid=\"1-9-1-2-1-4-2\">\n                            DAO revenue share\n                        </span>\n                        <i class=\"ti ti-arrow-right text-[16px] uc-arrow text-white/30\" data-kid=\"1-9-1-2-1-4-3\">\n                        </i>\n                    </button>\n                    <div class=\"px-5 py-5 fm text-[10.5px] text-white/40 leading-relaxed\" data-kid=\"1-9-1-2-1-5\">\n                        Every scenario above is the same contract with a different\n                        <span class=\"text-white/70\" data-kid=\"1-9-1-2-1-5-1\">\n                            shares[]\n                        </span>\n                        array. 2–20 payees, always summing to 10,000 bps.\n                    </div>\n                </div>\n                <div class=\"border border-white/12 bg-[#002147]/45 p-7 min-h-[380px]\" data-kid=\"1-9-1-2-2\" data-name=\"use case details display\">\n                    <div data-dynamic=\"true\" data-kid=\"1-9-1-2-2-1\" data-name=\"use case content container\" data-reason=\"content dynamically rendered by JS\" id=\"ucPane\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECURITY -->\n    <section class=\"max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-10\" data-name=\"security section\" id=\"security\">\n        <div class=\"grid lg:grid-cols-[1fr_1.15fr] gap-10 items-center mb-10\" data-kid=\"1-10-1\" data-name=\"security content container\">\n            <div data-kid=\"1-10-1-1\">\n                <h2 class=\"reveal fh text-[40px] leading-[1.02] font-bold tracking-[-0.02em]\" data-kid=\"1-10-1-1-1\">\n                    Invariants, not assurances\n                </h2>\n                <p class=\"reveal text-white/55 mt-4 text-[15px] leading-relaxed\" data-kid=\"1-10-1-1-2\">\n                    One property has to hold across every randomized sequence of deposits and releases. Foundry fuzzes it 256 runs deep.\n                </p>\n                <div class=\"reveal fm text-[10.5px] text-white/40 mt-5\" data-kid=\"1-10-1-1-3\">\n                    contracts/test/PayPool.invariants.t.sol · forge test --match-path\n                </div>\n            </div>\n            <div class=\"reveal fm text-[17px] xl:text-[21px] border border-[#00FF40]/30 bg-[#00FF40]/[0.06] p-6 leading-[1.7] text-white/90\" data-kid=\"1-10-1-2\" data-name=\"invariant formula display\">\n                <span class=\"text-[#00FF40]\" data-kid=\"1-10-1-2-1\">\n                    totalReceived\n                </span>\n                ==\n                <br data-kid=\"1-10-1-2-2\"/>\n                totalReleased +\n                <span class=\"text-[#FF00FF]\" data-kid=\"1-10-1-2-3\">\n                    sum(pending)\n                </span>\n            </div>\n        </div>\n        <div data-kid=\"1-10-2\" data-name=\"test results container\">\n            <div class=\"reveal border border-white/12 overflow-x-auto\" data-kid=\"1-10-2-1\" data-name=\"test results table\">\n                <table class=\"w-full fm text-[11.5px] min-w-[820px]\" data-kid=\"1-10-2-1-1\">\n                    <thead data-kid=\"1-10-2-1-1-1\">\n                        <tr class=\"text-left text-white/40 bg-[#010B13] border-b border-white/10\" data-kid=\"1-10-2-1-1-1-1\">\n                            <th class=\"px-4 py-3 font-medium\" data-kid=\"1-10-2-1-1-1-1-1\">\n                                Test\n                            </th>\n                            <th class=\"px-4 py-3 font-medium\" data-kid=\"1-10-2-1-1-1-1-2\">\n                                Type\n                            </th>\n                            <th class=\"px-4 py-3 font-medium\" data-kid=\"1-10-2-1-1-1-1-3\">\n                                Asserts\n                            </th>\n                            <th class=\"px-4 py-3 font-medium\" data-kid=\"1-10-2-1-1-1-1-4\">\n                                Status\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"text-white/75 bg-[#002147]/40\" data-kid=\"1-10-2-1-1-2\">\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-1\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-1-1\">\n                                test_initialize_validates_shares\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-1-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-1-3\">\n                                sum != 10,000 reverts\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-1-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-1-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-2\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-2-1\">\n                                test_initialize_rejects_duplicate_payee\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-2-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-2-3\">\n                                duplicate address reverts\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-2-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-2-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-3\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-3-1\">\n                                test_deposit_eth_updates_totalReceived\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-3-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-3-3\">\n                                totalReceived(address(0)) += amount\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-3-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-3-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-4\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-4-1\">\n                                test_release_pays_correct_share\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-4-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-4-3\">\n                                exact proportional balance delta\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-4-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-4-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-5\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-5-1\">\n                                test_release_twice_second_call_pays_zero_delta\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-5-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-5-3\">\n                                no double-payment\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-5-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-5-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5\" data-kid=\"1-10-2-1-1-2-6\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-6-1\">\n                                test_cannot_reinitialize\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-6-2\">\n                                unit\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-6-3\">\n                                second initialize() reverts\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-6-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-6-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-white/5 bg-[#00FF40]/[0.04]\" data-kid=\"1-10-2-1-1-2-7\">\n                            <td class=\"px-4 py-3 text-white\" data-kid=\"1-10-2-1-1-2-7-1\">\n                                invariant_conservation_of_funds\n                            </td>\n                            <td class=\"px-4 py-3 text-[#FF00FF]\" data-kid=\"1-10-2-1-1-2-7-2\">\n                                fuzz\n                            </td>\n                            <td class=\"px-4 py-3 text-white/60\" data-kid=\"1-10-2-1-1-2-7-3\">\n                                totalReceived == totalReleased + sum(pending)\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-7-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-7-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-10-2-1-1-2-8\">\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-8-1\">\n                                test_gas_clone_vs_full_deploy\n                            </td>\n                            <td class=\"px-4 py-3 text-white/45\" data-kid=\"1-10-2-1-1-2-8-2\">\n                                benchmark\n                            </td>\n                            <td class=\"px-4 py-3 text-white/50\" data-kid=\"1-10-2-1-1-2-8-3\">\n                                clone gas documented vs full deploy\n                            </td>\n                            <td class=\"px-4 py-3\" data-kid=\"1-10-2-1-1-2-8-4\">\n                                <span class=\"text-[#00FF40] border border-[#00FF40]/40 bg-[#00FF40]/10 px-2 py-0.5\" data-kid=\"1-10-2-1-1-2-8-4-1\">\n                                    PASS\n                                </span>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"fm text-[10px] text-white/40 px-4 py-3 border-t border-white/10 bg-[#010B13]\" data-kid=\"1-10-2-1-2\">\n                    Ran 8 tests · 256 fuzz runs · 0 failed — see SECURITY.md for the full threat model\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- FAQ -->\n    <section class=\"border-t border-white/10\" data-kid=\"1-11\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-[900px] mx-auto px-6 py-24\" data-kid=\"1-11-1\" data-name=\"faq wrapper\">\n            <h2 class=\"reveal fh text-[40px] font-bold tracking-[-0.02em] mb-3\" data-kid=\"1-11-1-1\" data-name=\"faq section headline\">\n                Deliberate decisions\n            </h2>\n            <p class=\"reveal text-white/55 mb-12 text-[16px]\" data-kid=\"1-11-1-2\" data-name=\"faq section description\">\n                Out of scope for v1, and documented as choices rather than gaps.\n            </p>\n            <div class=\"faq border-t border-white/10\" data-dynamic=\"true\" data-kid=\"1-11-1-3\" data-name=\"faq items container\" data-reason=\"items rendered by JS\">\n            </div>\n        </div>\n    </section>\n    <!-- CTA + FOOTER -->\n    <section class=\"relative overflow-hidden border-t border-white/10\" data-kid=\"1-12\" data-name=\"footer call-to-action section\" id=\"cta\">\n        <div class=\"absolute inset-0 flex flex-col justify-center gap-2 pointer-events-none select-none\" data-kid=\"1-12-1\" data-name=\"scrolling text marquee layer\">\n            <div class=\"flex w-max mq-slow fh font-bold text-[120px] leading-none text-white/[0.045] whitespace-nowrap\" data-kid=\"1-12-1-1\">\n                <span class=\"px-8\" data-kid=\"1-12-1-1-1\">\n                    TRUSTLESS REVENUE SPLITTING\n                </span>\n                <span class=\"px-8\" data-kid=\"1-12-1-1-2\">\n                    TRUSTLESS REVENUE SPLITTING\n                </span>\n            </div>\n            <div class=\"flex w-max mq fh font-bold text-[120px] leading-none text-[#00FF40]/[0.05] whitespace-nowrap\" data-kid=\"1-12-1-2\" style=\"animation-direction:reverse\">\n                <span class=\"px-8\" data-kid=\"1-12-1-2-1\">\n                    DEPLOY · FUND · WITHDRAW\n                </span>\n                <span class=\"px-8\" data-kid=\"1-12-1-2-2\">\n                    DEPLOY · FUND · WITHDRAW\n                </span>\n            </div>\n        </div>\n        <div class=\"relative max-w-[1240px] mx-auto px-6 py-32 text-center\" data-kid=\"1-12-2\" data-name=\"call-to-action content container\">\n            <div class=\"reveal fm text-[11px] text-white/45 tracking-[0.22em] uppercase mb-6\" data-kid=\"1-12-2-1\">\n                Chain ID 84532 · testnet · MIT\n            </div>\n            <h2 class=\"reveal fh text-[48px] lg:text-[60px] leading-[0.98] font-bold tracking-[-0.03em] max-w-3xl mx-auto\" data-kid=\"1-12-2-2\">\n                The contract is the custodian.\n            </h2>\n            <div class=\"reveal mt-10 flex flex-wrap justify-center gap-4\" data-kid=\"1-12-2-3\">\n                <a class=\"cta-mag fh font-bold text-[16px] bg-[#00FF40] text-[#010B13] px-9 py-4.5 py-4 clipbtn\" data-kid=\"1-12-2-3-1\" href=\"#\">\n                    <span class=\"glow\" data-kid=\"1-12-2-3-1-1\">\n                    </span>\n                    <span class=\"relative\" data-kid=\"1-12-2-3-1-2\">\n                        Deploy a pool on Base Sepolia\n                    </span>\n                </a>\n                <a class=\"fh font-medium text-[16px] border border-white/20 text-white/80 px-9 py-4 hover:border-[#00FF40] hover:text-[#00FF40]\" data-kid=\"1-12-2-3-2\" href=\"#contracts\">\n                    forge test\n                </a>\n            </div>\n        </div>\n    </section>\n    <footer class=\"border-t border-white/10\" data-kid=\"1-13\" data-name=\"footer\">\n        <div class=\"max-w-[1240px] mx-auto px-6 py-6 flex flex-wrap items-center gap-y-4 gap-x-8\" data-kid=\"1-13-1\" data-name=\"footer wrapper\">\n            <div class=\"fh font-bold flex items-center gap-2 text-[15px]\" data-kid=\"1-13-1-1\">\n                <span class=\"w-2 h-5 bg-[#00FF40] inline-block\" data-kid=\"1-13-1-1-1\">\n                </span>\n                PayPool\n            </div>\n            <nav class=\"fm text-[11px] text-white/45 flex flex-wrap gap-6 mx-auto\" data-kid=\"1-13-1-2\">\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-13-1-2-1\" href=\"#\">\n                    Docs\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-13-1-2-2\" href=\"#\">\n                    ARCHITECTURE.md\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-13-1-2-3\" href=\"#\">\n                    SECURITY.md\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-13-1-2-4\" href=\"#\">\n                    GitHub\n                </a>\n            </nav>\n            <div class=\"fm text-[11px] text-white/30\" data-kid=\"1-13-1-3\">\n                MIT License · no protocol fee\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n/* typewriter */\n(function(){\n  const el=document.getElementById('tw');\n  const words=['splits itself','pays everyone','needs no trust'];\n  let w=0,i=0,del=false;\n  function tick(){\n    const cur=words[w];\n    el.textContent = del? cur.slice(0,--i) : cur.slice(0,++i);\n    let d=del?45:80;\n    if(!del && i===cur.length){del=true;d=1600;}\n    else if(del && i===0){del=false;w=(w+1)%words.length;d=250;}\n    setTimeout(tick,d);\n  }\n  tick();\n})();\n\n/* magnetic pointer glow on CTAs */\ndocument.querySelectorAll('.cta-mag').forEach(btn=>{\n  const g=btn.querySelector('.glow');\n  btn.addEventListener('pointermove',e=>{\n    const r=btn.getBoundingClientRect();\n    gsap.to(g,{x:e.clientX-r.left,y:e.clientY-r.top,opacity:.5,duration:.25,overwrite:true});\n  });\n  btn.addEventListener('pointerleave',()=>gsap.to(g,{opacity:0,duration:.3}));\n});\n\n/* entrances */\ngsap.from('.hero-el',{autoAlpha:0,y:26,duration:.7,ease:'power3.out',stagger:.09});\ngsap.from('.hero-diagram',{autoAlpha:0,y:34,duration:.9,ease:'power3.out',delay:.25});\ndocument.querySelectorAll('.reveal').forEach(el=>{\n  gsap.from(el,{scrollTrigger:{trigger:el,start:'top 88%'},autoAlpha:0,y:24,duration:.6,ease:'power3.out'});\n});\n\n/* scrub-draw connector chain */\n(function(){\n  const p=document.getElementById('chainPath');\n  if(!p)return;\n  const len=p.getTotalLength();\n  gsap.set(p,{strokeDasharray:len,strokeDashoffset:len});\n  gsap.to(p,{strokeDashoffset:0,ease:'none',scrollTrigger:{trigger:'#how',start:'top 70%',end:'bottom 70%',scrub:true}});\n})();\n\n/* scroll-scrubbed reveal of the split tubes */\ngsap.utils.toArray('.dpath').forEach((p)=>{\n  const len=p.getTotalLength();\n  gsap.fromTo(p,{opacity:0},{opacity:1,duration:.5,delay:.5+Math.random()*.4,ease:'none'});\n});\n\n/* counters */\ndocument.querySelectorAll('.cnt').forEach(el=>{\n  const to=parseFloat(el.dataset.to);\n  const o={v:0};\n  gsap.to(o,{v:to,duration:2,ease:'power2.out',scrollTrigger:{trigger:el,start:'top 92%'},onUpdate(){el.textContent=o.v.toFixed(4);}});\n});\n\n/* chart */\nnew Chart(document.getElementById('depChart'),{\n  type:'bar',\n  data:{labels:['…600','…620','…640','…660','…680','…700','…720','…740','…760'],\n    datasets:[\n      {type:'bar',label:'deposits',data:[0.12,0.05,0.31,0.09,0.08,0.24,0.19,0.11,0.16],backgroundColor:'rgba(0,255,64,0.35)',borderColor:'#00FF40',borderWidth:1},\n      {type:'line',label:'cumulative',data:[0.12,0.17,0.48,0.57,0.65,0.89,1.08,1.19,1.35],borderColor:'#FF00FF',borderWidth:1.5,pointRadius:0,tension:.3,yAxisID:'y1'}\n    ]},\n  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{bodyFont:{family:'JetBrains Mono'}}},\n    scales:{x:{ticks:{color:'#ffffff40',font:{size:8,family:'JetBrains Mono'}},grid:{display:false}},\n      y:{ticks:{color:'#ffffff40',font:{size:8,family:'JetBrains Mono'}},grid:{color:'rgba(255,255,255,0.06)'}},\n      y1:{display:false}}}\n});\n\n/* use cases */\nconst UC=[\n  {t:'4-person band, 2500 bps each',d:'Royalties land monthly from a distributor wallet. Nobody manages a bank account; each member calls release() whenever they want their cut. Splits were fixed at deploy, so the argument about who edited the spreadsheet cannot happen.',rows:[['0x9f21…4ab8','2500','vocals'],['0x3c8d…71e0','2500','guitar'],['0xbb14…09f2','2500','bass'],['0x6e07…d3a5','2500','drums']],pool:'Band Royalties',amt:'1.0528 ETH received · 9 deposits'},\n  {t:'Grant split across 3 workstreams',d:'A 5 ETH grant is paid into one pool address. Research takes 5000 bps, tooling 3000, docs 2000. The funder verifies allocation on-chain before sending, and never needs a follow-up invoice.',rows:[['0x21ab…77c4','5000','research'],['0x8de1…03b9','3000','tooling'],['0xf40c…5511','2000','docs']],pool:'Grant Q3',amt:'5.0000 ETH received · 1 deposit'},\n  {t:'OSS maintainers, weighted by upkeep',d:'Sponsorship income routes to the pool. The lead maintainer holds 4500 bps, two regular reviewers 2500 and 2000, and a docs contributor 1000. New contributors get a new pool rather than a mutated one.',rows:[['0x0c72…19ee','4500','lead'],['0x5b8f…a204','2500','reviewer'],['0xd317…8e60','2000','reviewer'],['0x7fa2…c003','1000','docs']],pool:'core-repo sponsors',amt:'0.7314 ETH received · 22 deposits'},\n  {t:'DAO revenue share to 6 contributors',d:'Protocol fees stream to the pool weekly in USDC and ETH. address(0) accounting means one contract handles both without a second code path, and the treasury multisig never holds member funds.',rows:[['0x4a19…b7d2','2500','ops'],['0x93c0…1f4a','2000','eng'],['0xac55…6b18','2000','eng'],['0x1d8e…9002','1500','design'],['0x62bb…44f7','1000','growth'],['0xe071…30ca','1000','community']],pool:'DAO Rev Share',amt:'3.2087 ETH + 4,120 USDC'}\n];\nconst pane=document.getElementById('ucPane');\nfunction renderUC(n){\n  const u=UC[n];\n  const colors=['#00FF40','#60A5FA','#FF00FF','#ffffffaa','#00FF40','#60A5FA'];\n  const total=u.rows.reduce((a,r)=>a+parseInt(r[1]),0);\n  pane.innerHTML=`\n    <div class=\"fm text-[10px] text-white/40 uppercase tracking-[0.2em]\">${u.pool}</div>\n    <h3 class=\"fh text-[24px] font-bold mt-2\">${u.t}</h3>\n    <p class=\"text-[14.5px] text-white/60 mt-3 leading-relaxed\">${u.d}</p>\n    <div class=\"flex h-2.5 mt-6 gap-px\">${u.rows.map((r,i)=>`<div style=\"width:${parseInt(r[1])/total*100}%;background:${colors[i%6]}\"></div>`).join('')}</div>\n    <div class=\"fm text-[11px] mt-5\">\n      ${u.rows.map((r,i)=>`<div class=\"flex items-center justify-between py-2 border-b border-white/5\">\n        <span class=\"flex items-center gap-2.5\"><span class=\"w-2 h-2 inline-block\" style=\"background:${colors[i%6]}\"></span><span class=\"text-white/70\">${r[0]}</span></span>\n        <span class=\"text-white/35\">${r[2]}</span>\n        <span class=\"text-white/85\">${r[1]} bps</span></div>`).join('')}\n    </div>\n    <div class=\"fm text-[10.5px] text-[#00FF40] mt-4\">${u.amt}</div>`;\n  gsap.from(pane.children,{autoAlpha:0,y:14,duration:.45,stagger:.05,ease:'power2.out'});\n}\ndocument.querySelectorAll('.uc-item').forEach(b=>{\n  b.addEventListener('click',()=>{\n    document.querySelectorAll('.uc-item').forEach(x=>{\n      x.classList.remove('bg-[#00FF40]/[0.07]');\n      x.querySelector('.uc-arrow').classList.add('text-white/30');\n      x.querySelector('.uc-arrow').classList.remove('text-[#00FF40]');\n      x.querySelector('.fh').classList.remove('text-[#00FF40]');\n    });\n    b.classList.add('bg-[#00FF40]/[0.07]');\n    b.querySelector('.uc-arrow').classList.remove('text-white/30');\n    b.querySelector('.uc-arrow').classList.add('text-[#00FF40]');\n    b.querySelector('.fh').classList.add('text-[#00FF40]');\n    renderUC(+b.dataset.uc);\n  });\n});\ndocument.querySelector('.uc-item').click();\n\n/* FAQ */\nconst FAQ=[\n  ['Can shares be changed later?','No — and that is the feature. A pool is initialized once with a fixed payee list and share array; a second <span class=\"fm text-white/80\">initialize()</span> call reverts. Mutable splits would require a privileged role, which reintroduces exactly the trust assumption PayPool removes. Need a new arrangement? Deploy a new pool — cloning is cheap.'],\n  ['Why no multi-chain support?','v1 is single-chain by config (<span class=\"fm text-white/80\">CHAIN_ID=84532</span>, Base Sepolia) and portable to any EVM chain by changing env vars. Cross-chain pools in one instance mean bridge assumptions and messaging failure modes that would dominate the threat model for a splitter.'],\n  ['Does the dashboard custody anything?','Never. It holds no keys and cannot move funds. It reads indexed events over REST and reads the chain directly through viem/wagmi. If the dashboard vanished, every payee could still call <span class=\"fm text-white/80\">release()</span> from a block explorer.'],\n  ['Do I need to trust the indexer?','No. The indexer is a convenience layer, not a source of truth — it derives its whole view from public logs, and its numbers can be recomputed from <span class=\"fm text-white/80\">pendingPayment()</span> on-chain. <span class=\"fm text-white/80\">GET /health</span> exposes <span class=\"fm text-white/80\">last_indexed_block</span>, <span class=\"fm text-white/80\">chain_head_block</span> and <span class=\"fm text-white/80\">lag_seconds</span> so you can see when it is behind.'],\n  ['Why Clones.clone and not CREATE2?','Sequential <span class=\"fm text-white/80\">CREATE</span> via <span class=\"fm text-white/80\">Clones.clone</span> means pool addresses are not predictable before deployment, which removes the front-running-a-vanity-address class of issue. <span class=\"fm text-white/80\">cloneDeterministic</span> is a documented upgrade path if deterministic addresses ever become a requirement — not an oversight.']\n];\nconst faqWrap=document.querySelector('.faq');\nfaqWrap.innerHTML=FAQ.map((f,i)=>`\n  <div class=\"faq-item border-b border-white/10\">\n    <button class=\"faq-btn w-full text-left py-6 flex items-start gap-5\">\n      <span class=\"fm text-[11px] text-[#00FF40] pt-1.5\">Q${i+1}</span>\n      <span class=\"fm text-[15px] flex-1 text-white/90 leading-snug\">${f[0]}</span>\n      <span class=\"faq-ico fm text-[18px] text-white/40 leading-none pt-0.5\">+</span>\n    </button>\n    <div class=\"acc-body h-0\"><p class=\"text-[15px] text-white/60 leading-relaxed pb-6 pl-11 pr-10\">${f[1]}</p></div>\n  </div>`).join('');\ndocument.querySelectorAll('.faq-item').forEach((item,idx)=>{\n  const btn=item.querySelector('.faq-btn'),body=item.querySelector('.acc-body'),ico=item.querySelector('.faq-ico');\n  let open=false;\n  function set(o){\n    open=o;\n    gsap.to(body,{height:o?'auto':0,duration:.4,ease:'power2.inOut'});\n    gsap.to(ico,{rotate:o?135:0,duration:.35,ease:'power2.out'});\n    ico.style.color=o?'#00FF40':'';\n  }\n  btn.addEventListener('click',()=>{\n    document.querySelectorAll('.faq-item').forEach(o=>{if(o!==item){o._close&&o._close();}});\n    set(!open);\n  });\n  item._close=()=>{if(open)set(false);};\n  if(idx===0) set(true);\n});\n</script>\n",
      "comments": [],
      "created": "2026-08-14T16:38:12.411231+00:00",
      "modified": "2026-08-14T16:38:12.411231+00:00",
      "id": "var_a5320be5a8cd",
      "viewportScrollY": 21333
    },
    "var_e27479693633": {
      "type": "variant",
      "label": "PayPool Landing — Brutal Split",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.f-d{font-family:'Anton',sans-serif}\n.f-b{font-family:'Space Grotesk',sans-serif}\n.f-m{font-family:'JetBrains Mono',ui-monospace,monospace}\n\n#page{background:#F2F3F4;color:#000;overflow-x:clip}\n\ninput[type=range].br{-webkit-appearance:none;appearance:none;width:100%;height:28px;background:#F2F3F4;border:3px solid #000;cursor:pointer}\ninput[type=range].br::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:22px;background:#FF3800;border:3px solid #000;cursor:grab}\ninput[type=range].br::-moz-range-thumb{width:30px;height:22px;background:#FF3800;border:3px solid #000;border-radius:0}\n\n@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.marq{display:flex;width:max-content;animation:marq 26s linear infinite}\n\n.reveal{opacity:0;transform:translateY(46px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)}\n.reveal.is-inview{opacity:1;transform:none}\n.rowrev{opacity:0;transform:translateX(-28px);transition:opacity .5s ease,transform .5s ease}\n.rowrev.is-inview{opacity:1;transform:none}\n\n.uc-row .uc-lbl{transition:color .25s ease, padding-left .25s ease}\n.uc-row:hover .uc-lbl{color:#FF3800;padding-left:18px}\n.uc-panel{position:absolute;inset:0;clip-path:inset(0 100% 0 0)}\n.uc-panel.on{clip-path:inset(0 0 0 0)}\n\n.faq-body{display:none}\n.faq-open .faq-body{display:block}\n.faq-open .faq-plus{transform:rotate(45deg)}\n.faq-plus{transition:transform .25s ease}\n\n.hl{background:#FCF75E;box-shadow:0 0 0 4px #000}\n.sk{white-space:pre;overflow-x:auto}\n.kw{color:#FF3800;font-weight:700}\n.cm{color:#555}\n</style>\n<div class=\"f-b antialiased\" data-kid=\"1\" data-name=\"page layout container\" id=\"page\">\n    <!-- ================= 1. TOP BAR ================= -->\n    <header class=\"border-b-4 border-black bg-[#F2F3F4] sticky top-0 z-50\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <div class=\"max-w-[1440px] mx-auto px-6 h-[76px] flex items-center gap-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a class=\"f-d text-3xl uppercase tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"site title logo\" href=\"#\">\n                PAY\n                <span class=\"text-[#FF3800]\" data-kid=\"1-1-1-1-1\" data-name=\"logo highlight text\">\n                    POOL\n                </span>\n            </a>\n            <span class=\"hidden lg:block h-[76px] w-1 bg-black\" data-kid=\"1-1-1-2\" data-name=\"vertical separator line\">\n            </span>\n            <nav class=\"hidden lg:flex items-center gap-6 f-m text-[12px] uppercase\" data-kid=\"1-1-1-3\" data-name=\"main navigation links\">\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-1\" data-name=\"how it works link\" href=\"#how\">\n                    How it works\n                </a>\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-2\" data-name=\"guarantees link\" href=\"#guarantees\">\n                    Guarantees\n                </a>\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-3\" data-name=\"dashboard link\" href=\"#dashboard\">\n                    Dashboard\n                </a>\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-4\" data-name=\"contract link\" href=\"#contract\">\n                    Contract\n                </a>\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-5\" data-name=\"stack link\" href=\"#stack\">\n                    Stack\n                </a>\n                <a class=\"hover:bg-black hover:text-[#FCF75E] px-1\" data-kid=\"1-1-1-3-6\" data-name=\"faq link\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-4\" data-kid=\"1-1-1-4\" data-name=\"header right action area\">\n                <span class=\"hidden md:inline-flex items-center gap-2 f-m text-[11px] border-[3px] border-black px-2 py-1 bg-white\" data-kid=\"1-1-1-4-1\" data-name=\"chain status indicator\">\n                    <span class=\"w-2.5 h-2.5 bg-[#FF3800] inline-block\" data-kid=\"1-1-1-4-1-1\" data-name=\"status color block\">\n                    </span>\n                    BASE SEPOLIA / 84532\n                </span>\n                <a class=\"f-d uppercase text-lg bg-black text-white px-5 py-2 border-[3px] border-black shadow-[6px_6px_0_#FCF75E] hover:shadow-[2px_2px_0_#FCF75E] hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150\" data-kid=\"1-1-1-4-2\" data-name=\"deploy pool call to action button\" href=\"#cta\">\n                    Deploy a pool\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ================= 2. HERO ================= -->\n    <section class=\"border-b-4 border-black\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"max-w-[1440px] mx-auto px-6 pt-12 pb-16\" data-kid=\"1-2-1\" data-name=\"hero content container\">\n            <div class=\"flex flex-wrap items-end gap-x-8 gap-y-3 f-m text-[11px] uppercase\" data-kid=\"1-2-1-1\" data-name=\"hero metadata list\">\n                <span class=\"bg-black text-[#FCF75E] px-2 py-1\" data-kid=\"1-2-1-1-1\" data-name=\"version status tag\">\n                    v1 · testnet live\n                </span>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"total share units info\">\n                    10,000 BPS total share units\n                </span>\n                <span data-kid=\"1-2-1-1-3\" data-name=\"payee count info\">\n                    2 ≤ payees ≤ 20\n                </span>\n                <span data-kid=\"1-2-1-1-4\" data-name=\"license info\">\n                    MIT licensed\n                </span>\n            </div>\n            <h1 class=\"f-d uppercase tracking-tight leading-[0.8] mt-6 text-[13vw] lg:text-[10.6rem]\" data-kid=\"1-2-1-2\" data-name=\"hero main headline\">\n                TRUSTLESS\n                <br data-kid=\"1-2-1-2-1\" data-name=\"headline line break\"/>\n                <span class=\"inline-block bg-[#FCF75E] border-4 border-black px-4 -ml-1\" data-kid=\"1-2-1-2-2\" data-name=\"highlighted payout text\">\n                    PAYOUTS.\n                </span>\n            </h1>\n            <div class=\"mt-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"1-2-1-3\" data-name=\"hero sub-sections container\">\n                <!-- calculator -->\n                <div class=\"lg:col-span-7\" data-kid=\"1-2-1-3-1\" data-name=\"split calculator container\" data-scroll=\"\" data-scroll-speed=\"0.12\">\n                    <div class=\"bg-white border-4 border-black shadow-[14px_14px_0_#FCF75E] p-6 md:p-8\" data-kid=\"1-2-1-3-1-1\" data-name=\"calculator card\">\n                        <div class=\"flex flex-wrap items-end justify-between gap-3 border-b-4 border-black pb-3\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"calculator header\">\n                            <h3 class=\"f-d text-3xl uppercase\" data-kid=\"1-2-1-3-1-1-1-1\" data-name=\"calculator title\">\n                                Split calculator\n                            </h3>\n                            <span class=\"f-m text-[11px] bg-black text-[#FCF75E] px-2 py-1\" data-kid=\"1-2-1-3-1-1-1-2\" data-name=\"pool balance tag\">\n                                POOL BALANCE 12.4 ETH\n                            </span>\n                        </div>\n                        <div class=\"mt-6 space-y-5\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-1-2\" data-name=\"calculator input rows container\" data-reason=\"children injected by script on load\" id=\"calc-rows\">\n                        </div>\n                        <div class=\"mt-7 flex h-14 border-4 border-black bg-white\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-1-3\" data-name=\"visual breakdown bar\" data-reason=\"children injected by script on load\" id=\"calc-bar\">\n                        </div>\n                        <div class=\"mt-3 flex flex-wrap justify-between gap-2 f-m text-[11px]\" data-kid=\"1-2-1-3-1-1-4\" data-name=\"calculator instructions and total sum\">\n                            <span data-kid=\"1-2-1-3-1-1-4-1\" data-name=\"instruction label\">\n                                DRAG ANY SLIDER — REMAINDER RE-NORMALIZES\n                            </span>\n                            <span data-kid=\"1-2-1-3-1-1-4-2\" data-name=\"sum info\">\n                                SUM =\n                                <span class=\"font-bold\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-1-4-2-1\" data-name=\"total bps sum value\" data-reason=\"text updated on slider input by script\" id=\"bps-sum\">\n                                    10000\n                                </span>\n                                / 10000 BPS\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- copy + graphic -->\n                <div class=\"lg:col-span-5\" data-kid=\"1-2-1-3-2\" data-name=\"hero right content container\">\n                    <p class=\"text-lg leading-snug border-l-[6px] border-[#FF3800] pl-4\" data-kid=\"1-2-1-3-2-1\" data-name=\"description text\">\n                        Deploy a pool, define payees and shares, and let anyone send funds to it — each payee withdraws their\n                        <span class=\"hl px-1\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"exact share highlight\">\n                            exact proportional share\n                        </span>\n                        at any time, with zero custodians and zero admin keys.\n                    </p>\n                    <div class=\"mt-7 border-4 border-black bg-white shadow-[14px_14px_0_#000]\" data-kid=\"1-2-1-3-2-2\" data-name=\"info card with image\" data-scroll=\"\" data-scroll-speed=\"0.35\">\n                        <img alt=\"Brutalist 3D shapes\" class=\"w-full block border-b-4 border-black\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"brutalist shapes image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/d4aef9b7532d4cbc9876ca34adf585ed.jpg\"/>\n                        <div class=\"grid grid-cols-2 f-m text-[10px] uppercase\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"card footer details\">\n                            <p class=\"p-3 border-r-4 border-black\" data-kid=\"1-2-1-3-2-2-2-1\" data-name=\"address description\">\n                                address(0) == ETH\n                                <br data-kid=\"1-2-1-3-2-2-2-1-1\"/>\n                                one accounting path\n                            </p>\n                            <p class=\"p-3\" data-kid=\"1-2-1-3-2-2-2-2\" data-name=\"gas description\">\n                                clone deploy\n                                <br data-kid=\"1-2-1-3-2-2-2-2-1\"/>\n                                ≈ 1/9 of full deploy gas\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 3. MARQUEE ================= -->\n    <div class=\"bg-black border-b-4 border-black py-5 overflow-hidden\" data-kid=\"1-3\" data-name=\"marquee section\">\n        <div class=\"marq f-d uppercase text-[#FCF75E] text-5xl md:text-6xl tracking-tight\" data-kid=\"1-3-1\" data-name=\"marquee content list\">\n            <div class=\"flex shrink-0\" data-kid=\"1-3-1-1\" data-name=\"first marquee track\">\n                <span class=\"px-8\" data-kid=\"1-3-1-1-1\" data-name=\"marquee item 1\">\n                    PaymentReceived\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-1-2\" data-name=\"marquee separator 1\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-1-3\" data-name=\"marquee item 2\">\n                    PaymentReleased\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-1-4\" data-name=\"marquee separator 2\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-1-5\" data-name=\"marquee item 3\">\n                    SplitterCreated\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-1-6\" data-name=\"marquee separator 3\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-1-7\" data-name=\"marquee item 4\">\n                    NO ADMIN KEYS\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-1-8\" data-name=\"marquee separator 4\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-1-9\" data-name=\"marquee item 5\">\n                    10,000 BPS\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-1-10\" data-name=\"marquee separator 5\">\n                    ·\n                </span>\n            </div>\n            <div aria-hidden=\"true\" class=\"flex shrink-0\" data-kid=\"1-3-1-2\" data-name=\"second duplicate marquee track\">\n                <span class=\"px-8\" data-kid=\"1-3-1-2-1\" data-name=\"marquee item duplicate 1\">\n                    PaymentReceived\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-2-2\" data-name=\"marquee separator duplicate 1\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-2-3\" data-name=\"marquee item duplicate 2\">\n                    PaymentReleased\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-2-4\" data-name=\"marquee separator duplicate 2\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-2-5\" data-name=\"marquee item duplicate 3\">\n                    SplitterCreated\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-2-6\" data-name=\"marquee separator duplicate 3\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-2-7\" data-name=\"marquee item duplicate 4\">\n                    NO ADMIN KEYS\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-2-8\" data-name=\"marquee separator duplicate 4\">\n                    ·\n                </span>\n                <span class=\"px-8\" data-kid=\"1-3-1-2-9\" data-name=\"marquee item duplicate 5\">\n                    10,000 BPS\n                </span>\n                <span class=\"px-8 text-[#FF3800]\" data-kid=\"1-3-1-2-10\" data-name=\"marquee separator duplicate 5\">\n                    ·\n                </span>\n            </div>\n        </div>\n    </div>\n    <!-- ================= 4. HOW IT WORKS — STAIRCASE ================= -->\n    <section class=\"pt-16 pb-24\" data-kid=\"1-4\" data-name=\"how it works section\" id=\"how\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-4-1\" data-name=\"how it works header\">\n            <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.85]\" data-kid=\"1-4-1-1\" data-name=\"how it works title\">\n                How it works\n            </h2>\n            <p class=\"f-m text-xs mt-3 uppercase\" data-kid=\"1-4-1-2\" data-name=\"transaction metadata\">\n                three transactions · zero permissions\n            </p>\n        </div>\n        <div class=\"max-w-[1440px] mx-auto px-6 mt-10\" data-kid=\"1-4-2\" data-name=\"steps container\">\n            <!-- band 1 -->\n            <div class=\"relative z-10 bg-white border-4 border-black reveal\" data-kid=\"1-4-2-1\" data-name=\"step 1 card\" data-scroll=\"\">\n                <div class=\"flex flex-col lg:flex-row\" data-kid=\"1-4-2-1-1\" data-name=\"step 1 layout\">\n                    <div class=\"lg:w-[36%] p-8 border-b-4 lg:border-b-0 lg:border-r-4 border-black relative overflow-hidden\" data-kid=\"1-4-2-1-1-1\" data-name=\"step 1 description container\">\n                        <span class=\"f-d absolute -bottom-10 -left-2 text-[13rem] leading-none text-black/10 select-none\" data-kid=\"1-4-2-1-1-1-1\" data-name=\"step 1 number background\">\n                            01\n                        </span>\n                        <h3 class=\"f-d uppercase text-6xl tracking-tight relative\" data-kid=\"1-4-2-1-1-1-2\" data-name=\"step 1 title\">\n                            Create\n                        </h3>\n                        <p class=\"text-sm mt-3 max-w-xs relative\" data-kid=\"1-4-2-1-1-1-3\" data-name=\"step 1 text\">\n                            Factory clones the implementation and calls\n                            <span class=\"f-m text-[13px]\" data-kid=\"1-4-2-1-1-1-3-1\" data-name=\"function name\">\n                                initialize()\n                            </span>\n                            in the same transaction. Payee list is immutable from then on.\n                        </p>\n                    </div>\n                    <div class=\"lg:w-[64%] p-6 bg-[#F2F3F4]\" data-kid=\"1-4-2-1-1-2\" data-name=\"step 1 code block\">\n                        <div class=\"border-[3px] border-black bg-white p-4 f-m text-[12px] sk leading-relaxed\" data-kid=\"1-4-2-1-1-2-1\" data-name=\"code block content\">\n                            <span class=\"cm\" data-kid=\"1-4-2-1-1-2-1-1\" data-name=\"comment line\">\n                                // SplitterFactory.sol\n                            </span>\n                            factory.\n                            <span class=\"kw\" data-kid=\"1-4-2-1-1-2-1-2\" data-name=\"function call text\">\n                                createPool\n                            </span>\n                            (\n  [0xA71c…9F02, 0x3Fb2…10Ce, 0x91dE…4402, 0xCc08…77aF],\n  [3500, 2500, 2500, 1500],\n                            <span class=\"kw\" data-kid=\"1-4-2-1-1-2-1-3\" data-name=\"string literal text\">\n                                \"Band Royalties\"\n                            </span>\n                            )\n                            <span class=\"cm\" data-kid=\"1-4-2-1-1-2-1-4\" data-name=\"return value text\">\n                                → pool 0x7c2F…A19b\n                            </span>\n                        </div>\n                        <p class=\"f-m text-[10px] mt-3 uppercase\" data-kid=\"1-4-2-1-1-2-2\" data-name=\"emits description\">\n                            emits SplitterCreated(pool, creator, payees, shares, name)\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- band 2 -->\n            <div class=\"relative z-20 -mt-6 bg-[#FCF75E] border-4 border-black reveal\" data-kid=\"1-4-2-2\" data-name=\"step 2 card\" data-scroll=\"\">\n                <div class=\"flex flex-col lg:flex-row\" data-kid=\"1-4-2-2-1\" data-name=\"step 2 layout\">\n                    <div class=\"lg:w-[36%] p-8 border-b-4 lg:border-b-0 lg:border-r-4 border-black relative overflow-hidden\" data-kid=\"1-4-2-2-1-1\" data-name=\"step 2 description container\">\n                        <span class=\"f-d absolute -bottom-10 -left-2 text-[13rem] leading-none text-black/15 select-none\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"step 2 number background\">\n                            02\n                        </span>\n                        <h3 class=\"f-d uppercase text-6xl tracking-tight relative\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"step 2 title\">\n                            Fund\n                        </h3>\n                        <p class=\"text-sm mt-3 max-w-xs relative\" data-kid=\"1-4-2-2-1-1-3\" data-name=\"step 2 text\">\n                            Anyone sends ETH to the pool address, or calls\n                            <span class=\"f-m text-[13px]\" data-kid=\"1-4-2-2-1-1-3-1\" data-name=\"function name\">\n                                depositERC20()\n                            </span>\n                            after an approve. No allowlist, no gatekeeper.\n                        </p>\n                    </div>\n                    <div class=\"lg:w-[64%] p-6\" data-kid=\"1-4-2-2-1-2\" data-name=\"step 2 data summary\">\n                        <div class=\"border-[3px] border-black bg-white p-4 f-m text-[12px] space-y-2\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"data summary list\">\n                            <div class=\"flex justify-between gap-4 border-b-2 border-black pb-2\" data-kid=\"1-4-2-2-1-2-1-1\" data-name=\"hash row\">\n                                <span data-kid=\"1-4-2-2-1-2-1-1-1\">\n                                    tx_hash\n                                </span>\n                                <span class=\"font-bold break-all\" data-kid=\"1-4-2-2-1-2-1-1-2\">\n                                    0x9d41ab7c5e0f38d2b6a1c47f90e2b8d5c31fa07be49c2d6118af35e07c4b91d0\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between\" data-kid=\"1-4-2-2-1-2-1-2\" data-name=\"token row\">\n                                <span data-kid=\"1-4-2-2-1-2-1-2-1\" data-name=\"token label\">\n                                    token\n                                </span>\n                                <span data-kid=\"1-4-2-2-1-2-1-2-2\" data-name=\"token value\">\n                                    0x0000…0000\n                                    <span class=\"bg-black text-[#FCF75E] px-1\" data-kid=\"1-4-2-2-1-2-1-2-2-1\" data-name=\"token type tag\">\n                                        ETH\n                                    </span>\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between\" data-kid=\"1-4-2-2-1-2-1-3\" data-name=\"amount row\">\n                                <span data-kid=\"1-4-2-2-1-2-1-3-1\">\n                                    amount\n                                </span>\n                                <span class=\"font-bold\" data-kid=\"1-4-2-2-1-2-1-3-2\">\n                                    3.2000 ETH\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between\" data-kid=\"1-4-2-2-1-2-1-4\" data-name=\"block number row\">\n                                <span data-kid=\"1-4-2-2-1-2-1-4-1\">\n                                    block_number\n                                </span>\n                                <span data-kid=\"1-4-2-2-1-2-1-4-2\">\n                                    12,345,700\n                                </span>\n                            </div>\n                        </div>\n                        <p class=\"f-m text-[10px] mt-3 uppercase\" data-kid=\"1-4-2-2-1-2-2\" data-name=\"emits description\">\n                            emits PaymentReceived(from, token, amount)\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- band 3 -->\n            <div class=\"relative z-30 -mt-6 bg-[#FF3800] border-4 border-black reveal\" data-kid=\"1-4-2-3\" data-name=\"step 3 card\" data-scroll=\"\">\n                <div class=\"flex flex-col lg:flex-row\" data-kid=\"1-4-2-3-1\" data-name=\"step 3 layout\">\n                    <div class=\"lg:w-[36%] p-8 border-b-4 lg:border-b-0 lg:border-r-4 border-black relative overflow-hidden\" data-kid=\"1-4-2-3-1-1\" data-name=\"step 3 description container\">\n                        <span class=\"f-d absolute -bottom-10 -left-2 text-[13rem] leading-none text-black/20 select-none\" data-kid=\"1-4-2-3-1-1-1\" data-name=\"step 3 number background\">\n                            03\n                        </span>\n                        <h3 class=\"f-d uppercase text-6xl tracking-tight relative\" data-kid=\"1-4-2-3-1-1-2\" data-name=\"step 3 title\">\n                            Withdraw\n                        </h3>\n                        <p class=\"text-sm mt-3 max-w-xs relative\" data-kid=\"1-4-2-3-1-1-3\" data-name=\"step 3 text\">\n                            Pull-based. Anyone can call\n                            <span class=\"f-m text-[13px]\" data-kid=\"1-4-2-3-1-1-3-1\" data-name=\"function name\">\n                                release()\n                            </span>\n                            on your behalf — the funds can only ever land in the payee's address.\n                        </p>\n                    </div>\n                    <div class=\"lg:w-[64%] p-6\" data-kid=\"1-4-2-3-1-2\" data-name=\"step 3 code block\">\n                        <div class=\"border-[3px] border-black bg-white p-4 f-m text-[12px] sk leading-relaxed\" data-kid=\"1-4-2-3-1-2-1\" data-name=\"code block content\">\n                            pool.\n                            <span class=\"kw\" data-kid=\"1-4-2-3-1-2-1-1\" data-name=\"function call\">\n                                release\n                            </span>\n                            (0x3Fb2…10Ce,\n                            <span class=\"kw\" data-kid=\"1-4-2-3-1-2-1-2\" data-name=\"argument\">\n                                address\n                            </span>\n                            (0));\n                            <span class=\"cm\" data-kid=\"1-4-2-3-1-2-1-3\" data-name=\"comment\">\n                                // pending = (12.4 * 2500 / 10000) - 2.0000 = 1.1000 ETH\n                            </span>\n                            <span class=\"cm\" data-kid=\"1-4-2-3-1-2-1-4\" data-name=\"comment\">\n                                // second call in same block pays a zero delta\n                            </span>\n                        </div>\n                        <p class=\"f-m text-[10px] mt-3 uppercase\" data-kid=\"1-4-2-3-1-2-2\" data-name=\"emits description\">\n                            emits PaymentReleased(to, token, amount)\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 5. TRUSTLESS GUARANTEES — VERSUS ================= -->\n    <section class=\"border-y-4 border-black bg-white\" data-kid=\"1-5\" data-name=\"guarantees section\" id=\"guarantees\">\n        <div class=\"max-w-[1440px] mx-auto px-6 pt-14\" data-kid=\"1-5-1\" data-name=\"guarantees header container\">\n            <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.92]\" data-kid=\"1-5-1-1\" data-name=\"guarantees main headline\">\n                A spreadsheet\n                <br data-kid=\"1-5-1-1-1\" data-name=\"line break\"/>\n                is not a contract\n            </h2>\n        </div>\n        <div class=\"max-w-[1440px] mx-auto px-6 py-12\" data-kid=\"1-5-2\" data-name=\"comparison layout container\">\n            <div class=\"relative flex flex-col lg:flex-row border-4 border-black\" data-kid=\"1-5-2-1\" data-name=\"comparison grid\">\n                <span class=\"hidden lg:block absolute left-1/2 top-0 bottom-0 w-1 bg-black -translate-x-1/2\" data-kid=\"1-5-2-1-1\" data-name=\"vertical separator\">\n                </span>\n                <span class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 f-d text-2xl bg-black text-[#FCF75E] w-16 h-16 border-4 border-[#FCF75E] flex items-center justify-center\" data-kid=\"1-5-2-1-2\" data-name=\"comparison vs badge\">\n                    VS\n                </span>\n                <!-- THEM -->\n                <div class=\"lg:w-1/2 p-8 md:p-10 bg-[#F2F3F4] border-b-4 lg:border-b-0 border-black\" data-kid=\"1-5-2-1-3\" data-name=\"legacy system column\">\n                    <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-5-2-1-3-1\" data-name=\"column metadata\">\n                        01 / the old way\n                    </p>\n                    <h3 class=\"f-d uppercase text-5xl mt-1\" data-kid=\"1-5-2-1-3-2\" data-name=\"column title\">\n                        THEM\n                    </h3>\n                    <div class=\"relative mt-7 border-4 border-black bg-white\" data-kid=\"1-5-2-1-3-3\" data-name=\"legacy table container\">\n                        <div class=\"f-m text-[11px]\" data-kid=\"1-5-2-1-3-3-1\" data-name=\"table\">\n                            <div class=\"grid grid-cols-3 bg-black text-white\" data-kid=\"1-5-2-1-3-3-1-1\" data-name=\"table header row\">\n                                <span class=\"p-2 border-r-2 border-white/40\" data-kid=\"1-5-2-1-3-3-1-1-1\">\n                                    PERSON\n                                </span>\n                                <span class=\"p-2 border-r-2 border-white/40\" data-kid=\"1-5-2-1-3-3-1-1-2\">\n                                    %\n                                </span>\n                                <span class=\"p-2\" data-kid=\"1-5-2-1-3-3-1-1-3\">\n                                    PAID?\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-3 border-b-2 border-black\" data-kid=\"1-5-2-1-3-3-1-2\" data-name=\"table body row 1\">\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-2-1\">\n                                    nina\n                                </span>\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-2-2\">\n                                    35\n                                </span>\n                                <span class=\"p-2\" data-kid=\"1-5-2-1-3-3-1-2-3\">\n                                    yes?\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-3 border-b-2 border-black\" data-kid=\"1-5-2-1-3-3-1-3\" data-name=\"table body row 2\">\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-3-1\">\n                                    omar\n                                </span>\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-3-2\">\n                                    25\n                                </span>\n                                <span class=\"p-2\" data-kid=\"1-5-2-1-3-3-1-3-3\">\n                                    \"soon\"\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-3 border-b-2 border-black\" data-kid=\"1-5-2-1-3-3-1-4\" data-name=\"table body row 3\">\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-4-1\">\n                                    kaya\n                                </span>\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-4-2\">\n                                    25\n                                </span>\n                                <span class=\"p-2\" data-kid=\"1-5-2-1-3-3-1-4-3\">\n                                    —\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-3\" data-kid=\"1-5-2-1-3-3-1-5\" data-name=\"table body row 4\">\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-5-1\">\n                                    rue\n                                </span>\n                                <span class=\"p-2 border-r-2 border-black\" data-kid=\"1-5-2-1-3-3-1-5-2\">\n                                    15\n                                </span>\n                                <span class=\"p-2\" data-kid=\"1-5-2-1-3-3-1-5-3\">\n                                    ???\n                                </span>\n                            </div>\n                        </div>\n                        <svg class=\"absolute inset-0 w-full h-full pointer-events-none\" data-kid=\"1-5-2-1-3-3-2\" data-name=\"overlay svg cross\" preserveaspectratio=\"none\" viewbox=\"0 0 100 100\">\n                            <line stroke=\"#FF3800\" stroke-width=\"6\" vector-effect=\"non-scaling-stroke\" x1=\"3\" x2=\"97\" y1=\"3\" y2=\"97\">\n                            </line>\n                            <line stroke=\"#FF3800\" stroke-width=\"6\" vector-effect=\"non-scaling-stroke\" x1=\"97\" x2=\"3\" y1=\"3\" y2=\"97\">\n                            </line>\n                        </svg>\n                    </div>\n                    <ul class=\"mt-8 space-y-4 text-sm\" data-kid=\"1-5-2-1-3-4\" data-name=\"legacy list\">\n                        <li class=\"flex gap-3 border-b-2 border-black/20 pb-3\" data-kid=\"1-5-2-1-3-4-1\">\n                            <span class=\"f-m text-[#FF3800]\" data-kid=\"1-5-2-1-3-4-1-1\">\n                                ✕\n                            </span>\n                            <span data-kid=\"1-5-2-1-3-4-1-2\">\n                                One trusted human holds the money and decides when it moves.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3 border-b-2 border-black/20 pb-3\" data-kid=\"1-5-2-1-3-4-2\">\n                            <span class=\"f-m text-[#FF3800]\" data-kid=\"1-5-2-1-3-4-2-1\">\n                                ✕\n                            </span>\n                            <span data-kid=\"1-5-2-1-3-4-2-2\">\n                                Balances live in a private sheet; payees verify nothing.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3 border-b-2 border-black/20 pb-3\" data-kid=\"1-5-2-1-3-4-3\">\n                            <span class=\"f-m text-[#FF3800]\" data-kid=\"1-5-2-1-3-4-3-1\">\n                                ✕\n                            </span>\n                            <span data-kid=\"1-5-2-1-3-4-3-2\">\n                                A platform alternative takes a cut and can freeze the account.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-2-1-3-4-4\">\n                            <span class=\"f-m text-[#FF3800]\" data-kid=\"1-5-2-1-3-4-4-1\">\n                                ✕\n                            </span>\n                            <span data-kid=\"1-5-2-1-3-4-4-2\">\n                                Fixing a mistake means asking, not calling a function.\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <!-- PAYPOOL -->\n                <div class=\"lg:w-1/2 p-8 md:p-10 bg-white\" data-kid=\"1-5-2-1-4\" data-name=\"paypool system column\">\n                    <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-5-2-1-4-1\" data-name=\"column metadata\">\n                        02 / the contract\n                    </p>\n                    <h3 class=\"f-d uppercase text-5xl mt-1\" data-kid=\"1-5-2-1-4-2\" data-name=\"column title\">\n                        PAYPOOL\n                    </h3>\n                    <div class=\"mt-7 border-4 border-black bg-[#F2F3F4] p-5\" data-kid=\"1-5-2-1-4-3\" data-name=\"pool status visualization\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-5-2-1-4-3-1\" data-name=\"visualization header\">\n                            <span class=\"f-m text-[11px] bg-black text-white px-2 py-1\" data-kid=\"1-5-2-1-4-3-1-1\">\n                                POOL 0x7c2F…A19b\n                            </span>\n                            <span class=\"h-1 flex-1 bg-black\" data-kid=\"1-5-2-1-4-3-1-2\">\n                            </span>\n                            <span class=\"f-m text-[11px] bg-[#FCF75E] border-2 border-black px-2 py-1\" data-kid=\"1-5-2-1-4-3-1-3\">\n                                12.4 ETH IN\n                            </span>\n                        </div>\n                        <div class=\"mt-5 grid grid-cols-4 gap-3\" data-kid=\"1-5-2-1-4-3-2\" data-name=\"pool segment grid\">\n                            <div class=\"border-[3px] border-black bg-[#FF3800] p-2 text-center\" data-kid=\"1-5-2-1-4-3-2-1\">\n                                <p class=\"f-m text-[10px]\" data-kid=\"1-5-2-1-4-3-2-1-1\">\n                                    3500\n                                </p>\n                                <p class=\"f-d text-lg leading-tight\" data-kid=\"1-5-2-1-4-3-2-1-2\">\n                                    4.34\n                                </p>\n                            </div>\n                            <div class=\"border-[3px] border-black bg-[#FCF75E] p-2 text-center\" data-kid=\"1-5-2-1-4-3-2-2\">\n                                <p class=\"f-m text-[10px]\" data-kid=\"1-5-2-1-4-3-2-2-1\">\n                                    2500\n                                </p>\n                                <p class=\"f-d text-lg leading-tight\" data-kid=\"1-5-2-1-4-3-2-2-2\">\n                                    3.10\n                                </p>\n                            </div>\n                            <div class=\"border-[3px] border-black bg-white p-2 text-center\" data-kid=\"1-5-2-1-4-3-2-3\">\n                                <p class=\"f-m text-[10px]\" data-kid=\"1-5-2-1-4-3-2-3-1\">\n                                    2500\n                                </p>\n                                <p class=\"f-d text-lg leading-tight\" data-kid=\"1-5-2-1-4-3-2-3-2\">\n                                    3.10\n                                </p>\n                            </div>\n                            <div class=\"border-[3px] border-black bg-black text-[#FCF75E] p-2 text-center\" data-kid=\"1-5-2-1-4-3-2-4\">\n                                <p class=\"f-m text-[10px]\" data-kid=\"1-5-2-1-4-3-2-4-1\">\n                                    1500\n                                </p>\n                                <p class=\"f-d text-lg leading-tight\" data-kid=\"1-5-2-1-4-3-2-4-2\">\n                                    1.86\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-3 grid grid-cols-4 gap-3 f-m text-[10px] text-center\" data-kid=\"1-5-2-1-4-3-3\" data-name=\"pool addresses\">\n                            <span data-kid=\"1-5-2-1-4-3-3-1\">\n                                0xA71c…\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-3-3-2\">\n                                0x3Fb2…\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-3-3-3\">\n                                0x91dE…\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-3-3-4\">\n                                0xCc08…\n                            </span>\n                        </div>\n                    </div>\n                    <ul class=\"mt-8 space-y-4 text-sm\" data-kid=\"1-5-2-1-4-4\" data-name=\"paypool list\">\n                        <li class=\"flex gap-3 border-b-2 border-black pb-3\" data-kid=\"1-5-2-1-4-4-1\">\n                            <span class=\"f-m font-bold\" data-kid=\"1-5-2-1-4-4-1-1\">\n                                →\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-4-1-2\">\n                                <b data-kid=\"1-5-2-1-4-4-1-2-1\">\n                                    Zero admin keys.\n                                </b>\n                                There is no owner, no pause, no sweep function to call.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3 border-b-2 border-black pb-3\" data-kid=\"1-5-2-1-4-4-2\">\n                            <span class=\"f-m font-bold\" data-kid=\"1-5-2-1-4-4-2-1\">\n                                →\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-4-2-2\">\n                                <b data-kid=\"1-5-2-1-4-4-2-2-1\">\n                                    Immutable payee list\n                                </b>\n                                after\n                                <span class=\"f-m text-[13px]\" data-kid=\"1-5-2-1-4-4-2-2-2\">\n                                    initialize()\n                                </span>\n                                — guarded by the standard clone-init bool.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3 border-b-2 border-black pb-3\" data-kid=\"1-5-2-1-4-4-3\">\n                            <span class=\"f-m font-bold\" data-kid=\"1-5-2-1-4-4-3-1\">\n                                →\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-4-3-2\">\n                                <b data-kid=\"1-5-2-1-4-4-3-2-1\">\n                                    Pull-based:\n                                </b>\n                                anyone can call\n                                <span class=\"f-m text-[13px]\" data-kid=\"1-5-2-1-4-4-3-2-2\">\n                                    release(payee, token)\n                                </span>\n                                on your behalf.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-2-1-4-4-4\">\n                            <span class=\"f-m font-bold\" data-kid=\"1-5-2-1-4-4-4-1\">\n                                →\n                            </span>\n                            <span data-kid=\"1-5-2-1-4-4-4-2\">\n                                <b data-kid=\"1-5-2-1-4-4-4-2-1\">\n                                    address(0) == ETH\n                                </b>\n                                , so ETH and ERC-20s share one accounting path and one event schema.\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 6. LIVE DASHBOARD — SPLIT OVERFLOW ================= -->\n    <section class=\"border-b-4 border-black\" data-kid=\"1-6\" data-name=\"dashboard section\" id=\"dashboard\">\n        <div class=\"flex flex-col lg:flex-row items-stretch\" data-kid=\"1-6-1\" data-name=\"dashboard layout container\">\n            <div class=\"lg:w-[38%] bg-black text-white flex items-end p-8 md:p-12\" data-kid=\"1-6-1-1\" data-name=\"dashboard left side panel\">\n                <div data-kid=\"1-6-1-1-1\" data-name=\"panel content\">\n                    <p class=\"f-m text-[11px] uppercase text-[#FF3800]\" data-kid=\"1-6-1-1-1-1\" data-name=\"panel metadata\">\n                        06 / read layer\n                    </p>\n                    <h2 class=\"f-d uppercase text-5xl md:text-7xl leading-[0.85] text-[#FCF75E] mt-2\" data-kid=\"1-6-1-1-1-2\" data-name=\"dashboard headline\">\n                        Live\n                        <br data-kid=\"1-6-1-1-1-2-1\"/>\n                        dashboard\n                    </h2>\n                    <p class=\"mt-5 text-sm text-white/70 max-w-xs\" data-kid=\"1-6-1-1-1-3\" data-name=\"dashboard description\">\n                        The indexer reads\n                        <span class=\"f-m\" data-kid=\"1-6-1-1-1-3-1\">\n                            eth_getLogs\n                        </span>\n                        into Postgres and serves REST. It is a convenience layer — never a source of truth. Every number below is re-derivable from chain.\n                    </p>\n                    <div class=\"mt-6 f-m text-[11px] space-y-1 text-white/60\" data-kid=\"1-6-1-1-1-4\" data-name=\"api list\">\n                        <p data-kid=\"1-6-1-1-1-4-1\">\n                            GET /pools/0x7c2F…A19b\n                        </p>\n                        <p data-kid=\"1-6-1-1-1-4-2\">\n                            GET /pools/0x7c2F…A19b/deposits\n                        </p>\n                        <p data-kid=\"1-6-1-1-1-4-3\">\n                            GET /health → lag_seconds: 12\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"lg:w-[62%] bg-[#F2F3F4] py-12 px-6 lg:pr-12 lg:pl-0\" data-kid=\"1-6-1-2\" data-name=\"dashboard right side panel\">\n                <div class=\"lg:-ml-24 relative z-10 bg-white border-4 border-black shadow-[16px_16px_0_#000]\" data-kid=\"1-6-1-2-1\" data-name=\"dashboard display card\" data-scroll=\"\" data-scroll-speed=\"0.08\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-3 border-b-4 border-black px-5 py-3\" data-kid=\"1-6-1-2-1-1\" data-name=\"card header\">\n                        <div class=\"flex items-baseline gap-3\" data-kid=\"1-6-1-2-1-1-1\">\n                            <span class=\"f-d text-2xl uppercase\" data-kid=\"1-6-1-2-1-1-1-1\">\n                                Band Royalties\n                            </span>\n                            <span class=\"f-m text-[11px] bg-[#F2F3F4] border-2 border-black px-1.5\" data-kid=\"1-6-1-2-1-1-1-2\">\n                                0x7c2F…A19b\n                            </span>\n                        </div>\n                        <span class=\"f-m text-[10px] bg-[#FCF75E] border-2 border-black px-2 py-1 flex items-center gap-2\" data-kid=\"1-6-1-2-1-1-2\">\n                            <span class=\"w-2 h-2 bg-black inline-block\" data-kid=\"1-6-1-2-1-1-2-1\">\n                            </span>\n                            INDEXER OK · LAG 12s\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-3 border-b-4 border-black\" data-kid=\"1-6-1-2-1-2\" data-name=\"metrics grid\">\n                        <div class=\"p-4 border-r-4 border-black\" data-kid=\"1-6-1-2-1-2-1\">\n                            <p class=\"f-m text-[10px] uppercase\" data-kid=\"1-6-1-2-1-2-1-1\">\n                                Total received\n                            </p>\n                            <p class=\"f-d text-4xl leading-tight\" data-kid=\"1-6-1-2-1-2-1-2\">\n                                12.4000\n                            </p>\n                            <p class=\"f-m text-[10px]\" data-kid=\"1-6-1-2-1-2-1-3\">\n                                ETH\n                            </p>\n                        </div>\n                        <div class=\"p-4 border-r-4 border-black bg-[#FCF75E]\" data-kid=\"1-6-1-2-1-2-2\">\n                            <p class=\"f-m text-[10px] uppercase\" data-kid=\"1-6-1-2-1-2-2-1\">\n                                Total released\n                            </p>\n                            <p class=\"f-d text-4xl leading-tight\" data-kid=\"1-6-1-2-1-2-2-2\">\n                                7.9500\n                            </p>\n                            <p class=\"f-m text-[10px]\" data-kid=\"1-6-1-2-1-2-2-3\">\n                                ETH\n                            </p>\n                        </div>\n                        <div class=\"p-4\" data-kid=\"1-6-1-2-1-2-3\">\n                            <p class=\"f-m text-[10px] uppercase\" data-kid=\"1-6-1-2-1-2-3-1\">\n                                Pending\n                            </p>\n                            <p class=\"f-d text-4xl leading-tight text-[#FF3800]\" data-kid=\"1-6-1-2-1-2-3-2\">\n                                4.4500\n                            </p>\n                            <p class=\"f-m text-[10px]\" data-kid=\"1-6-1-2-1-2-3-3\">\n                                ETH\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-1 lg:grid-cols-2\" data-kid=\"1-6-1-2-1-3\" data-name=\"dashboard data view container\">\n                        <div class=\"border-b-4 lg:border-b-0 lg:border-r-4 border-black\" data-kid=\"1-6-1-2-1-3-1\" data-name=\"payee table container\">\n                            <table class=\"w-full f-m text-[11px] text-left\" data-kid=\"1-6-1-2-1-3-1-1\" data-name=\"payee table\">\n                                <thead data-kid=\"1-6-1-2-1-3-1-1-1\">\n                                    <tr class=\"bg-black text-white\" data-kid=\"1-6-1-2-1-3-1-1-1-1\">\n                                        <th class=\"p-2 font-normal\" data-kid=\"1-6-1-2-1-3-1-1-1-1-1\">\n                                            PAYEE\n                                        </th>\n                                        <th class=\"p-2 font-normal\" data-kid=\"1-6-1-2-1-3-1-1-1-1-2\">\n                                            SHARES\n                                        </th>\n                                        <th class=\"p-2 font-normal\" data-kid=\"1-6-1-2-1-3-1-1-1-1-3\">\n                                            PENDING\n                                        </th>\n                                        <th class=\"p-2 font-normal\" data-kid=\"1-6-1-2-1-3-1-1-1-1-4\">\n                                            RELEASED\n                                        </th>\n                                    </tr>\n                                </thead>\n                                <tbody data-kid=\"1-6-1-2-1-3-1-1-2\">\n                                    <tr class=\"border-b-2 border-black\" data-kid=\"1-6-1-2-1-3-1-1-2-1\">\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-1-1\">\n                                            0xA71c…9F02\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-1-2\">\n                                            3500\n                                        </td>\n                                        <td class=\"p-2 font-bold\" data-kid=\"1-6-1-2-1-3-1-1-2-1-3\">\n                                            1.5575\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-1-4\">\n                                            2.7825\n                                        </td>\n                                    </tr>\n                                    <tr class=\"border-b-2 border-black bg-[#F2F3F4]\" data-kid=\"1-6-1-2-1-3-1-1-2-2\">\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-2-1\">\n                                            0x3Fb2…10Ce\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-2-2\">\n                                            2500\n                                        </td>\n                                        <td class=\"p-2 font-bold\" data-kid=\"1-6-1-2-1-3-1-1-2-2-3\">\n                                            1.1000\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-2-4\">\n                                            2.0000\n                                        </td>\n                                    </tr>\n                                    <tr class=\"border-b-2 border-black\" data-kid=\"1-6-1-2-1-3-1-1-2-3\">\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-3-1\">\n                                            0x91dE…4402\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-3-2\">\n                                            2500\n                                        </td>\n                                        <td class=\"p-2 font-bold\" data-kid=\"1-6-1-2-1-3-1-1-2-3-3\">\n                                            1.1250\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-3-4\">\n                                            1.9750\n                                        </td>\n                                    </tr>\n                                    <tr class=\"bg-[#F2F3F4]\" data-kid=\"1-6-1-2-1-3-1-1-2-4\">\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-4-1\">\n                                            0xCc08…77aF\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-4-2\">\n                                            1500\n                                        </td>\n                                        <td class=\"p-2 font-bold\" data-kid=\"1-6-1-2-1-3-1-1-2-4-3\">\n                                            0.6675\n                                        </td>\n                                        <td class=\"p-2\" data-kid=\"1-6-1-2-1-3-1-1-2-4-4\">\n                                            1.1925\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                            <div class=\"border-t-4 border-black p-2 f-m text-[10px] uppercase flex justify-between\" data-kid=\"1-6-1-2-1-3-1-2\">\n                                <span data-kid=\"1-6-1-2-1-3-1-2-1\">\n                                    4 payees · 10000 bps\n                                </span>\n                                <span data-kid=\"1-6-1-2-1-3-1-2-2\">\n                                    block_created 12,345,678\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"p-4\" data-kid=\"1-6-1-2-1-3-2\" data-name=\"deposits chart container\">\n                            <p class=\"f-m text-[10px] uppercase mb-2\" data-kid=\"1-6-1-2-1-3-2-1\">\n                                Deposits per block (ETH)\n                            </p>\n                            <div class=\"h-[188px]\" data-kid=\"1-6-1-2-1-3-2-2\" data-name=\"canvas element\">\n                                <canvas data-kid=\"1-6-1-2-1-3-2-2-1\" id=\"depChart\">\n                                </canvas>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 7. CONTRACT INTERFACE — PULL QUOTE ================= -->\n    <section class=\"py-20 bg-[#F2F3F4]\" data-kid=\"1-7\" data-name=\"contract interface section\" id=\"contract\">\n        <div class=\"max-w-2xl mx-auto px-6\" data-kid=\"1-7-1\" data-name=\"contract explanation container\">\n            <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-7-1-1\">\n                07 / the contract\n            </p>\n            <h2 class=\"f-d uppercase text-5xl md:text-7xl tracking-tight leading-[0.85] mt-2\" data-kid=\"1-7-1-2\">\n                One file you\n                <br data-kid=\"1-7-1-2-1\"/>\n                can read twice\n            </h2>\n            <p class=\"mt-6 text-lg leading-relaxed\" data-kid=\"1-7-1-3\">\n                PayPool is one implementation contract cloned per pool. There is no proxy admin, no upgrade path, no role registry. Shares are basis points out of a fixed\n                <span class=\"f-m text-base\" data-kid=\"1-7-1-3-1\">\n                    TOTAL_SHARE_UNITS = 10_000\n                </span>\n                , and the sum must equal exactly ten thousand at initialization or the call reverts.\n            </p>\n            <p class=\"mt-4 text-lg leading-relaxed\" data-kid=\"1-7-1-4\">\n                ETH and ERC-20s take the same accounting path because\n                <span class=\"f-m text-base\" data-kid=\"1-7-1-4-1\">\n                    address(0)\n                </span>\n                is the token identifier for native ETH — which means the indexer consumes a single, unified event schema.\n            </p>\n        </div>\n        <!-- breakout -->\n        <div class=\"mt-12 border-y-4 border-black bg-[#FCF75E] py-10\" data-kid=\"1-7-2\" data-name=\"code breakout section\">\n            <div class=\"max-w-[1160px] mx-auto px-6\" data-kid=\"1-7-2-1\">\n                <div class=\"flex items-center justify-between f-m text-[11px] uppercase border-b-2 border-black pb-2 mb-6\" data-kid=\"1-7-2-1-1\">\n                    <span data-kid=\"1-7-2-1-1-1\">\n                        contracts/src/PayPool.sol\n                    </span>\n                    <span data-kid=\"1-7-2-1-1-2\">\n                        solidity ^0.8.24 · MIT\n                    </span>\n                </div>\n                <pre class=\"f-m text-[13px] md:text-[15px] leading-relaxed sk\" data-kid=\"1-7-2-1-2\"><span class=\"cm\" data-kid=\"1-7-2-1-2-1\">// SPDX-License-Identifier: MIT</span>\n<span class=\"kw\" data-kid=\"1-7-2-1-2-2\">pragma solidity</span> ^0.8.24;\n\n<span class=\"kw\" data-kid=\"1-7-2-1-2-3\">interface</span> IPayPool {\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-4\">event</span> PaymentReceived(<span class=\"kw\" data-kid=\"1-7-2-1-2-5\">address indexed</span> from, <span class=\"kw\" data-kid=\"1-7-2-1-2-6\">address indexed</span> token, <span class=\"kw\" data-kid=\"1-7-2-1-2-7\">uint256</span> amount);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-8\">event</span> PaymentReleased(<span class=\"kw\" data-kid=\"1-7-2-1-2-9\">address indexed</span> to, <span class=\"kw\" data-kid=\"1-7-2-1-2-10\">address indexed</span> token, <span class=\"kw\" data-kid=\"1-7-2-1-2-11\">uint256</span> amount);\n\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-12\">function</span> initialize(<span class=\"kw\" data-kid=\"1-7-2-1-2-13\">address</span>[] <span class=\"kw\" data-kid=\"1-7-2-1-2-14\">calldata</span> payees, <span class=\"kw\" data-kid=\"1-7-2-1-2-15\">uint256</span>[] <span class=\"kw\" data-kid=\"1-7-2-1-2-16\">calldata</span> shares) <span class=\"kw\" data-kid=\"1-7-2-1-2-17\">external</span>;\n\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-18\">receive</span>() <span class=\"kw\" data-kid=\"1-7-2-1-2-19\">external payable</span>;\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-20\">function</span> depositERC20(<span class=\"kw\" data-kid=\"1-7-2-1-2-21\">address</span> token, <span class=\"kw\" data-kid=\"1-7-2-1-2-22\">uint256</span> amount) <span class=\"kw\" data-kid=\"1-7-2-1-2-23\">external</span>;\n\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-24\">function</span> release(<span class=\"kw\" data-kid=\"1-7-2-1-2-25\">address</span> payee, <span class=\"kw\" data-kid=\"1-7-2-1-2-26\">address</span> token) <span class=\"kw\" data-kid=\"1-7-2-1-2-27\">external</span>;\n\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-28\">function</span> pendingPayment(<span class=\"kw\" data-kid=\"1-7-2-1-2-29\">address</span> payee, <span class=\"kw\" data-kid=\"1-7-2-1-2-30\">address</span> token) <span class=\"kw\" data-kid=\"1-7-2-1-2-31\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-32\">uint256</span>);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-33\">function</span> totalReceived(<span class=\"kw\" data-kid=\"1-7-2-1-2-34\">address</span> token) <span class=\"kw\" data-kid=\"1-7-2-1-2-35\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-36\">uint256</span>);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-37\">function</span> totalReleased(<span class=\"kw\" data-kid=\"1-7-2-1-2-38\">address</span> token) <span class=\"kw\" data-kid=\"1-7-2-1-2-39\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-40\">uint256</span>);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-41\">function</span> getPayees() <span class=\"kw\" data-kid=\"1-7-2-1-2-42\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-43\">address</span>[] <span class=\"kw\" data-kid=\"1-7-2-1-2-44\">memory</span>);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-45\">function</span> getShares() <span class=\"kw\" data-kid=\"1-7-2-1-2-46\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-47\">uint256</span>[] <span class=\"kw\" data-kid=\"1-7-2-1-2-48\">memory</span>);\n    <span class=\"kw\" data-kid=\"1-7-2-1-2-49\">function</span> totalShares() <span class=\"kw\" data-kid=\"1-7-2-1-2-50\">external view returns</span> (<span class=\"kw\" data-kid=\"1-7-2-1-2-51\">uint256</span>);\n}</pre>\n            </div>\n        </div>\n        <div class=\"max-w-2xl mx-auto px-6 mt-12\" data-kid=\"1-7-3\">\n            <p class=\"text-lg leading-relaxed\" data-kid=\"1-7-3-1\">\n                Everything a payee is owed comes out of one expression. No accrual loop, no snapshot, no per-deposit bookkeeping:\n            </p>\n        </div>\n        <div class=\"max-w-[1440px] mx-auto px-6 mt-8\" data-kid=\"1-7-4\" data-name=\"math explanation container\">\n            <div class=\"border-4 border-black bg-white p-6 md:p-10 shadow-[12px_12px_0_#FF3800] overflow-x-auto\" data-kid=\"1-7-4-1\">\n                <p class=\"f-m font-bold text-[clamp(15px,2.4vw,34px)] whitespace-nowrap\" data-kid=\"1-7-4-1-1\">\n                    pending = (totalReceived * shares / totalShares) - released\n                </p>\n            </div>\n            <div class=\"mt-4 flex flex-wrap gap-x-8 gap-y-2 f-m text-[11px] uppercase\" data-kid=\"1-7-4-2\">\n                <span data-kid=\"1-7-4-2-1\">\n                    totalShares == 10000, always\n                </span>\n                <span data-kid=\"1-7-4-2-2\">\n                    released is per (token, payee)\n                </span>\n                <span data-kid=\"1-7-4-2-3\">\n                    integer math, remainder stays in the pool\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 8. ARCHITECTURE — PINWHEEL ================= -->\n    <section class=\"border-y-4 border-black bg-white py-16\" data-kid=\"1-8\" data-name=\"architecture section\" id=\"stack\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-8-1\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-8-1-1\">\n                <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.85]\" data-kid=\"1-8-1-1-1\">\n                    Architecture\n                </h2>\n                <p class=\"f-m text-[11px] uppercase max-w-xs\" data-kid=\"1-8-1-1-2\">\n                    four layers · one direction of data flow · no hidden services\n                </p>\n            </div>\n            <div class=\"mt-10 grid grid-cols-1 md:grid-cols-3 md:grid-rows-3 border-4 border-black\" data-kid=\"1-8-1-2\">\n                <div class=\"md:col-span-2 border-b-4 md:border-r-4 border-black bg-white p-7 min-h-[190px]\" data-kid=\"1-8-1-2-1\">\n                    <div class=\"text-3xl\" data-kid=\"1-8-1-2-1-1\">\n                        <i class=\"ti ti-layers-union\" data-kid=\"1-8-1-2-1-1-1\">\n                        </i>\n                    </div>\n                    <h3 class=\"f-d uppercase text-4xl mt-2\" data-kid=\"1-8-1-2-1-2\">\n                        Contracts\n                    </h3>\n                    <p class=\"f-m text-[12px] mt-2\" data-kid=\"1-8-1-2-1-3\">\n                        Solidity 0.8.24 · Foundry · OpenZeppelin Clones\n                    </p>\n                    <p class=\"f-m text-[11px] mt-1 text-black/60\" data-kid=\"1-8-1-2-1-4\">\n                        PayPool.sol + SplitterFactory.sol · implementation set once in constructor\n                    </p>\n                </div>\n                <div class=\"md:row-span-2 border-b-4 border-black bg-[#FCF75E] p-7 min-h-[190px]\" data-kid=\"1-8-1-2-2\">\n                    <div class=\"text-3xl\" data-kid=\"1-8-1-2-2-1\">\n                        <i class=\"ti ti-server-bolt\" data-kid=\"1-8-1-2-2-1-1\">\n                        </i>\n                    </div>\n                    <h3 class=\"f-d uppercase text-4xl mt-2\" data-kid=\"1-8-1-2-2-2\">\n                        Indexer\n                    </h3>\n                    <p class=\"f-m text-[12px] mt-2\" data-kid=\"1-8-1-2-2-3\">\n                        Python · FastAPI · ARQ\n                    </p>\n                    <ul class=\"f-m text-[11px] mt-3 space-y-1\" data-kid=\"1-8-1-2-2-4\">\n                        <li class=\"border-t-2 border-black pt-1\" data-kid=\"1-8-1-2-2-4-1\">\n                            CONFIRMATION_DEPTH = 5\n                        </li>\n                        <li class=\"border-t-2 border-black pt-1\" data-kid=\"1-8-1-2-2-4-2\">\n                            BATCH_SIZE = 2000\n                        </li>\n                        <li class=\"border-t-2 border-black pt-1\" data-kid=\"1-8-1-2-2-4-3\">\n                            POLL_INTERVAL_SECONDS = 15\n                        </li>\n                        <li class=\"border-t-2 border-black pt-1\" data-kid=\"1-8-1-2-2-4-4\">\n                            CHAIN_ID = 84532\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"md:row-span-2 border-b-4 md:border-b-0 md:border-r-4 border-black bg-black text-white p-7 min-h-[190px]\" data-kid=\"1-8-1-2-3\">\n                    <div class=\"text-3xl text-[#FF3800]\" data-kid=\"1-8-1-2-3-1\">\n                        <i class=\"ti ti-database\" data-kid=\"1-8-1-2-3-1-1\">\n                        </i>\n                    </div>\n                    <h3 class=\"f-d uppercase text-4xl mt-2 text-[#FCF75E]\" data-kid=\"1-8-1-2-3-2\">\n                        Database\n                    </h3>\n                    <p class=\"f-m text-[12px] mt-2\" data-kid=\"1-8-1-2-3-3\">\n                        PostgreSQL\n                    </p>\n                    <p class=\"f-m text-[11px] mt-3 text-white/70\" data-kid=\"1-8-1-2-3-4\">\n                        pools · payees · deposits · withdrawals · indexer_state\n                    </p>\n                    <p class=\"f-m text-[11px] mt-3 border-t-2 border-white/30 pt-2\" data-kid=\"1-8-1-2-3-5\">\n                        UNIQUE (tx_hash, log_index)\n                        <br data-kid=\"1-8-1-2-3-5-1\"/>\n                        ON CONFLICT DO NOTHING → backfill is idempotent\n                    </p>\n                </div>\n                <div class=\"hidden md:block border-r-4 border-b-4 border-black bg-[#F2F3F4]\" data-kid=\"1-8-1-2-4\">\n                </div>\n                <div class=\"md:col-span-2 bg-[#FF3800] p-7 min-h-[190px]\" data-kid=\"1-8-1-2-5\">\n                    <div class=\"text-3xl\" data-kid=\"1-8-1-2-5-1\">\n                        <i class=\"ti ti-brand-react\" data-kid=\"1-8-1-2-5-1-1\">\n                        </i>\n                    </div>\n                    <h3 class=\"f-d uppercase text-4xl mt-2\" data-kid=\"1-8-1-2-5-2\">\n                        Frontend\n                    </h3>\n                    <p class=\"f-m text-[12px] mt-2\" data-kid=\"1-8-1-2-5-3\">\n                        React · Vite · viem + wagmi\n                    </p>\n                    <p class=\"f-m text-[11px] mt-1\" data-kid=\"1-8-1-2-5-4\">\n                        Reads REST for history, reads chain directly for pending — never custodies keys or funds.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 border-4 border-black bg-[#F2F3F4] px-5 py-4 flex flex-wrap items-center gap-x-4 gap-y-2 f-m text-[12px] md:text-sm uppercase\" data-kid=\"1-8-1-3\">\n                <span data-kid=\"1-8-1-3-1\">\n                    chain logs\n                </span>\n                <span class=\"text-[#FF3800] font-bold\" data-kid=\"1-8-1-3-2\">\n                    →\n                </span>\n                <span data-kid=\"1-8-1-3-3\">\n                    eth_getLogs\n                </span>\n                <span class=\"text-[#FF3800] font-bold\" data-kid=\"1-8-1-3-4\">\n                    →\n                </span>\n                <span data-kid=\"1-8-1-3-5\">\n                    Postgres\n                </span>\n                <span class=\"text-[#FF3800] font-bold\" data-kid=\"1-8-1-3-6\">\n                    →\n                </span>\n                <span data-kid=\"1-8-1-3-7\">\n                    REST\n                </span>\n                <span class=\"text-[#FF3800] font-bold\" data-kid=\"1-8-1-3-8\">\n                    →\n                </span>\n                <span class=\"bg-black text-[#FCF75E] px-2\" data-kid=\"1-8-1-3-9\">\n                    dashboard\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 9. USE CASES — HOVER PREVIEW ================= -->\n    <section class=\"bg-black text-white py-16 border-b-4 border-black\" data-kid=\"1-9\" data-name=\"use cases section\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-9-1\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-9-1-1\">\n                <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.85] text-[#FCF75E]\" data-kid=\"1-9-1-1-1\">\n                    Use cases\n                </h2>\n                <p class=\"f-m text-[11px] uppercase text-white/50\" data-kid=\"1-9-1-1-2\">\n                    hover a row\n                </p>\n            </div>\n            <div class=\"mt-10 grid grid-cols-1 lg:grid-cols-2 gap-0 border-4 border-[#FCF75E]\" data-kid=\"1-9-1-2\">\n                <div class=\"divide-y-4 divide-[#FCF75E] grid grid-rows-4\" data-kid=\"1-9-1-2-1\" id=\"uc-list\">\n                    <div class=\"uc-row cursor-pointer py-7 px-6 flex flex-col justify-center\" data-kid=\"1-9-1-2-1-1\" data-uc=\"0\">\n                        <p class=\"f-m text-[11px] text-white/50\" data-kid=\"1-9-1-2-1-1-1\">\n                            01\n                        </p>\n                        <h3 class=\"uc-lbl f-d uppercase text-4xl md:text-5xl tracking-tight\" data-kid=\"1-9-1-2-1-1-2\">\n                            Band royalties\n                        </h3>\n                    </div>\n                    <div class=\"uc-row cursor-pointer py-7 px-6 flex flex-col justify-center\" data-kid=\"1-9-1-2-1-2\" data-uc=\"1\">\n                        <p class=\"f-m text-[11px] text-white/50\" data-kid=\"1-9-1-2-1-2-1\">\n                            02\n                        </p>\n                        <h3 class=\"uc-lbl f-d uppercase text-4xl md:text-5xl tracking-tight\" data-kid=\"1-9-1-2-1-2-2\">\n                            Grant disbursement\n                        </h3>\n                    </div>\n                    <div class=\"uc-row cursor-pointer py-7 px-6 flex flex-col justify-center\" data-kid=\"1-9-1-2-1-3\" data-uc=\"2\">\n                        <p class=\"f-m text-[11px] text-white/50\" data-kid=\"1-9-1-2-1-3-1\">\n                            03\n                        </p>\n                        <h3 class=\"uc-lbl f-d uppercase text-4xl md:text-5xl tracking-tight\" data-kid=\"1-9-1-2-1-3-2\">\n                            OSS payouts\n                        </h3>\n                    </div>\n                    <div class=\"uc-row cursor-pointer py-7 px-6 flex flex-col justify-center\" data-kid=\"1-9-1-2-1-4\" data-uc=\"3\">\n                        <p class=\"f-m text-[11px] text-white/50\" data-kid=\"1-9-1-2-1-4-1\">\n                            04\n                        </p>\n                        <h3 class=\"uc-lbl f-d uppercase text-4xl md:text-5xl tracking-tight\" data-kid=\"1-9-1-2-1-4-2\">\n                            DAO revenue share\n                        </h3>\n                    </div>\n                </div>\n                <div class=\"relative min-h-[420px] border-t-4 lg:border-t-0 lg:border-l-4 border-[#FCF75E] bg-[#111]\" data-kid=\"1-9-1-2-2\">\n                    <!-- panel 0 -->\n                    <div class=\"uc-panel on bg-[#FCF75E] text-black p-8\" data-kid=\"1-9-1-2-2-1\" data-panel=\"0\">\n                        <div class=\"flex gap-2\" data-kid=\"1-9-1-2-2-1-1\">\n                            <span class=\"w-20 h-20 bg-black\" data-kid=\"1-9-1-2-2-1-1-1\">\n                            </span>\n                            <span class=\"w-20 h-20 bg-[#FF3800] border-4 border-black\" data-kid=\"1-9-1-2-2-1-1-2\">\n                            </span>\n                            <span class=\"w-20 h-20 border-4 border-black\" data-kid=\"1-9-1-2-2-1-1-3\">\n                            </span>\n                            <span class=\"w-20 h-20 bg-black rounded-full\" data-kid=\"1-9-1-2-2-1-1-4\">\n                            </span>\n                        </div>\n                        <p class=\"f-d uppercase text-3xl mt-8 leading-tight\" data-kid=\"1-9-1-2-2-1-2\">\n                            4-person band · 2500 bps each\n                        </p>\n                        <p class=\"f-m text-[12px] mt-4 leading-relaxed\" data-kid=\"1-9-1-2-2-1-3\">\n                            Distributor pays royalties into the pool address monthly. Nobody's bank account is the middleman; each member calls release(self, address(0)) whenever they want.\n                        </p>\n                        <div class=\"mt-6 f-m text-[11px] border-t-4 border-black pt-3\" data-kid=\"1-9-1-2-2-1-4\">\n                            pool \"Band Royalties\" · 12.4 ETH lifetime · 31 deposits\n                        </div>\n                    </div>\n                    <!-- panel 1 -->\n                    <div class=\"uc-panel bg-[#FF3800] text-black p-8\" data-kid=\"1-9-1-2-2-2\" data-panel=\"1\">\n                        <div class=\"flex gap-2 items-end\" data-kid=\"1-9-1-2-2-2-1\">\n                            <span class=\"w-14 h-20 bg-black\" data-kid=\"1-9-1-2-2-2-1-1\">\n                            </span>\n                            <span class=\"w-14 h-14 bg-[#FCF75E] border-4 border-black\" data-kid=\"1-9-1-2-2-2-1-2\">\n                            </span>\n                            <span class=\"w-14 h-24 bg-white border-4 border-black\" data-kid=\"1-9-1-2-2-2-1-3\">\n                            </span>\n                            <span class=\"w-14 h-10 bg-black\" data-kid=\"1-9-1-2-2-2-1-4\">\n                            </span>\n                        </div>\n                        <p class=\"f-d uppercase text-3xl mt-8 leading-tight\" data-kid=\"1-9-1-2-2-2-2\">\n                            Grant split · 5000 / 3000 / 2000 bps\n                        </p>\n                        <p class=\"f-m text-[12px] mt-4 leading-relaxed\" data-kid=\"1-9-1-2-2-2-3\">\n                            A funder wires one transaction to one address. Three research teams pull their tranche independently — no treasurer, no reimbursement forms, no reconciliation thread.\n                        </p>\n                        <div class=\"mt-6 f-m text-[11px] border-t-4 border-black pt-3\" data-kid=\"1-9-1-2-2-2-4\">\n                            immutable after initialize() · funder cannot claw back\n                        </div>\n                    </div>\n                    <!-- panel 2 -->\n                    <div class=\"uc-panel bg-white text-black p-8\" data-kid=\"1-9-1-2-2-3\" data-panel=\"2\">\n                        <div class=\"grid grid-cols-6 gap-2 max-w-xs\" data-kid=\"1-9-1-2-2-3-1\">\n                            <span class=\"h-8 bg-black\" data-kid=\"1-9-1-2-2-3-1-1\">\n                            </span>\n                            <span class=\"h-8 bg-[#FCF75E] border-2 border-black\" data-kid=\"1-9-1-2-2-3-1-2\">\n                            </span>\n                            <span class=\"h-8 bg-black\" data-kid=\"1-9-1-2-2-3-1-3\">\n                            </span>\n                            <span class=\"h-8 bg-[#FF3800] border-2 border-black\" data-kid=\"1-9-1-2-2-3-1-4\">\n                            </span>\n                            <span class=\"h-8 bg-black\" data-kid=\"1-9-1-2-2-3-1-5\">\n                            </span>\n                            <span class=\"h-8 border-2 border-black\" data-kid=\"1-9-1-2-2-3-1-6\">\n                            </span>\n                        </div>\n                        <p class=\"f-d uppercase text-3xl mt-8 leading-tight\" data-kid=\"1-9-1-2-2-3-2\">\n                            12 maintainers · shares by commit weight\n                        </p>\n                        <p class=\"f-m text-[12px] mt-4 leading-relaxed\" data-kid=\"1-9-1-2-2-3-3\">\n                            Sponsorship income lands in the pool. Contributors in six timezones withdraw on their own schedule; anyone can call release() on behalf of a maintainer who has lost interest in gas.\n                        </p>\n                        <div class=\"mt-6 f-m text-[11px] border-t-4 border-black pt-3\" data-kid=\"1-9-1-2-2-3-4\">\n                            2 ≤ payees ≤ 20 · duplicate addresses rejected\n                        </div>\n                    </div>\n                    <!-- panel 3 -->\n                    <div class=\"uc-panel bg-black text-[#FCF75E] p-8 border-4 border-[#FCF75E]\" data-kid=\"1-9-1-2-2-4\" data-panel=\"3\">\n                        <div class=\"flex gap-3\" data-kid=\"1-9-1-2-2-4-1\">\n                            <span class=\"w-24 h-24 border-4 border-[#FCF75E]\" data-kid=\"1-9-1-2-2-4-1-1\">\n                            </span>\n                            <span class=\"w-24 h-24 bg-[#FF3800]\" data-kid=\"1-9-1-2-2-4-1-2\">\n                            </span>\n                            <span class=\"w-12 h-24 bg-[#FCF75E]\" data-kid=\"1-9-1-2-2-4-1-3\">\n                            </span>\n                        </div>\n                        <p class=\"f-d uppercase text-3xl mt-8 leading-tight\" data-kid=\"1-9-1-2-2-4-2\">\n                            Protocol fees → contributors + treasury\n                        </p>\n                        <p class=\"f-m text-white text-[12px] mt-4 leading-relaxed\" data-kid=\"1-9-1-2-2-4-3\">\n                            Route a fee stream into a pool whose split was agreed once and can never be quietly edited. Governance debates the next pool, not the current balance.\n                        </p>\n                        <div class=\"mt-6 f-m text-[11px] text-white border-t-4 border-[#FCF75E] pt-3\" data-kid=\"1-9-1-2-2-4-4\">\n                            no owner · no pause · no sweep\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 10. SECURITY INVARIANTS — LEDGER ================= -->\n    <section class=\"py-16 bg-[#F2F3F4]\" data-kid=\"1-10\" data-name=\"invariants section\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-10-1\">\n            <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-10-1-1\">\n                10 / proof, not promises\n            </p>\n            <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.85] mt-2\" data-kid=\"1-10-1-2\">\n                Invariants\n            </h2>\n            <div class=\"mt-10 border-4 border-black bg-white p-6 md:p-10 shadow-[12px_12px_0_#000]\" data-kid=\"1-10-1-3\" data-scroll=\"\" data-scroll-speed=\"0.08\">\n                <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-10-1-3-1\">\n                    fuzz / invariant · the one that matters\n                </p>\n                <p class=\"f-m font-bold text-[clamp(16px,3.6vw,58px)] leading-tight mt-3\" data-kid=\"1-10-1-3-2\">\n                    totalReceived == totalReleased + sum(pending)\n                </p>\n                <p class=\"f-m text-[12px] mt-4 uppercase\" data-kid=\"1-10-1-3-3\">\n                    holds across randomized deposit / release call sequences · 256 runs × 128 depth\n                </p>\n            </div>\n            <div class=\"mt-12 border-t-4 border-black\" data-kid=\"1-10-1-4\">\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-1\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b border-black/40\" data-kid=\"1-10-1-4-1-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-1-1-1\">\n                            test_initialize_validates_shares\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-1-1-2\">\n                            require(sum(shares) == 10_000)\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-1-1-3\">\n                            <span class=\"bg-[#FCF75E] border-2 border-black px-2\" data-kid=\"1-10-1-4-1-1-3-1\">\n                                REVERTS · 9 CASES\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-2\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b border-black/40\" data-kid=\"1-10-1-4-2-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-2-1-1\">\n                            test_initialize_rejects_duplicate_payee\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-2-1-2\">\n                            seen[payee] == false, 2 <= n <= 20\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-2-1-3\">\n                            <span class=\"bg-white border-2 border-black px-2\" data-kid=\"1-10-1-4-2-1-3-1\">\n                                REVERTS · DUPLICATE\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-3\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b border-black/40\" data-kid=\"1-10-1-4-3-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-3-1-1\">\n                            test_release_twice_second_call_pays_zero_delta\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-3-1-2\">\n                            pending -= released → 0 on repeat call\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-3-1-3\">\n                            <span class=\"bg-[#FF3800] text-white border-2 border-black px-2\" data-kid=\"1-10-1-4-3-1-3-1\">\n                                NO DOUBLE PAY\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-4\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b border-black/40\" data-kid=\"1-10-1-4-4-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-4-1-1\">\n                            test_cannot_reinitialize\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-4-1-2\">\n                            if (initialized) revert AlreadyInitialized()\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-4-1-3\">\n                            <span class=\"bg-white border-2 border-black px-2\" data-kid=\"1-10-1-4-4-1-3-1\">\n                                1 CALL, FOREVER\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-5\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b border-black/40\" data-kid=\"1-10-1-4-5-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-5-1-1\">\n                            test_deposit_eth_updates_totalReceived\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-5-1-2\">\n                            totalReceived[address(0)] += msg.value\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-5-1-3\">\n                            <span class=\"bg-[#FCF75E] border-2 border-black px-2\" data-kid=\"1-10-1-4-5-1-3-1\">\n                                EXACT, WEI-FOR-WEI\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rowrev\" data-kid=\"1-10-1-4-6\" data-scroll=\"\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-5 border-b-4 border-black\" data-kid=\"1-10-1-4-6-1\">\n                        <p class=\"md:col-span-4 f-d uppercase text-xl leading-tight break-words\" data-kid=\"1-10-1-4-6-1-1\">\n                            test_gas_clone_vs_full_deploy\n                        </p>\n                        <p class=\"md:col-span-5 f-m text-[12px] self-center\" data-kid=\"1-10-1-4-6-1-2\">\n                            Clones.clone(implementation) + initialize()\n                        </p>\n                        <p class=\"md:col-span-3 f-m text-sm font-bold self-center md:text-right\" data-kid=\"1-10-1-4-6-1-3\">\n                            <span class=\"bg-black text-[#FCF75E] px-2\" data-kid=\"1-10-1-4-6-1-3-1\">\n                                ≈ 89% LESS GAS\n                            </span>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 11. FAQ ================= -->\n    <section class=\"border-y-4 border-black bg-white py-16\" data-kid=\"1-11\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-11-1\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4 mb-10\" data-kid=\"1-11-1-1\">\n                <h2 class=\"f-d uppercase text-6xl md:text-8xl tracking-tight leading-[0.92]\" data-kid=\"1-11-1-1-1\">\n                    Deliberate\n                    <br data-kid=\"1-11-1-1-1-1\"/>\n                    decisions\n                </h2>\n                <p class=\"f-m text-[11px] uppercase max-w-xs\" data-kid=\"1-11-1-1-2\">\n                    out of scope for v1 — documented as choices, not gaps\n                </p>\n            </div>\n            <div class=\"border-4 border-black divide-y-4 divide-black\" data-kid=\"1-11-1-2\" id=\"faq-list\">\n                <div class=\"faq-item\" data-kid=\"1-11-1-2-1\">\n                    <button class=\"faq-btn w-full text-left flex items-center gap-5 p-6 hover:bg-[#FCF75E]\" data-kid=\"1-11-1-2-1-1\">\n                        <span class=\"f-m text-[11px] w-8 shrink-0\" data-kid=\"1-11-1-2-1-1-1\">\n                            Q1\n                        </span>\n                        <span class=\"f-d uppercase text-2xl md:text-3xl flex-1 leading-tight\" data-kid=\"1-11-1-2-1-1-2\">\n                            Can I change shares after deploying?\n                        </span>\n                        <span class=\"faq-plus f-d text-3xl leading-none shrink-0\" data-kid=\"1-11-1-2-1-1-3\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-body px-6 pb-6 pl-[76px] text-sm max-w-3xl leading-relaxed\" data-kid=\"1-11-1-2-1-2\">\n                        No. Pools are immutable once deployed. Mutable allocations would require an owner or a governance module — which reintroduces exactly the trusted party PayPool exists to remove. If a split must change, you deploy a new pool; the clone pattern makes that cheap.\n                    </div>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-11-1-2-2\">\n                    <button class=\"faq-btn w-full text-left flex items-center gap-5 p-6 hover:bg-[#FCF75E]\" data-kid=\"1-11-1-2-2-1\">\n                        <span class=\"f-m text-[11px] w-8 shrink-0\" data-kid=\"1-11-1-2-2-1-1\">\n                            Q2\n                        </span>\n                        <span class=\"f-d uppercase text-2xl md:text-3xl flex-1 leading-tight\" data-kid=\"1-11-1-2-2-1-2\">\n                            Is it multi-chain?\n                        </span>\n                        <span class=\"faq-plus f-d text-3xl leading-none shrink-0\" data-kid=\"1-11-1-2-2-1-3\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-body px-6 pb-6 pl-[76px] text-sm max-w-3xl leading-relaxed\" data-kid=\"1-11-1-2-2-2\">\n                        One deployment lives on one chain — Base Sepolia (\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-2-2-1\">\n                            CHAIN_ID=84532\n                        </span>\n                        ) for testnet. The contracts are portable to any EVM chain via config, but a single pool instance never spans chains. Cross-chain accounting would mean bridging assumptions inside a contract whose whole value is having none.\n                    </div>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-11-1-2-3\">\n                    <button class=\"faq-btn w-full text-left flex items-center gap-5 p-6 hover:bg-[#FCF75E]\" data-kid=\"1-11-1-2-3-1\">\n                        <span class=\"f-m text-[11px] w-8 shrink-0\" data-kid=\"1-11-1-2-3-1-1\">\n                            Q3\n                        </span>\n                        <span class=\"f-d uppercase text-2xl md:text-3xl flex-1 leading-tight\" data-kid=\"1-11-1-2-3-1-2\">\n                            Does the dashboard ever hold funds?\n                        </span>\n                        <span class=\"faq-plus f-d text-3xl leading-none shrink-0\" data-kid=\"1-11-1-2-3-1-3\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-body px-6 pb-6 pl-[76px] text-sm max-w-3xl leading-relaxed\" data-kid=\"1-11-1-2-3-2\">\n                        Never. The dashboard is a read layer plus a transaction builder. It holds no keys, no balances, and takes no fee — v1 is not monetized by the protocol at all. Funds only ever sit in the pool contract or in a payee's own address.\n                    </div>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-11-1-2-4\">\n                    <button class=\"faq-btn w-full text-left flex items-center gap-5 p-6 hover:bg-[#FCF75E]\" data-kid=\"1-11-1-2-4-1\">\n                        <span class=\"f-m text-[11px] w-8 shrink-0\" data-kid=\"1-11-1-2-4-1-1\">\n                            Q4\n                        </span>\n                        <span class=\"f-d uppercase text-2xl md:text-3xl flex-1 leading-tight\" data-kid=\"1-11-1-2-4-1-2\">\n                            Do I have to trust the indexer?\n                        </span>\n                        <span class=\"faq-plus f-d text-3xl leading-none shrink-0\" data-kid=\"1-11-1-2-4-1-3\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-body px-6 pb-6 pl-[76px] text-sm max-w-3xl leading-relaxed\" data-kid=\"1-11-1-2-4-2\">\n                        No. The indexer is a convenience, not a source of truth. Every figure it serves is derived from public logs and re-derivable with\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-4-2-1\">\n                            eth_getLogs\n                        </span>\n                        or a single\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-4-2-2\">\n                            pendingPayment()\n                        </span>\n                        call. It waits\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-4-2-3\">\n                            CONFIRMATION_DEPTH=5\n                        </span>\n                        blocks and exposes its own lag at\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-4-2-4\">\n                            /health\n                        </span>\n                        so you can see when it is degraded.\n                    </div>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-11-1-2-5\">\n                    <button class=\"faq-btn w-full text-left flex items-center gap-5 p-6 hover:bg-[#FCF75E]\" data-kid=\"1-11-1-2-5-1\">\n                        <span class=\"f-m text-[11px] w-8 shrink-0\" data-kid=\"1-11-1-2-5-1-1\">\n                            Q5\n                        </span>\n                        <span class=\"f-d uppercase text-2xl md:text-3xl flex-1 leading-tight\" data-kid=\"1-11-1-2-5-1-2\">\n                            Why Clones.clone and not CREATE2?\n                        </span>\n                        <span class=\"faq-plus f-d text-3xl leading-none shrink-0\" data-kid=\"1-11-1-2-5-1-3\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-body px-6 pb-6 pl-[76px] text-sm max-w-3xl leading-relaxed\" data-kid=\"1-11-1-2-5-2\">\n                        Sequential\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-5-2-1\">\n                            CREATE\n                        </span>\n                        via\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-5-2-2\">\n                            Clones.clone\n                        </span>\n                        means pool addresses are not predictable before deployment, which sidesteps the whole front-running-a-vanity-address class of issue.\n                        <span class=\"f-m\" data-kid=\"1-11-1-2-5-2-3\">\n                            cloneDeterministic\n                        </span>\n                        remains a documented upgrade path if deterministic addresses ever become a requirement.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 12. CTA + FOOTER ================= -->\n    <section class=\"bg-[#FCF75E] border-b-4 border-black\" data-kid=\"1-12\" data-name=\"footer cta section\" id=\"cta\">\n        <div class=\"max-w-[1440px] mx-auto px-6 min-h-[520px] flex items-end\" data-kid=\"1-12-1\">\n            <div class=\"pt-24 pb-16 max-w-3xl\" data-kid=\"1-12-1-1\">\n                <p class=\"f-m text-[11px] uppercase\" data-kid=\"1-12-1-1-1\">\n                    forge script Deploy.s.sol --broadcast\n                </p>\n                <h2 class=\"f-d uppercase text-6xl md:text-[7rem] tracking-tight leading-[0.82] mt-3\" data-kid=\"1-12-1-1-2\">\n                    Split it\n                    <br data-kid=\"1-12-1-1-2-1\"/>\n                    on-chain.\n                </h2>\n                <p class=\"mt-5 text-lg max-w-xl\" data-kid=\"1-12-1-1-3\">\n                    Two payees or twenty. One transaction to create, one address to fund, one function to withdraw.\n                </p>\n                <a class=\"mt-9 inline-block f-d uppercase text-2xl md:text-4xl bg-black text-[#FCF75E] px-8 py-6 border-4 border-black shadow-[12px_12px_0_#FF3800] hover:shadow-[4px_4px_0_#FF3800] hover:translate-x-2 hover:translate-y-2 transition-all duration-150\" data-kid=\"1-12-1-1-4\" href=\"#\">\n                    Deploy a pool on Base Sepolia\n                </a>\n                <p class=\"f-m text-[11px] uppercase mt-5\" data-kid=\"1-12-1-1-5\">\n                    testnet ETH only · no fees · MIT\n                </p>\n            </div>\n        </div>\n    </section>\n    <footer class=\"bg-black text-white\" data-kid=\"1-13\" data-name=\"main footer\">\n        <div class=\"max-w-[1440px] mx-auto px-6\" data-kid=\"1-13-1\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 border-b-4 border-[#FCF75E]\" data-kid=\"1-13-1-1\">\n                <div class=\"p-8 md:border-r-4 border-[#FCF75E] border-b-4 md:border-b-0\" data-kid=\"1-13-1-1-1\">\n                    <p class=\"f-d uppercase text-lg text-[#FCF75E]\" data-kid=\"1-13-1-1-1-1\">\n                        Product\n                    </p>\n                    <ul class=\"mt-4 space-y-2 f-m text-[12px] text-white/70\" data-kid=\"1-13-1-1-1-2\">\n                        <li data-kid=\"1-13-1-1-1-2-1\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-1-2-1-1\" href=\"#\">\n                                Create a pool\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-1-2-2\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-1-2-2-1\" href=\"#\">\n                                Browse pools\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-1-2-3\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-1-2-3-1\" href=\"#\">\n                                My earnings\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-1-2-4\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-1-2-4-1\" href=\"#\">\n                                Indexer status\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-1-2-5\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-1-2-5-1\" href=\"#\">\n                                Roadmap / TODO.md\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"p-8 md:border-r-4 border-[#FCF75E] border-b-4 md:border-b-0\" data-kid=\"1-13-1-1-2\">\n                    <p class=\"f-d uppercase text-lg text-[#FCF75E]\" data-kid=\"1-13-1-1-2-1\">\n                        Docs\n                    </p>\n                    <ul class=\"mt-4 space-y-2 f-m text-[12px] text-white/70\" data-kid=\"1-13-1-1-2-2\">\n                        <li data-kid=\"1-13-1-1-2-2-1\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-2-2-1-1\" href=\"#\">\n                                README.md\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-2-2-2\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-2-2-2-1\" href=\"#\">\n                                PRODUCT.md\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-2-2-3\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-2-2-3-1\" href=\"#\">\n                                ARCHITECTURE.md\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-2-2-4\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-2-2-4-1\" href=\"#\">\n                                DESIGN.md\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-2-2-5\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-2-2-5-1\" href=\"#\">\n                                SECURITY.md\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"p-8 md:border-r-4 border-[#FCF75E] border-b-4 md:border-b-0\" data-kid=\"1-13-1-1-3\">\n                    <p class=\"f-d uppercase text-lg text-[#FCF75E]\" data-kid=\"1-13-1-1-3-1\">\n                        Build\n                    </p>\n                    <ul class=\"mt-4 space-y-2 f-m text-[12px] text-white/70\" data-kid=\"1-13-1-1-3-2\">\n                        <li data-kid=\"1-13-1-1-3-2-1\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-3-2-1-1\" href=\"#\">\n                                forge install && forge test\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-3-2-2\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-3-2-2-1\" href=\"#\">\n                                arq worker.WorkerSettings\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-3-2-3\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-3-2-3-1\" href=\"#\">\n                                npm run dev\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-3-2-4\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-3-2-4-1\" href=\"#\">\n                                CONTRIBUTING.md\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-3-2-5\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-3-2-5-1\" href=\"#\">\n                                Env vars reference\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"p-8\" data-kid=\"1-13-1-1-4\">\n                    <p class=\"f-d uppercase text-lg text-[#FCF75E]\" data-kid=\"1-13-1-1-4-1\">\n                        Legal\n                    </p>\n                    <ul class=\"mt-4 space-y-2 f-m text-[12px] text-white/70\" data-kid=\"1-13-1-1-4-2\">\n                        <li data-kid=\"1-13-1-1-4-2-1\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-4-2-1-1\" href=\"#\">\n                                MIT License\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-4-2-2\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-4-2-2-1\" href=\"#\">\n                                No custody statement\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-4-2-3\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-4-2-3-1\" href=\"#\">\n                                Threat model\n                            </a>\n                        </li>\n                        <li data-kid=\"1-13-1-1-4-2-4\">\n                            <a class=\"hover:text-[#FF3800]\" data-kid=\"1-13-1-1-4-2-4-1\" href=\"#\">\n                                Audit checklist\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"py-10 flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 border-b-4 border-[#FCF75E]\" data-kid=\"1-13-1-2\">\n                <p class=\"f-d uppercase text-[15vw] lg:text-[9rem] leading-[0.8] tracking-tight text-[#FCF75E]\" data-kid=\"1-13-1-2-1\">\n                    PAYPOOL\n                </p>\n                <div class=\"f-m text-[11px] uppercase text-white/60 space-y-1 lg:text-right\" data-kid=\"1-13-1-2-2\">\n                    <p data-kid=\"1-13-1-2-2-1\">\n                        factory 0x4B8e…C013\n                    </p>\n                    <p data-kid=\"1-13-1-2-2-2\">\n                        implementation 0xE0a7…5D44\n                    </p>\n                    <p data-kid=\"1-13-1-2-2-3\">\n                        chain 84532 · base sepolia\n                    </p>\n                </div>\n            </div>\n            <div class=\"py-6 flex flex-col md:flex-row justify-between gap-3 f-m text-[11px] uppercase text-white/50\" data-kid=\"1-13-1-3\">\n                <p data-kid=\"1-13-1-3-1\">\n                    © 2026 PayPool · MIT · no admin keys, no exceptions\n                </p>\n                <p class=\"flex gap-5\" data-kid=\"1-13-1-3-2\">\n                    <a class=\"hover:text-[#FCF75E]\" data-kid=\"1-13-1-3-2-1\" href=\"#\">\n                        GitHub\n                    </a>\n                    <a class=\"hover:text-[#FCF75E]\" data-kid=\"1-13-1-3-2-2\" href=\"#\">\n                        Basescan\n                    </a>\n                    <a class=\"hover:text-[#FCF75E]\" data-kid=\"1-13-1-3-2-3\" href=\"#\">\n                        Status\n                    </a>\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n<!-- ===== LIBS ===== -->\n<link data-kid=\"2\" data-name=\"locomotive scroll css\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4\">\n</script>\n<script>\n    new LocomotiveScroll();\n\n  /* ---------- SPLIT CALCULATOR ---------- */\n  const POOL = 12.4;\n  const payees = [\n    {addr:'0xA71c…9F02', label:'nina.eth',  color:'#FF3800', tc:'#000'},\n    {addr:'0x3Fb2…10Ce', label:'omar.eth',  color:'#FCF75E', tc:'#000'},\n    {addr:'0x91dE…4402', label:'kaya.eth',  color:'#000000', tc:'#FCF75E'},\n    {addr:'0xCc08…77aF', label:'rue.eth',   color:'#FFFFFF', tc:'#000'}\n  ];\n  let bps = [3500,2500,2500,1500];\n\n  const rowsEl = document.getElementById('calc-rows');\n  const barEl  = document.getElementById('calc-bar');\n\n  payees.forEach((p,i)=>{\n    const row = document.createElement('div');\n    row.innerHTML = `\n      <div class=\"flex flex-wrap items-baseline justify-between gap-2\">\n        <span class=\"f-m text-[12px]\"><span class=\"inline-block w-3 h-3 mr-2 border-2 border-black align-middle\" style=\"background:${p.color}\"></span>${p.addr} <span class=\"text-black/50\">${p.label}</span></span>\n        <span class=\"f-m text-[12px] font-bold\"><span data-bps=\"${i}\">${bps[i]}</span> bps · <span data-pct=\"${i}\"></span>% · <span data-eth=\"${i}\"></span> ETH</span>\n      </div>\n      <input type=\"range\" class=\"br mt-2\" min=\"500\" max=\"8500\" step=\"100\" value=\"${bps[i]}\" data-idx=\"${i}\">`;\n    rowsEl.appendChild(row);\n    const seg = document.createElement('div');\n    seg.style.background = p.color;\n    seg.className = 'border-r-4 border-black last:border-r-0 flex items-center justify-center f-m text-[11px] font-bold overflow-hidden';\n    seg.style.color = p.tc;\n    seg.dataset.seg = i;\n    barEl.appendChild(seg);\n  });\n\n  function normalize(idx){\n    const TOTAL = 10000, MIN = 100;\n    let v = Math.max(500, Math.min(8500, Math.round(bps[idx]/100)*100));\n    bps[idx] = v;\n    const others = [0,1,2,3].filter(i=>i!==idx);\n    const rest = TOTAL - v;\n    let sum = others.reduce((a,i)=>a+bps[i],0);\n    if(sum <= 0){ others.forEach(i=>bps[i] = Math.round(rest/others.length/100)*100); }\n    else { others.forEach(i=>bps[i] = Math.max(MIN, Math.round(bps[i]/sum*rest/100)*100)); }\n    let drift = TOTAL - bps.reduce((a,b)=>a+b,0);\n    for(const i of others){\n      if(drift === 0) break;\n      const next = bps[i] + drift;\n      if(next >= MIN){ bps[i] = next; drift = 0; }\n    }\n    if(drift !== 0) bps[idx] += drift;\n  }\n\n  function render(activeIdx){\n    let total = 0;\n    bps.forEach((v,i)=>{\n      const pct = v/100;\n      total += v;\n      document.querySelector(`[data-bps=\"${i}\"]`).textContent = v;\n      document.querySelector(`[data-pct=\"${i}\"]`).textContent = pct.toFixed(2);\n      document.querySelector(`[data-eth=\"${i}\"]`).textContent = (POOL*v/10000).toFixed(4);\n      const seg = document.querySelector(`[data-seg=\"${i}\"]`);\n      seg.style.width = pct + '%';\n      seg.textContent = pct >= 9 ? pct.toFixed(0)+'%' : '';\n      const inp = document.querySelector(`input[data-idx=\"${i}\"]`);\n      if(i !== activeIdx) inp.value = v;\n    });\n    document.getElementById('bps-sum').textContent = total;\n  }\n  render(-1);\n\n  rowsEl.addEventListener('input', e=>{\n    const inp = e.target.closest('input[type=range]'); if(!inp) return;\n    const idx = +inp.dataset.idx;\n    bps[idx] = +inp.value;\n    normalize(idx);\n    render(idx);\n  });\n\n  /* ---------- FAQ ---------- */\n  document.querySelectorAll('.faq-btn').forEach(btn=>{\n    btn.addEventListener('click', ()=>{\n      const item = btn.parentElement;\n      const open = item.classList.contains('faq-open');\n      document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('faq-open'));\n      if(!open) item.classList.add('faq-open');\n    });\n  });\n\n  /* ---------- CHART ---------- */\n  window.addEventListener('load', ()=>{\n    const ctx = document.getElementById('depChart');\n    if(!ctx || !window.Chart) return;\n    new Chart(ctx, {\n      type:'bar',\n      data:{\n        labels:['…678','…700','…742','…811','…903','…958','…012'],\n        datasets:[{\n          data:[1.2,3.2,0.8,2.4,1.6,2.0,1.2],\n          backgroundColor:['#FCF75E','#FF3800','#FCF75E','#FCF75E','#FF3800','#FCF75E','#FCF75E'],\n          borderColor:'#000', borderWidth:3, borderRadius:0, barPercentage:0.85, categoryPercentage:0.9\n        }]\n      },\n      options:{\n        responsive:true, maintainAspectRatio:false, animation:{duration:900},\n        plugins:{legend:{display:false},tooltip:{enabled:false}},\n        scales:{\n          x:{grid:{display:false},border:{color:'#000',width:3},ticks:{font:{family:\"'JetBrains Mono',monospace\",size:9},color:'#000'}},\n          y:{grid:{color:'rgba(0,0,0,.12)'},border:{color:'#000',width:3},ticks:{font:{family:\"'JetBrains Mono',monospace\",size:9},color:'#000',stepSize:1}}\n        }\n      }\n    });\n  });\n</script>\n<script type=\"module\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n  /* use case hover clip-path reveal */\n  const panels = document.querySelectorAll('.uc-panel');\n  let current = 0;\n  document.querySelectorAll('.uc-row').forEach(row=>{\n    row.addEventListener('pointerenter', ()=>{\n      const i = +row.dataset.uc;\n      if(i === current) return;\n      const inc = panels[i], out = panels[current];\n      current = i;\n      panels.forEach(p=>p.classList.remove('on'));\n      inc.style.zIndex = 5; out.style.zIndex = 4;\n      animate(inc, { clipPath:['inset(0 100% 0 0)','inset(0 0% 0 0)'], duration:520, ease:'outQuart' });\n    });\n  });\n\n  /* slider thumb micro-interaction */\n  document.querySelectorAll('input.br').forEach(inp=>{\n    inp.addEventListener('input', ()=>{\n      animate(inp, { scaleY:[1.14,1], duration:260, ease:'outElastic(1, .5)' });\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-14T16:38:12.419900+00:00",
      "modified": "2026-08-14T16:38:12.419900+00:00",
      "id": "var_e27479693633",
      "viewportScrollY": 0
    },
    "var_5e35d0b8bf89": {
      "type": "variant",
      "label": "PayPool Landing — Fintech Swiss",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n.f-serif{font-family:'Playfair Display',serif}\n.f-sans{font-family:'Inter',sans-serif}\n.f-mono{font-family:'JetBrains Mono',ui-monospace,monospace}\n.hair{border-color:rgba(42,52,57,0.15)}\n.eyebrow{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(42,52,57,0.5)}\n.k{color:#0070BB}\n.cm{color:rgba(42,52,57,0.45)}\n.marq{display:flex;width:max-content;animation:marq 48s linear infinite}\n@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.faq-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.22,.61,.36,1)}\n.faq-q{cursor:pointer}\n#hero-fig{filter:blur(0px)}\n.leader{transform-origin:left center}\na{text-decoration:none;color:inherit}\n</style>\n<link data-kid=\"1\" data-name=\"lenis scroll library css link\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"f-sans bg-[#F8F8FF] text-[#2A3439] antialiased\" data-kid=\"2\" data-name=\"page layout container\">\n    <!-- 1. TOP BAR -->\n    <header class=\"border-b hair sticky top-0 bg-[#F8F8FF]/95 backdrop-blur-sm z-40\" data-kid=\"2-1\" data-name=\"header navigation bar\">\n        <div class=\"mx-auto max-w-[1280px] px-8 h-14 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"header container\">\n            <span class=\"f-serif text-[19px] tracking-tight\" data-kid=\"2-1-1-1\" data-name=\"brand name\">\n                PayPool\n            </span>\n            <nav class=\"hidden md:flex gap-8 text-[12px] text-[#2A3439]/70\" data-kid=\"2-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-1\" data-name=\"how it works link\" href=\"#how\">\n                    How it works\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-2\" data-name=\"trustless link\" href=\"#trustless\">\n                    Trustless\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-3\" data-name=\"dashboard link\" href=\"#dashboard\">\n                    Dashboard\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-4\" data-name=\"contract link\" href=\"#contract\">\n                    Contract\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-5\" data-name=\"architecture link\" href=\"#stack\">\n                    Architecture\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-6\" data-name=\"security link\" href=\"#security\">\n                    Security\n                </a>\n                <a class=\"hover:text-[#0070BB]\" data-kid=\"2-1-1-2-7\" data-name=\"faq link\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-6\" data-kid=\"2-1-1-3\" data-name=\"header actions container\">\n                <span class=\"f-mono text-[10.5px] text-[#2A3439]/55 hidden lg:inline\" data-kid=\"2-1-1-3-1\" data-name=\"network status text\">\n                    Base Sepolia · 84532\n                </span>\n                <a class=\"text-[12px] font-medium text-[#0070BB]\" data-kid=\"2-1-1-3-2\" data-name=\"deploy pool button\" href=\"#cta\">\n                    Deploy a pool →\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- 2. HERO -->\n    <section class=\"mx-auto max-w-[1280px] px-8 grid grid-cols-12 border-b hair\" data-kid=\"2-2\" data-name=\"hero section\">\n        <aside class=\"col-span-12 md:col-span-2 md:border-r hair py-12 md:pr-6\" data-kid=\"2-2-1\" data-name=\"hero sidebar metadata\">\n            <div class=\"eyebrow\" data-kid=\"2-2-1-1\" data-name=\"issue label\">\n                Issue 01 — Protocol\n            </div>\n            <div class=\"mt-10 space-y-5 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-2-1-2\" data-name=\"technical details container\">\n                <div class=\"border-t hair pt-2\" data-kid=\"2-2-1-2-1\" data-name=\"license info\">\n                    MIT licensed\n                </div>\n                <div class=\"border-t hair pt-2\" data-kid=\"2-2-1-2-2\" data-name=\"version info\">\n                    v1 · testnet\n                </div>\n                <div class=\"border-t hair pt-2\" data-kid=\"2-2-1-2-3\" data-name=\"solidity version info\">\n                    Solidity 0.8.24\n                </div>\n                <div class=\"border-t hair pt-2\" data-kid=\"2-2-1-2-4\" data-name=\"frameworks info\">\n                    Foundry · viem\n                </div>\n            </div>\n            <div class=\"mt-12 border-t hair pt-3 f-mono text-[10px] text-[#2A3439]/45 leading-relaxed\" data-kid=\"2-2-1-3\" data-name=\"protocol guarantees text\">\n                No custodian.\n                <br data-kid=\"2-2-1-3-1\" data-name=\"line break\"/>\n                No admin key.\n                <br data-kid=\"2-2-1-3-2\" data-name=\"line break\"/>\n                No protocol fee.\n            </div>\n        </aside>\n        <div class=\"col-span-12 md:col-span-6 py-14 md:px-10\" data-kid=\"2-2-2\" data-name=\"hero main content area\">\n            <h1 class=\"f-serif text-[46px] sm:text-[56px] lg:text-[62px] leading-[1.03] tracking-[-0.02em]\" data-kid=\"2-2-2-1\" data-name=\"hero main headline\" id=\"hero-h1\">\n                Trustless,\n                <em class=\"italic\" data-kid=\"2-2-2-1-1\" data-name=\"italic headline emphasize\">\n                    on-chain\n                </em>\n                revenue splitting.\n            </h1>\n            <p class=\"hero-r mt-7 text-[15.5px] leading-[1.75] text-[#2A3439]/75 max-w-[48ch]\" data-kid=\"2-2-2-2\" data-name=\"hero subheadline description\">\n                Deploy a pool, define payees and shares, and let anyone send funds to it — each payee withdraws their exact proportional share at any time, with zero custodians and zero admin keys.\n            </p>\n            <div class=\"hero-r mt-9 flex items-center gap-7\" data-kid=\"2-2-2-3\" data-name=\"hero call to action buttons container\">\n                <a class=\"bg-[#0070BB] text-[#F8F8FF] text-[13px] font-medium px-7 py-3.5 hover:bg-[#2A3439]\" data-kid=\"2-2-2-3-1\" data-name=\"deploy pool button\" href=\"#cta\">\n                    Deploy a pool\n                </a>\n                <a class=\"text-[13px] text-[#2A3439]/70 border-b hair pb-0.5 hover:text-[#0070BB]\" data-kid=\"2-2-2-3-2\" data-name=\"read contract interface link\" href=\"#contract\">\n                    Read the contract interface\n                </a>\n            </div>\n            <div class=\"hero-r mt-12 f-mono text-[11px] text-[#2A3439]/55 border-t hair pt-3\" data-kid=\"2-2-2-4\" data-name=\"code snippet container\">\n                <span class=\"k\" data-kid=\"2-2-2-4-1\" data-name=\"shell prompt symbol\">\n                    $\n                </span>\n                forge test\n                <span class=\"cm\" data-kid=\"2-2-2-4-2\" data-name=\"code status comment\">\n                    — 27 passing · 1 invariant · 0 failing\n                </span>\n            </div>\n        </div>\n        <div class=\"col-span-12 md:col-span-4 md:border-l hair bg-[#E3DAC9]/25 flex items-center justify-center py-10 relative overflow-hidden\" data-kid=\"2-2-3\" data-name=\"hero illustration container\">\n            <img alt=\"\" class=\"absolute inset-0 w-full h-full object-cover opacity-[0.035] blur-[3px] pointer-events-none\" data-kid=\"2-2-3-1\" data-name=\"background texture image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/1b8afdd3483f4f6685a013f6965593a9.jpg\"/>\n            <svg class=\"w-full max-w-[340px] relative\" data-kid=\"2-2-3-2\" data-name=\"hero svg diagram\" id=\"hero-fig\" viewbox=\"0 0 380 520\">\n                <g fill=\"none\" stroke=\"#0070BB\" stroke-width=\"1\">\n                    <path class=\"arc\" d=\"M124 210 C 190 210 195 80 236 80\">\n                    </path>\n                    <path class=\"arc\" d=\"M126 196 C 190 190 200 178 249 178\">\n                    </path>\n                    <path class=\"arc\" d=\"M126 224 C 190 232 202 272 246 272\">\n                    </path>\n                    <path class=\"arc\" d=\"M124 238 C 190 250 198 358 251 358\">\n                    </path>\n                </g>\n                <circle cx=\"80\" cy=\"217\" fill=\"#F8F8FF\" r=\"42\" stroke=\"#2A3439\" stroke-width=\"1.25\">\n                </circle>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"9\" text-anchor=\"middle\" x=\"80\" y=\"213\">\n                    POOL\n                </text>\n                <text class=\"f-mono\" fill=\"#0070BB\" font-size=\"8\" text-anchor=\"middle\" x=\"80\" y=\"226\">\n                    10,000 bps\n                </text>\n                <circle cx=\"270\" cy=\"80\" fill=\"#E3DAC9\" r=\"33\" stroke=\"#0070BB\" stroke-width=\"1\">\n                </circle>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"10\" text-anchor=\"middle\" x=\"270\" y=\"84\">\n                    4000\n                </text>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"8\" opacity=\"0.6\" text-anchor=\"middle\" x=\"270\" y=\"128\">\n                    0x4f2a…9c1b\n                </text>\n                <circle cx=\"276\" cy=\"178\" fill=\"#F8F8FF\" r=\"26\" stroke=\"#0070BB\" stroke-width=\"1\">\n                </circle>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"10\" text-anchor=\"middle\" x=\"276\" y=\"182\">\n                    2500\n                </text>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"8\" opacity=\"0.6\" text-anchor=\"middle\" x=\"276\" y=\"216\">\n                    0x9be1…04d7\n                </text>\n                <circle cx=\"270\" cy=\"272\" fill=\"#E3DAC9\" r=\"23\" stroke=\"#0070BB\" stroke-width=\"1\">\n                </circle>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"10\" text-anchor=\"middle\" x=\"270\" y=\"276\">\n                    2000\n                </text>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"8\" opacity=\"0.6\" text-anchor=\"middle\" x=\"270\" y=\"307\">\n                    0x1d77…ae30\n                </text>\n                <circle cx=\"272\" cy=\"358\" fill=\"#F8F8FF\" r=\"20\" stroke=\"#0070BB\" stroke-width=\"1\">\n                </circle>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"10\" text-anchor=\"middle\" x=\"272\" y=\"362\">\n                    1500\n                </text>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"8\" opacity=\"0.6\" text-anchor=\"middle\" x=\"272\" y=\"390\">\n                    0xc0ff…82ab\n                </text>\n                <line stroke=\"#2A3439\" stroke-opacity=\"0.2\" x1=\"40\" x2=\"340\" y1=\"440\" y2=\"440\">\n                </line>\n                <text class=\"f-mono\" fill=\"#2A3439\" font-size=\"8\" opacity=\"0.6\" x=\"40\" y=\"459\">\n                    FIG. 1 — PROPORTIONAL DISTRIBUTION, BASIS POINTS\n                </text>\n            </svg>\n        </div>\n    </section>\n    <!-- figures row -->\n    <div class=\"mx-auto max-w-[1280px] px-8 grid grid-cols-2 md:grid-cols-4 border-b hair divide-x divide-[#2A3439]/15\" data-kid=\"2-3\" data-name=\"stats row container\">\n        <div class=\"py-7 pr-6\" data-kid=\"2-3-1\" data-name=\"total bps stat container\">\n            <div class=\"f-mono text-[26px]\" data-kid=\"2-3-1-1\" data-name=\"total bps counter container\">\n                <span class=\"count\" data-dynamic=\"true\" data-fmt=\"1\" data-kid=\"2-3-1-1-1\" data-name=\"total bps count value\" data-reason=\"text counted up from 0 by script\" data-to=\"10000\">\n                    10,000\n                </span>\n            </div>\n            <div class=\"mt-1 eyebrow\" data-kid=\"2-3-1-2\" data-name=\"bps total label\">\n                bps total\n            </div>\n        </div>\n        <div class=\"py-7 px-6\" data-kid=\"2-3-2\" data-name=\"payees per pool stat container\">\n            <div class=\"f-mono text-[26px]\" data-kid=\"2-3-2-1\" data-name=\"payees per pool counter container\">\n                2–\n                <span class=\"count\" data-dynamic=\"true\" data-kid=\"2-3-2-1-1\" data-name=\"payees count value\" data-reason=\"text counted up from 0 by script\" data-to=\"20\">\n                    20\n                </span>\n            </div>\n            <div class=\"mt-1 eyebrow\" data-kid=\"2-3-2-2\" data-name=\"payees per pool label\">\n                payees per pool\n            </div>\n        </div>\n        <div class=\"py-7 px-6 border-t md:border-t-0 hair\" data-kid=\"2-3-3\" data-name=\"admin keys stat container\">\n            <div class=\"f-mono text-[26px]\" data-kid=\"2-3-3-1\" data-name=\"admin keys count\">\n                0\n            </div>\n            <div class=\"mt-1 eyebrow\" data-kid=\"2-3-3-2\" data-name=\"admin keys label\">\n                admin keys\n            </div>\n        </div>\n        <div class=\"py-7 px-6 border-t md:border-t-0 hair\" data-kid=\"2-3-4\" data-name=\"confirmation depth stat container\">\n            <div class=\"f-mono text-[26px]\" data-kid=\"2-3-4-1\" data-name=\"block confirmation counter container\">\n                <span class=\"count\" data-dynamic=\"true\" data-kid=\"2-3-4-1-1\" data-name=\"confirmation count value\" data-reason=\"text counted up from 0 by script\" data-to=\"5\">\n                    5\n                </span>\n            </div>\n            <div class=\"mt-1 eyebrow\" data-kid=\"2-3-4-2\" data-name=\"confirmation depth label\">\n                block confirmation depth\n            </div>\n        </div>\n    </div>\n    <!-- marquee -->\n    <div class=\"border-b hair overflow-hidden py-2.5 bg-[#E3DAC9]/20\" data-kid=\"2-4\" data-name=\"event marquee container\">\n        <div class=\"marq f-mono text-[10.5px] text-[#2A3439]/55 whitespace-nowrap\" data-kid=\"2-4-1\" data-name=\"marquee content wrapper\">\n            <span class=\"pr-10\" data-kid=\"2-4-1-1\" data-name=\"payment received event\">\n                PaymentReceived(address indexed from, address indexed token, uint256 amount)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-2\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span class=\"pr-10\" data-kid=\"2-4-1-3\" data-name=\"payment released event\">\n                PaymentReleased(address indexed to, address indexed token, uint256 amount)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-4\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span class=\"pr-10\" data-kid=\"2-4-1-5\" data-name=\"splitter created event\">\n                SplitterCreated(address indexed pool, address indexed creator, address[] payees, uint256[] shares, string name)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-6\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span class=\"pr-10\" data-kid=\"2-4-1-7\" data-name=\"payment received event\">\n                PaymentReceived(address indexed from, address indexed token, uint256 amount)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-8\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span class=\"pr-10\" data-kid=\"2-4-1-9\" data-name=\"payment released event\">\n                PaymentReleased(address indexed to, address indexed token, uint256 amount)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-10\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span class=\"pr-10\" data-kid=\"2-4-1-11\" data-name=\"splitter created event\">\n                SplitterCreated(address indexed pool, address indexed creator, address[] payees, uint256[] shares, string name)\n            </span>\n            <span class=\"pr-10 k\" data-kid=\"2-4-1-12\" data-name=\"separator dot\">\n                ·\n            </span>\n        </div>\n    </div>\n    <!-- 3. HOW IT WORKS -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24 pb-8\" data-kid=\"2-5\" data-name=\"how it works section\" id=\"how\">\n        <div class=\"grid grid-cols-12 items-end border-b hair pb-6\" data-kid=\"2-5-1\" data-name=\"section header container\">\n            <div class=\"col-span-12 md:col-span-8\" data-kid=\"2-5-1-1\" data-name=\"header title area\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-5-1-1-1\" data-name=\"mechanism section label\">\n                    Section 01 — Mechanism\n                </div>\n                <h2 class=\"reveal f-serif text-[40px] lg:text-[46px] leading-[1.1] mt-3\" data-kid=\"2-5-1-1-2\" data-name=\"section headline\">\n                    Create, fund,\n                    <em class=\"italic\" data-kid=\"2-5-1-1-2-1\" data-name=\"italic headline emphasize\">\n                        withdraw\n                    </em>\n                    .\n                </h2>\n            </div>\n            <p class=\"reveal col-span-12 md:col-span-4 text-[13.5px] leading-[1.7] text-[#2A3439]/70 mt-6 md:mt-0\" data-kid=\"2-5-1-2\" data-name=\"section summary description\">\n                Three transactions describe the whole protocol. Every deposit and withdrawal emits an event; the indexer reads those events and nothing else.\n            </p>\n        </div>\n        <div class=\"relative mt-14\" data-kid=\"2-5-2\" data-name=\"process timeline container\">\n            <div class=\"absolute left-1/2 top-0 bottom-0 w-px bg-[#2A3439]/15 hidden md:block\" data-kid=\"2-5-2-1\" data-name=\"vertical separator line\">\n            </div>\n            <div class=\"absolute left-1/2 top-0 w-px bg-[#0070BB] hidden md:block\" data-dynamic=\"true\" data-kid=\"2-5-2-2\" data-name=\"active progress indicator\" data-reason=\"height animated by scroll trigger\" id=\"tl-line\" style=\"height:0\">\n            </div>\n            <!-- step 1 -->\n            <div class=\"grid md:grid-cols-2 gap-0\" data-kid=\"2-5-2-3\" data-name=\"step 1 container\">\n                <div class=\"reveal md:pr-14 md:text-right\" data-kid=\"2-5-2-3-1\" data-name=\"step 1 text content\">\n                    <div class=\"f-mono text-[11px] k\" data-kid=\"2-5-2-3-1-1\" data-name=\"step number label\">\n                        STEP 01\n                    </div>\n                    <h3 class=\"f-serif text-[27px] mt-2\" data-kid=\"2-5-2-3-1-2\" data-name=\"step 1 title\">\n                        Create a pool\n                    </h3>\n                    <p class=\"mt-3 text-[14px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-5-2-3-1-3\" data-name=\"step 1 description\">\n                        The factory clones the implementation contract and calls\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-5-2-3-1-3-1\" data-name=\"initialize function name\">\n                            initialize()\n                        </span>\n                        in the same transaction. Payees and shares are validated once — 2 to 20 addresses, no duplicates, no zero address, shares summing to exactly 10,000 — then frozen forever.\n                    </p>\n                    <div class=\"mt-5 border hair p-4 f-mono text-[11.5px] leading-[1.85] md:text-left bg-[#F8F8FF]\" data-kid=\"2-5-2-3-1-4\" data-name=\"code snippet container\">\n                        <div data-kid=\"2-5-2-3-1-4-1\" data-name=\"create pool function call\">\n                            <span class=\"k\" data-kid=\"2-5-2-3-1-4-1-1\" data-name=\"function identifier\">\n                                createPool\n                            </span>\n                            (payees, shares, name)\n                        </div>\n                        <div class=\"cm\" data-kid=\"2-5-2-3-1-4-2\" data-name=\"event comment\">\n                            // → SplitterCreated(pool, creator, …)\n                        </div>\n                        <div data-kid=\"2-5-2-3-1-4-3\" data-name=\"variable assignment\">\n                            pool =\n                            <span class=\"k\" data-kid=\"2-5-2-3-1-4-3-1\" data-name=\"pool address\">\n                                0x7Ac9…3F41\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"2-5-2-3-2\" data-name=\"step 1 illustration placeholder\">\n                </div>\n            </div>\n            <!-- step 2 -->\n            <div class=\"grid md:grid-cols-2 gap-0 mt-14 md:-mt-16\" data-kid=\"2-5-2-4\" data-name=\"step 2 container\">\n                <div data-kid=\"2-5-2-4-1\" data-name=\"step 2 illustration placeholder\">\n                </div>\n                <div class=\"reveal md:pl-14\" data-kid=\"2-5-2-4-2\" data-name=\"step 2 text content\">\n                    <div class=\"f-mono text-[11px] k\" data-kid=\"2-5-2-4-2-1\" data-name=\"step number label\">\n                        STEP 02\n                    </div>\n                    <h3 class=\"f-serif text-[27px] mt-2\" data-kid=\"2-5-2-4-2-2\" data-name=\"step 2 title\">\n                        Fund it\n                    </h3>\n                    <p class=\"mt-3 text-[14px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-5-2-4-2-3\" data-name=\"step 2 description\">\n                        Anyone sends ETH to the pool address, or calls\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-5-2-4-2-3-1\" data-name=\"deposit function name\">\n                            depositERC20()\n                        </span>\n                        after an approve. Both paths increment\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-5-2-4-2-3-2\" data-name=\"state variable name\">\n                            totalReceived[token]\n                        </span>\n                        and emit\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-5-2-4-2-3-3\" data-name=\"event name\">\n                            PaymentReceived\n                        </span>\n                        .\n                    </p>\n                    <div class=\"mt-5 border hair p-4 f-mono text-[11.5px] leading-[1.85] bg-[#F8F8FF]\" data-kid=\"2-5-2-4-2-4\" data-name=\"code snippet container\">\n                        <div class=\"cm\" data-kid=\"2-5-2-4-2-4-1\" data-name=\"transaction comment\">\n                            // tx\n                        </div>\n                        <div class=\"k break-all\" data-kid=\"2-5-2-4-2-4-2\" data-name=\"tx hash\">\n                            0x8b41c7e0a9d3f52ab6c1…d90f\n                        </div>\n                        <div data-kid=\"2-5-2-4-2-4-3\" data-name=\"value details\">\n                            value\n                            <span class=\"k\" data-kid=\"2-5-2-4-2-4-3-1\" data-name=\"eth amount\">\n                                1.0000 ETH\n                            </span>\n                            · block 12,345,700\n                        </div>\n                        <div data-kid=\"2-5-2-4-2-4-4\" data-name=\"token details\">\n                            token\n                            <span class=\"k\" data-kid=\"2-5-2-4-2-4-4-1\" data-name=\"zero address\">\n                                address(0)\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- step 3 -->\n            <div class=\"grid md:grid-cols-2 gap-0 mt-14 md:-mt-12\" data-kid=\"2-5-2-5\" data-name=\"step 3 container\">\n                <div class=\"reveal md:pr-14 md:text-right\" data-kid=\"2-5-2-5-1\" data-name=\"step 3 text content\">\n                    <div class=\"f-mono text-[11px] k\" data-kid=\"2-5-2-5-1-1\" data-name=\"step number label\">\n                        STEP 03\n                    </div>\n                    <h3 class=\"f-serif text-[27px] mt-2\" data-kid=\"2-5-2-5-1-2\" data-name=\"step 3 title\">\n                        Withdraw\n                    </h3>\n                    <p class=\"mt-3 text-[14px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-5-2-5-1-3\" data-name=\"step 3 description\">\n                        Withdrawals are pull-based.\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-5-2-5-1-3-1\" data-name=\"release function name\">\n                            release(payee, token)\n                        </span>\n                        can be called by anyone on any payee's behalf; funds always go to the payee, never the caller.\n                    </p>\n                    <div class=\"mt-5 border hair p-4 f-mono text-[11.5px] leading-[1.85] md:text-left bg-[#F8F8FF]\" data-kid=\"2-5-2-5-1-4\" data-name=\"code snippet container\">\n                        <div data-kid=\"2-5-2-5-1-4-1\" data-name=\"release function call\">\n                            <span class=\"k\" data-kid=\"2-5-2-5-1-4-1-1\" data-name=\"function identifier\">\n                                release\n                            </span>\n                            (0x4f2a…9c1b, address(0))\n                        </div>\n                        <div class=\"cm\" data-kid=\"2-5-2-5-1-4-2\" data-name=\"comment\">\n                            // pays pendingPayment() then zeroes the delta\n                        </div>\n                        <div data-kid=\"2-5-2-5-1-4-3\" data-name=\"sent value details\">\n                            sent\n                            <span class=\"k\" data-kid=\"2-5-2-5-1-4-3-1\" data-name=\"eth amount\">\n                                0.4211 ETH\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"2-5-2-5-2\" data-name=\"step 3 illustration placeholder\">\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 4. TRUSTLESS GUARANTEES -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-6\" data-name=\"trustless guarantees section\" id=\"trustless\">\n        <div class=\"border-t hair pt-10 grid grid-cols-12 gap-10 items-start\" data-kid=\"2-6-1\" data-name=\"guarantee content layout\">\n            <div class=\"col-span-12 lg:col-span-5\" data-kid=\"2-6-1-1\" data-name=\"text column\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-6-1-1-1\" data-name=\"guarantee 01 section label\">\n                    Section 02 — Guarantee 01\n                </div>\n                <h2 class=\"reveal f-serif text-[42px] lg:text-[48px] leading-[1.06] mt-3\" data-kid=\"2-6-1-1-2\" data-name=\"section headline\">\n                    Zero custodians\n                </h2>\n                <p class=\"reveal mt-5 text-[15px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-6-1-1-3\" data-name=\"guarantee description\">\n                    The contract holds the balance and derives each entitlement from immutable state:\n                    <span class=\"f-mono text-[12.5px]\" data-kid=\"2-6-1-1-3-1\" data-name=\"shares state variable\">\n                        sharesOf[payee]\n                    </span>\n                    written at initialization, and\n                    <span class=\"f-mono text-[12.5px]\" data-kid=\"2-6-1-1-3-2\" data-name=\"received state variable\">\n                        totalReceived[token]\n                    </span>\n                    accumulated from deposits. There is no owner role, no withdrawal whitelist, and no upgrade path — so there is no address that could redirect funds even if it wanted to.\n                </p>\n                <p class=\"reveal mt-4 text-[15px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-6-1-1-4\" data-name=\"supplementary description\">\n                    Compare the two settlement paths. Toggle the diagram to remove the intermediary and the trust assumption disappears with it.\n                </p>\n            </div>\n            <div class=\"reveal col-span-12 lg:col-span-7 bg-[#E3DAC9]/35 rounded-2xl p-8 shadow-[0_2px_4px_rgba(0,0,0,0.05),0_8px_24px_rgba(0,0,0,0.05)]\" data-kid=\"2-6-1-2\" data-name=\"interactive diagram container\">\n                <div class=\"flex f-mono text-[11px] border hair w-fit bg-[#F8F8FF]\" data-kid=\"2-6-1-2-1\" data-name=\"diagram toggle buttons\">\n                    <button class=\"px-4 py-2 bg-[#2A3439] text-[#F8F8FF]\" data-kid=\"2-6-1-2-1-1\" data-name=\"intermediary path button\" id=\"pathA\">\n                        via intermediary\n                    </button>\n                    <button class=\"px-4 py-2 border-l hair\" data-kid=\"2-6-1-2-1-2\" data-name=\"paypool path button\" id=\"pathB\">\n                        via PayPool\n                    </button>\n                </div>\n                <div class=\"mt-7 border-y hair divide-y divide-[#2A3439]/15\" data-kid=\"2-6-1-2-2\" data-name=\"diagram row list\">\n                    <div class=\"flex items-center justify-between py-3.5 f-mono text-[11.5px]\" data-kid=\"2-6-1-2-2-1\" data-name=\"payer row\">\n                        <span data-kid=\"2-6-1-2-2-1-1\" data-name=\"payer role\">\n                            PAYER\n                        </span>\n                        <span class=\"text-[#2A3439]/55\" data-kid=\"2-6-1-2-2-1-2\" data-name=\"payer action\">\n                            sends 1.0000 ETH\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between py-3.5 f-mono text-[11.5px] bg-[#F8F8FF] px-3 -mx-3\" data-kid=\"2-6-1-2-2-2\" data-name=\"intermediary row\" id=\"midRow\">\n                        <span class=\"k\" data-kid=\"2-6-1-2-2-2-1\" data-name=\"intermediary name\">\n                            INTERMEDIARY\n                        </span>\n                        <span class=\"text-[#2A3439]/55\" data-kid=\"2-6-1-2-2-2-2\" data-name=\"intermediary details\">\n                            custody · fee · discretion\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between py-3.5 f-mono text-[11.5px] px-3 -mx-3\" data-kid=\"2-6-1-2-2-3\" data-name=\"pool row\" id=\"poolRow\" style=\"display:none\">\n                        <span class=\"k\" data-kid=\"2-6-1-2-2-3-1\" data-name=\"pool name\">\n                            PAYPOOL 0x7Ac9…3F41\n                        </span>\n                        <span class=\"text-[#2A3439]/55\" data-kid=\"2-6-1-2-2-3-2\" data-name=\"pool details\">\n                            no owner · pull-based\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between py-3.5 f-mono text-[11.5px]\" data-kid=\"2-6-1-2-2-4\" data-name=\"payees row\">\n                        <span data-kid=\"2-6-1-2-2-4-1\" data-name=\"payees role\">\n                            PAYEES ×4\n                        </span>\n                        <span class=\"text-[#2A3439]/55\" data-kid=\"2-6-1-2-2-4-2\" data-name=\"payees action\">\n                            receive 0.2500 ETH each\n                        </span>\n                    </div>\n                </div>\n                <p class=\"mt-4 f-mono text-[10.5px] text-[#2A3439]/60\" data-kid=\"2-6-1-2-3\" data-name=\"diagram caption text\" id=\"pathCap\">\n                    2 hops · custody at hop 1 · payout depends on policy\n                </p>\n            </div>\n        </div>\n        <div class=\"mt-14 border-t hair divide-y divide-[#2A3439]/15\" data-kid=\"2-6-2\" data-name=\"list of guarantees\">\n            <div class=\"reveal grid md:grid-cols-12 gap-4 py-5\" data-kid=\"2-6-2-1\" data-name=\"guarantee 02 entry\">\n                <div class=\"md:col-span-1 f-mono text-[11px] text-[#2A3439]/45\" data-kid=\"2-6-2-1-1\" data-name=\"number label\">\n                    02\n                </div>\n                <div class=\"md:col-span-3 f-mono text-[12.5px]\" data-kid=\"2-6-2-1-2\" data-name=\"title\">\n                    Immutable payee list\n                </div>\n                <div class=\"md:col-span-8 text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-6-2-1-3\" data-name=\"guarantee description\">\n                    After\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-6-2-1-3-1\" data-name=\"initialize function name\">\n                        initialize()\n                    </span>\n                    runs, the\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-6-2-1-3-2\" data-name=\"initialized boolean\">\n                        initialized\n                    </span>\n                    bool blocks any second call. Shares cannot be edited, added or reweighted — a trust-minimization decision, documented in PRODUCT.md.\n                </div>\n            </div>\n            <div class=\"reveal grid md:grid-cols-12 gap-4 py-5\" data-kid=\"2-6-2-2\" data-name=\"guarantee 03 entry\">\n                <div class=\"md:col-span-1 f-mono text-[11px] text-[#2A3439]/45\" data-kid=\"2-6-2-2-1\" data-name=\"number label\">\n                    03\n                </div>\n                <div class=\"md:col-span-3 f-mono text-[12.5px]\" data-kid=\"2-6-2-2-2\" data-name=\"title\">\n                    release() is permissionless\n                </div>\n                <div class=\"md:col-span-8 text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-6-2-2-3\" data-name=\"description\">\n                    Anyone may trigger a withdrawal for anyone. The recipient is always the payee argument, so a keeper or a bandmate can pay gas on behalf of a payee who has none.\n                </div>\n            </div>\n            <div class=\"reveal grid md:grid-cols-12 gap-4 py-5\" data-kid=\"2-6-2-3\" data-name=\"guarantee 04 entry\">\n                <div class=\"md:col-span-1 f-mono text-[11px] text-[#2A3439]/45\" data-kid=\"2-6-2-3-1\" data-name=\"number label\">\n                    04\n                </div>\n                <div class=\"md:col-span-3 f-mono text-[12.5px]\" data-kid=\"2-6-2-3-2\" data-name=\"title\">\n                    address(0) == ETH\n                </div>\n                <div class=\"md:col-span-8 text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-6-2-3-3\" data-name=\"description\">\n                    Native ETH and ERC-20s share one accounting path and one event schema, keyed by token address. Fewer branches in the contract, one code path in the indexer.\n                </div>\n            </div>\n            <div class=\"reveal grid md:grid-cols-12 gap-4 py-5\" data-kid=\"2-6-2-4\" data-name=\"guarantee 05 entry\">\n                <div class=\"md:col-span-1 f-mono text-[11px] text-[#2A3439]/45\" data-kid=\"2-6-2-4-1\" data-name=\"number label\">\n                    05\n                </div>\n                <div class=\"md:col-span-3 f-mono text-[12.5px]\" data-kid=\"2-6-2-4-2\" data-name=\"title\">\n                    No protocol fee in v1\n                </div>\n                <div class=\"md:col-span-8 text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-6-2-4-3\" data-name=\"description\">\n                    Nothing is skimmed on deposit or release. There is no fee recipient variable to set later without redeploying the implementation.\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 5. DASHBOARD -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-7\" data-name=\"dashboard section\" id=\"dashboard\">\n        <div class=\"border-t hair pt-10 flex flex-wrap items-end justify-between gap-6\" data-kid=\"2-7-1\" data-name=\"dashboard section header\">\n            <div data-kid=\"2-7-1-1\" data-name=\"section header title\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-7-1-1-1\" data-name=\"convenience layer label\">\n                    Section 03 — Convenience layer\n                </div>\n                <h2 class=\"reveal f-serif text-[40px] lg:text-[44px] leading-[1.08] mt-3\" data-kid=\"2-7-1-1-2\" data-name=\"section headline\">\n                    The dashboard reads events,\n                    <em class=\"italic\" data-kid=\"2-7-1-1-2-1\" data-name=\"italic headline emphasize\">\n                        not balances\n                    </em>\n                    .\n                </h2>\n            </div>\n            <p class=\"reveal max-w-[42ch] text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-7-1-2\" data-name=\"description\">\n                Every figure below is derived from indexed logs and can be reproduced from the chain by anyone. If the indexer disagrees with the contract, the contract wins.\n            </p>\n        </div>\n        <div class=\"reveal mt-10 bg-[#E3DAC9]/55 rounded-[28px] p-6 sm:p-10\" data-kid=\"2-7-2\" data-name=\"dashboard content area\">\n            <div class=\"bg-[#F8F8FF] rounded-2xl p-7 sm:p-9 shadow-[0_2px_4px_rgba(0,0,0,0.05),0_8px_24px_rgba(0,0,0,0.05)]\" data-kid=\"2-7-2-1\" data-name=\"pool card container\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 border-b hair pb-6\" data-kid=\"2-7-2-1-1\" data-name=\"pool card header\">\n                    <div data-kid=\"2-7-2-1-1-1\" data-name=\"pool header title\">\n                        <div class=\"eyebrow\" data-kid=\"2-7-2-1-1-1-1\" data-name=\"detail label\">\n                            Pool detail · GET /pools/0x7Ac9…3F41\n                        </div>\n                        <div class=\"f-serif text-[27px] mt-1.5\" data-kid=\"2-7-2-1-1-1-2\" data-name=\"pool name\">\n                            Band Royalties\n                        </div>\n                        <div class=\"f-mono text-[11px] k mt-1\" data-kid=\"2-7-2-1-1-1-3\" data-name=\"pool address\">\n                            0x7Ac9d1B48e6F02Ca7715bE39Db2c0A9E4d5c3F41\n                        </div>\n                    </div>\n                    <div class=\"flex gap-10 text-right\" data-kid=\"2-7-2-1-1-2\" data-name=\"pool stats container\">\n                        <div data-kid=\"2-7-2-1-1-2-1\" data-name=\"received stat\">\n                            <div class=\"f-mono text-[21px]\" data-kid=\"2-7-2-1-1-2-1-1\" data-name=\"received value\">\n                                5.0000\n                            </div>\n                            <div class=\"mt-1 eyebrow\" data-kid=\"2-7-2-1-1-2-1-2\" data-name=\"received label\">\n                                ETH received\n                            </div>\n                        </div>\n                        <div data-kid=\"2-7-2-1-1-2-2\" data-name=\"released stat\">\n                            <div class=\"f-mono text-[21px]\" data-kid=\"2-7-2-1-1-2-2-1\" data-name=\"released value\">\n                                3.8421\n                            </div>\n                            <div class=\"mt-1 eyebrow\" data-kid=\"2-7-2-1-1-2-2-2\" data-name=\"released label\">\n                                ETH released\n                            </div>\n                        </div>\n                        <div data-kid=\"2-7-2-1-1-2-3\" data-name=\"pending stat\">\n                            <div class=\"f-mono text-[21px]\" data-kid=\"2-7-2-1-1-2-3-1\" data-name=\"pending value\">\n                                1.1579\n                            </div>\n                            <div class=\"mt-1 eyebrow\" data-kid=\"2-7-2-1-1-2-3-2\" data-name=\"pending label\">\n                                ETH pending\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-12 gap-10 mt-8\" data-kid=\"2-7-2-1-2\" data-name=\"pool data area\">\n                    <div class=\"col-span-12 lg:col-span-7\" data-kid=\"2-7-2-1-2-1\" data-name=\"payees table container\">\n                        <table class=\"w-full text-left\" data-kid=\"2-7-2-1-2-1-1\" data-name=\"payees table\">\n                            <thead data-kid=\"2-7-2-1-2-1-1-1\" data-name=\"table header\">\n                                <tr class=\"eyebrow border-b hair\" data-kid=\"2-7-2-1-2-1-1-1-1\" data-name=\"table header row\">\n                                    <th class=\"pb-2 font-medium\" data-kid=\"2-7-2-1-2-1-1-1-1-1\" data-name=\"payee column header\">\n                                        Payee\n                                    </th>\n                                    <th class=\"pb-2 font-medium\" data-kid=\"2-7-2-1-2-1-1-1-1-2\" data-name=\"shares column header\">\n                                        Shares bps\n                                    </th>\n                                    <th class=\"pb-2 font-medium text-right\" data-kid=\"2-7-2-1-2-1-1-1-1-3\" data-name=\"pending column header\">\n                                        Pending\n                                    </th>\n                                    <th class=\"pb-2 font-medium text-right\" data-kid=\"2-7-2-1-2-1-1-1-1-4\" data-name=\"released column header\">\n                                        Released\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class=\"f-mono text-[12px] divide-y divide-[#2A3439]/10\" data-kid=\"2-7-2-1-2-1-1-2\" data-name=\"table body\">\n                                <tr data-kid=\"2-7-2-1-2-1-1-2-1\" data-name=\"row 1\">\n                                    <td class=\"py-3\" data-kid=\"2-7-2-1-2-1-1-2-1-1\" data-name=\"payee address\">\n                                        0x4f2a…9c1b\n                                    </td>\n                                    <td data-kid=\"2-7-2-1-2-1-1-2-1-2\" data-name=\"shares value\">\n                                        4000\n                                    </td>\n                                    <td class=\"text-right k\" data-kid=\"2-7-2-1-2-1-1-2-1-3\" data-name=\"pending value\">\n                                        0.4211\n                                    </td>\n                                    <td class=\"text-right\" data-kid=\"2-7-2-1-2-1-1-2-1-4\" data-name=\"released value\">\n                                        1.5789\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"2-7-2-1-2-1-1-2-2\" data-name=\"row 2\">\n                                    <td class=\"py-3\" data-kid=\"2-7-2-1-2-1-1-2-2-1\" data-name=\"payee address\">\n                                        0x9be1…04d7\n                                    </td>\n                                    <td data-kid=\"2-7-2-1-2-1-1-2-2-2\" data-name=\"shares value\">\n                                        2500\n                                    </td>\n                                    <td class=\"text-right k\" data-kid=\"2-7-2-1-2-1-1-2-2-3\" data-name=\"pending value\">\n                                        0.2632\n                                    </td>\n                                    <td class=\"text-right\" data-kid=\"2-7-2-1-2-1-1-2-2-4\" data-name=\"released value\">\n                                        0.9868\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"2-7-2-1-2-1-1-2-3\" data-name=\"row 3\">\n                                    <td class=\"py-3\" data-kid=\"2-7-2-1-2-1-1-2-3-1\" data-name=\"payee address\">\n                                        0x1d77…ae30\n                                    </td>\n                                    <td data-kid=\"2-7-2-1-2-1-1-2-3-2\" data-name=\"shares value\">\n                                        2000\n                                    </td>\n                                    <td class=\"text-right k\" data-kid=\"2-7-2-1-2-1-1-2-3-3\" data-name=\"pending value\">\n                                        0.3053\n                                    </td>\n                                    <td class=\"text-right\" data-kid=\"2-7-2-1-2-1-1-2-3-4\" data-name=\"released value\">\n                                        0.6947\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"2-7-2-1-2-1-1-2-4\" data-name=\"row 4\">\n                                    <td class=\"py-3\" data-kid=\"2-7-2-1-2-1-1-2-4-1\" data-name=\"payee address\">\n                                        0xc0ff…82ab\n                                    </td>\n                                    <td data-kid=\"2-7-2-1-2-1-1-2-4-2\" data-name=\"shares value\">\n                                        1500\n                                    </td>\n                                    <td class=\"text-right k\" data-kid=\"2-7-2-1-2-1-1-2-4-3\" data-name=\"pending value\">\n                                        0.1683\n                                    </td>\n                                    <td class=\"text-right\" data-kid=\"2-7-2-1-2-1-1-2-4-4\" data-name=\"released value\">\n                                        0.5817\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                        <div class=\"mt-6 flex items-center gap-2 f-mono text-[10.5px] text-[#2A3439]/60 border-t hair pt-3\" data-kid=\"2-7-2-1-2-1-2\" data-name=\"indexer status bar\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#0070BB]\" data-kid=\"2-7-2-1-2-1-2-1\" data-name=\"status dot\">\n                            </span>\n                            Indexer healthy · lag 12s · last_indexed_block 12,345,700 / head 12,345,705\n                        </div>\n                    </div>\n                    <div class=\"col-span-12 lg:col-span-5\" data-kid=\"2-7-2-1-2-2\" data-name=\"chart container\">\n                        <div class=\"eyebrow\" data-kid=\"2-7-2-1-2-2-1\" data-name=\"chart title\">\n                            Cumulative deposits by block · ETH\n                        </div>\n                        <div class=\"mt-3 h-[168px] relative\" data-kid=\"2-7-2-1-2-2-2\" data-name=\"canvas container\">\n                            <canvas data-dynamic=\"true\" data-kid=\"2-7-2-1-2-2-2-1\" data-name=\"line chart\" data-reason=\"rendered by chart.js library\" id=\"depChart\">\n                            </canvas>\n                        </div>\n                        <div class=\"mt-4 grid grid-cols-3 border-t hair pt-3 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-7-2-1-2-2-3\" data-name=\"chart stats container\">\n                            <div data-kid=\"2-7-2-1-2-2-3-1\" data-name=\"deposits stat\">\n                                <div class=\"text-[15px] text-[#2A3439]\" data-kid=\"2-7-2-1-2-2-3-1-1\" data-name=\"deposits value\">\n                                    9\n                                </div>\n                                <div class=\"eyebrow mt-0.5\" data-kid=\"2-7-2-1-2-2-3-1-2\" data-name=\"deposits label\">\n                                    deposits\n                                </div>\n                            </div>\n                            <div data-kid=\"2-7-2-1-2-2-3-2\" data-name=\"releases stat\">\n                                <div class=\"text-[15px] text-[#2A3439]\" data-kid=\"2-7-2-1-2-2-3-2-1\" data-name=\"releases value\">\n                                    7\n                                </div>\n                                <div class=\"eyebrow mt-0.5\" data-kid=\"2-7-2-1-2-2-3-2-2\" data-name=\"releases label\">\n                                    releases\n                                </div>\n                            </div>\n                            <div data-kid=\"2-7-2-1-2-2-3-3\" data-name=\"avg deposit stat\">\n                                <div class=\"text-[15px] text-[#2A3439]\" data-kid=\"2-7-2-1-2-2-3-3-1\" data-name=\"avg deposit value\">\n                                    0.5556\n                                </div>\n                                <div class=\"eyebrow mt-0.5\" data-kid=\"2-7-2-1-2-2-3-3-2\" data-name=\"avg deposit label\">\n                                    avg deposit\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 6. CONTRACT INTERFACE -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-8\" data-name=\"contract interface section\" id=\"contract\">\n        <div class=\"border-t hair pt-12 text-center\" data-kid=\"2-8-1\" data-name=\"contract header\">\n            <div class=\"eyebrow reveal\" data-kid=\"2-8-1-1\" data-name=\"source section label\">\n                Section 04 — Source\n            </div>\n            <h2 class=\"reveal f-serif text-[44px] lg:text-[52px] mt-3 tracking-tight\" data-kid=\"2-8-1-2\" data-name=\"contract filename\">\n                IPayPool.sol\n            </h2>\n            <div class=\"reveal f-mono text-[10.5px] text-[#2A3439]/55 mt-3\" data-kid=\"2-8-1-3\" data-name=\"contract metadata\">\n                SPDX-License-Identifier: MIT · pragma solidity ^0.8.24 · DESIGN.md §1.1\n            </div>\n        </div>\n        <div class=\"reveal mt-8 border-t-2 border-[#2A3439]/70\" data-kid=\"2-8-2\" data-name=\"hr decoration\">\n        </div>\n        <div class=\"border-b hair\" data-kid=\"2-8-3\" data-name=\"hr decoration\">\n        </div>\n        <div class=\"reveal mt-10 grid md:grid-cols-2 gap-x-12 gap-y-8 f-mono text-[12px] leading-[2]\" data-kid=\"2-8-4\" data-name=\"interface code grid\">\n            <div class=\"md:border-r hair md:pr-12\" data-kid=\"2-8-4-1\" data-name=\"events and init column\">\n                <div class=\"eyebrow mb-3\" data-kid=\"2-8-4-1-1\" data-name=\"column title\">\n                    Events & initialization\n                </div>\n                <pre class=\"whitespace-pre-wrap\" data-kid=\"2-8-4-1-2\" data-name=\"code block\"><span class=\"cm\" data-kid=\"2-8-4-1-2-1\" data-name=\"interface keyword\">interface</span> <span class=\"k\" data-kid=\"2-8-4-1-2-2\" data-name=\"interface name\">IPayPool</span> {\n  <span class=\"k\" data-kid=\"2-8-4-1-2-3\" data-name=\"event 1\">event</span> PaymentReceived(\n    address indexed from,\n    address indexed token,\n    uint256 amount);\n\n  <span class=\"k\" data-kid=\"2-8-4-1-2-4\" data-name=\"event 2\">event</span> PaymentReleased(\n    address indexed to,\n    address indexed token,\n    uint256 amount);\n\n  <span class=\"k\" data-kid=\"2-8-4-1-2-5\" data-name=\"init function\">function</span> initialize(\n    address[] calldata payees,\n    uint256[] calldata shares) external;\n\n  <span class=\"k\" data-kid=\"2-8-4-1-2-6\" data-name=\"receive function\">receive</span>() external payable;\n  <span class=\"k\" data-kid=\"2-8-4-1-2-7\" data-name=\"deposit function\">function</span> depositERC20(\n    address token, uint256 amount) external;</pre>\n            </div>\n            <div data-kid=\"2-8-4-2\" data-name=\"release and views column\">\n                <div class=\"eyebrow mb-3\" data-kid=\"2-8-4-2-1\" data-name=\"column title\">\n                    Release & views\n                </div>\n                <pre class=\"whitespace-pre-wrap\" data-kid=\"2-8-4-2-2\" data-name=\"code block\">  <span class=\"k\" data-kid=\"2-8-4-2-2-1\" data-name=\"release function\">function</span> release(\n    address payee, address token) external;\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-2\" data-name=\"pending payment view\">function</span> pendingPayment(address payee,\n    address token) external view\n    returns (uint256);\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-3\" data-name=\"total received view\">function</span> totalReceived(address token)\n    external view returns (uint256);\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-4\" data-name=\"total released view\">function</span> totalReleased(address token)\n    external view returns (uint256);\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-5\" data-name=\"get payees view\">function</span> getPayees() external view\n    returns (address[] memory);\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-6\" data-name=\"get shares view\">function</span> getShares() external view\n    returns (uint256[] memory);\n\n  <span class=\"k\" data-kid=\"2-8-4-2-2-7\" data-name=\"total shares view\">function</span> totalShares() external view\n    returns (uint256);\n}</pre>\n            </div>\n        </div>\n        <div class=\"reveal mt-12 border-y hair py-10 text-center bg-[#E3DAC9]/25\" data-kid=\"2-8-5\" data-name=\"payout formula box\">\n            <div class=\"eyebrow\" data-kid=\"2-8-5-1\" data-name=\"label\">\n                Payout formula\n            </div>\n            <div class=\"f-mono text-[15px] sm:text-[19px] mt-4 tracking-tight\" data-kid=\"2-8-5-2\" data-name=\"formula expression\">\n                pending = (\n                <span class=\"k\" data-kid=\"2-8-5-2-1\" data-name=\"received var\">\n                    totalReceived\n                </span>\n                *\n                <span class=\"k\" data-kid=\"2-8-5-2-2\" data-name=\"shares var\">\n                    shares\n                </span>\n                /\n                <span class=\"k\" data-kid=\"2-8-5-2-3\" data-name=\"total var\">\n                    totalShares\n                </span>\n                ) −\n                <span class=\"k\" data-kid=\"2-8-5-2-4\" data-name=\"released var\">\n                    released\n                </span>\n            </div>\n            <div class=\"f-mono text-[10.5px] text-[#2A3439]/55 mt-4\" data-kid=\"2-8-5-3\" data-name=\"formula explanation\">\n                evaluated per (payee, token) pair at call time — no snapshots, no rounding carry\n            </div>\n        </div>\n        <div class=\"reveal mt-10 grid md:grid-cols-2 gap-10 border-b hair pb-12\" data-kid=\"2-8-6\" data-name=\"asides grid\">\n            <div class=\"md:pr-10 md:border-r hair\" data-kid=\"2-8-6-1\" data-name=\"aside 1\">\n                <div class=\"eyebrow\" data-kid=\"2-8-6-1-1\" data-name=\"aside title\">\n                    Aside — the address(0) convention\n                </div>\n                <p class=\"mt-3 text-[13.5px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-8-6-1-2\" data-name=\"aside text\">\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-8-6-1-2-1\" data-name=\"address zero constant\">\n                        address(0)\n                    </span>\n                    represents native ETH everywhere: in mappings, in events, in the REST payloads. ETH and ERC-20 deposits therefore share a single accounting path, and the indexer's\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-8-6-1-2-2\" data-name=\"indexer process function\">\n                        process_event\n                    </span>\n                    never branches on asset type.\n                </p>\n            </div>\n            <div data-kid=\"2-8-6-2\" data-name=\"aside 2\">\n                <div class=\"eyebrow\" data-kid=\"2-8-6-2-1\" data-name=\"aside title\">\n                    Aside — TOTAL_SHARE_UNITS\n                </div>\n                <p class=\"mt-3 text-[13.5px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-8-6-2-2\" data-name=\"aside text\">\n                    Shares are basis points out of a fixed\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-8-6-2-2-1\" data-name=\"share constant\">\n                        TOTAL_SHARE_UNITS = 10_000\n                    </span>\n                    . The sum is asserted at initialization, so a pool can never be deployed that under- or over-allocates its income.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- 7. ARCHITECTURE -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-9\" data-name=\"architecture section\" id=\"stack\">\n        <div class=\"grid grid-cols-12 border-y hair\" data-kid=\"2-9-1\" data-name=\"architecture header grid\">\n            <div class=\"col-span-12 md:col-span-4 md:border-r hair py-10 md:pr-8\" data-kid=\"2-9-1-1\" data-name=\"header title column\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-9-1-1-1\" data-name=\"section label\">\n                    Section 05 — System\n                </div>\n                <h2 class=\"reveal f-serif text-[38px] leading-[1.1] mt-3\" data-kid=\"2-9-1-1-2\" data-name=\"headline\">\n                    Architecture\n                    <em class=\"italic\" data-kid=\"2-9-1-1-2-1\" data-name=\"italic headline emphasize\">\n                        &\n                    </em>\n                    stack\n                </h2>\n            </div>\n            <div class=\"col-span-12 md:col-span-8 py-10 md:pl-8 border-t md:border-t-0 hair\" data-kid=\"2-9-1-2\" data-name=\"header description column\">\n                <p class=\"reveal text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[62ch]\" data-kid=\"2-9-1-2-1\" data-name=\"description text\">\n                    Four layers, one direction of data flow. The chain is the source of truth; everything downstream is a cache that can be rebuilt from block zero of the factory.\n                </p>\n                <div class=\"reveal mt-6 f-mono text-[11.5px] flex flex-wrap items-center gap-x-3 gap-y-2 text-[#2A3439]/75\" data-kid=\"2-9-1-2-2\" data-name=\"stack flow diagram\">\n                    <span data-kid=\"2-9-1-2-2-1\" data-name=\"step 1\">\n                        chain logs\n                    </span>\n                    <span class=\"k\" data-kid=\"2-9-1-2-2-2\" data-name=\"arrow\">\n                        →\n                    </span>\n                    <span data-kid=\"2-9-1-2-2-3\" data-name=\"step 2\">\n                        eth_getLogs backfill\n                    </span>\n                    <span class=\"k\" data-kid=\"2-9-1-2-2-4\" data-name=\"arrow\">\n                        →\n                    </span>\n                    <span data-kid=\"2-9-1-2-2-5\" data-name=\"step 3\">\n                        Postgres\n                    </span>\n                    <span class=\"k\" data-kid=\"2-9-1-2-2-6\" data-name=\"arrow\">\n                        →\n                    </span>\n                    <span data-kid=\"2-9-1-2-2-7\" data-name=\"step 4\">\n                        REST\n                    </span>\n                    <span class=\"k\" data-kid=\"2-9-1-2-2-8\" data-name=\"arrow\">\n                        →\n                    </span>\n                    <span data-kid=\"2-9-1-2-2-9\" data-name=\"step 5\">\n                        dashboard\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid md:grid-cols-4 border-b hair divide-y md:divide-y-0 md:divide-x divide-[#2A3439]/15\" data-kid=\"2-9-2\" data-name=\"layers grid\">\n            <div class=\"reveal py-9 md:pr-7\" data-kid=\"2-9-2-1\" data-name=\"layer 1 content\">\n                <div class=\"f-mono text-[10.5px] k\" data-kid=\"2-9-2-1-1\" data-name=\"layer label\">\n                    L1\n                </div>\n                <div class=\"f-serif text-[22px] mt-2\" data-kid=\"2-9-2-1-2\" data-name=\"layer title\">\n                    Contracts\n                </div>\n                <div class=\"mt-4 space-y-1.5 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-9-2-1-3\" data-name=\"layer tech list\">\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-1-3-1\" data-name=\"tech item 1\">\n                        Solidity 0.8.24\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-1-3-2\" data-name=\"tech item 2\">\n                        Foundry · forge test\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-1-3-3\" data-name=\"tech item 3\">\n                        OpenZeppelin Clones\n                    </div>\n                </div>\n                <p class=\"mt-4 text-[12.5px] leading-[1.7] text-[#2A3439]/65\" data-kid=\"2-9-2-1-4\" data-name=\"description\">\n                    Clones.clone(implementation) — sequential CREATE, not CREATE2.\n                </p>\n            </div>\n            <div class=\"reveal py-9 md:px-7\" data-kid=\"2-9-2-2\" data-name=\"layer 2 content\">\n                <div class=\"f-mono text-[10.5px] k\" data-kid=\"2-9-2-2-1\" data-name=\"layer label\">\n                    L2\n                </div>\n                <div class=\"f-serif text-[22px] mt-2\" data-kid=\"2-9-2-2-2\" data-name=\"layer title\">\n                    Indexer\n                </div>\n                <div class=\"mt-4 space-y-1.5 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-9-2-2-3\" data-name=\"layer tech list\">\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-2-3-1\" data-name=\"tech item 1\">\n                        Python · FastAPI · ARQ\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-2-3-2\" data-name=\"tech item 2\">\n                        CONFIRMATION_DEPTH=5\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-2-3-3\" data-name=\"tech item 3\">\n                        BATCH_SIZE=2000\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-2-3-4\" data-name=\"tech item 4\">\n                        POLL_INTERVAL=15s\n                    </div>\n                </div>\n                <p class=\"mt-4 text-[12.5px] leading-[1.7] text-[#2A3439]/65\" data-kid=\"2-9-2-2-4\" data-name=\"description\">\n                    Backfills to head minus depth, then polls forever from indexer_state.\n                </p>\n            </div>\n            <div class=\"reveal py-9 md:px-7\" data-kid=\"2-9-2-3\" data-name=\"layer 3 content\">\n                <div class=\"f-mono text-[10.5px] k\" data-kid=\"2-9-2-3-1\" data-name=\"layer label\">\n                    L3\n                </div>\n                <div class=\"f-serif text-[22px] mt-2\" data-kid=\"2-9-2-3-2\" data-name=\"layer title\">\n                    Database\n                </div>\n                <div class=\"mt-4 space-y-1.5 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-9-2-3-3\" data-name=\"layer tech list\">\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-3-3-1\" data-name=\"tech item 1\">\n                        PostgreSQL\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-3-3-2\" data-name=\"tech item 2\">\n                        UNIQUE (tx_hash, log_index)\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-3-3-3\" data-name=\"tech item 3\">\n                        ON CONFLICT DO NOTHING\n                    </div>\n                </div>\n                <p class=\"mt-4 text-[12.5px] leading-[1.7] text-[#2A3439]/65\" data-kid=\"2-9-2-3-4\" data-name=\"description\">\n                    Idempotent writes make the backfill loop safe to re-run from any block.\n                </p>\n            </div>\n            <div class=\"reveal py-9 md:pl-7\" data-kid=\"2-9-2-4\" data-name=\"layer 4 content\">\n                <div class=\"f-mono text-[10.5px] k\" data-kid=\"2-9-2-4-1\" data-name=\"layer label\">\n                    L4\n                </div>\n                <div class=\"f-serif text-[22px] mt-2\" data-kid=\"2-9-2-4-2\" data-name=\"layer title\">\n                    Frontend\n                </div>\n                <div class=\"mt-4 space-y-1.5 f-mono text-[11px] text-[#2A3439]/70\" data-kid=\"2-9-2-4-3\" data-name=\"layer tech list\">\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-4-3-1\" data-name=\"tech item 1\">\n                        React · Vite\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-4-3-2\" data-name=\"tech item 2\">\n                        viem / wagmi\n                    </div>\n                    <div class=\"border-t hair pt-1.5\" data-kid=\"2-9-2-4-3-3\" data-name=\"tech item 3\">\n                        VITE_CHAIN_ID=84532\n                    </div>\n                </div>\n                <p class=\"mt-4 text-[12.5px] leading-[1.7] text-[#2A3439]/65\" data-kid=\"2-9-2-4-4\" data-name=\"description\">\n                    Reads the REST cache; writes go straight to the contract from the wallet.\n                </p>\n            </div>\n        </div>\n        <div class=\"grid md:grid-cols-4 border-b hair divide-y md:divide-y-0 md:divide-x divide-[#2A3439]/15 f-mono text-[11.5px]\" data-kid=\"2-9-3\" data-name=\"api endpoints grid\">\n            <div class=\"reveal py-4 md:pr-7 flex justify-between\" data-kid=\"2-9-3-1\" data-name=\"endpoint 1 container\">\n                <span data-kid=\"2-9-3-1-1\" data-name=\"endpoint path\">\n                    GET /pools\n                </span>\n                <span class=\"text-[#2A3439]/45\" data-kid=\"2-9-3-1-2\" data-name=\"endpoint description\">\n                    list\n                </span>\n            </div>\n            <div class=\"reveal py-4 md:px-7 flex justify-between\" data-kid=\"2-9-3-2\" data-name=\"endpoint 2 container\">\n                <span data-kid=\"2-9-3-2-1\" data-name=\"endpoint path\">\n                    GET /pools/{address}\n                </span>\n                <span class=\"text-[#2A3439]/45\" data-kid=\"2-9-3-2-2\" data-name=\"endpoint description\">\n                    detail\n                </span>\n            </div>\n            <div class=\"reveal py-4 md:px-7 flex justify-between\" data-kid=\"2-9-3-3\" data-name=\"endpoint 3 container\">\n                <span data-kid=\"2-9-3-3-1\" data-name=\"endpoint path\">\n                    GET /payees/{address}/earnings\n                </span>\n                <span class=\"text-[#2A3439]/45\" data-kid=\"2-9-3-3-2\" data-name=\"endpoint description\">\n                    aggregate\n                </span>\n            </div>\n            <div class=\"reveal py-4 md:pl-7 flex justify-between\" data-kid=\"2-9-3-4\" data-name=\"endpoint 4 container\">\n                <span data-kid=\"2-9-3-4-1\" data-name=\"endpoint path\">\n                    GET /health\n                </span>\n                <span class=\"k\" data-kid=\"2-9-3-4-2\" data-name=\"endpoint description\">\n                    healthy\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- 8. USE CASES -->\n    <section class=\"pt-24\" data-kid=\"2-10\" data-name=\"use cases section\">\n        <div class=\"mx-auto max-w-[1280px] px-8\" data-kid=\"2-10-1\" data-name=\"section header\">\n            <div class=\"eyebrow reveal\" data-kid=\"2-10-1-1\" data-name=\"section label\">\n                Section 06 — In the field\n            </div>\n            <h2 class=\"reveal f-serif text-[40px] lg:text-[46px] leading-[1.08] mt-3 max-w-[26ch]\" data-kid=\"2-10-1-2\" data-name=\"headline\">\n                Three pools, three\n                <em class=\"italic\" data-kid=\"2-10-1-2-1\" data-name=\"italic headline emphasize\">\n                    shapes\n                </em>\n                of income.\n            </h2>\n        </div>\n        <div class=\"mt-12 grid md:grid-cols-2 border-y hair\" data-kid=\"2-10-2\" data-name=\"use case 1 container\">\n            <div class=\"relative bg-[#E3DAC9]/40\" data-kid=\"2-10-2-1\" data-name=\"use case 1 image\">\n                <img alt=\"Abstract geometric composition representing royalty distribution\" class=\"w-full h-full object-cover min-h-[420px]\" data-kid=\"2-10-2-1-1\" data-name=\"image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/32d0d35c0575417b9087a7ee4321889f.jpg\"/>\n                <div class=\"absolute bottom-0 left-0 right-0 bg-[#F8F8FF]/90 px-6 py-2.5 f-mono text-[10px] text-[#2A3439]/65\" data-kid=\"2-10-2-1-2\" data-name=\"image caption\">\n                    PLATE I — Four equal shares of 2500 bps, one immutable pool\n                </div>\n            </div>\n            <div class=\"p-8 md:p-14 flex flex-col justify-center md:border-l hair\" data-kid=\"2-10-2-2\" data-name=\"use case 1 text\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-10-2-2-1\" data-name=\"label\">\n                    Use case — Royalties\n                </div>\n                <h3 class=\"reveal f-serif text-[34px] leading-[1.1] mt-3\" data-kid=\"2-10-2-2-2\" data-name=\"headline\">\n                    A four-piece band\n                    <em class=\"italic\" data-kid=\"2-10-2-2-2-1\" data-name=\"italic headline emphasize\">\n                        stops\n                    </em>\n                    nominating a treasurer.\n                </h3>\n                <p class=\"reveal mt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75\" data-kid=\"2-10-2-2-3\" data-name=\"description\">\n                    Streaming and sync income lands at one address. Each of the four members holds 2500 bps, and the split is visible in the pool before any money arrives — so nobody has to trust the person whose bank account it used to pass through. When a payment clears, any member can call\n                    <span class=\"f-mono text-[12.5px]\" data-kid=\"2-10-2-2-3-1\" data-name=\"release function name\">\n                        release()\n                    </span>\n                    for the whole group.\n                </p>\n                <div class=\"reveal mt-7 f-mono text-[11px] text-[#2A3439]/60 border-t hair pt-3 flex justify-between\" data-kid=\"2-10-2-2-4\" data-name=\"footer metadata\">\n                    <span data-kid=\"2-10-2-2-4-1\" data-name=\"bps values\">\n                        2500 · 2500 · 2500 · 2500 bps\n                    </span>\n                    <span data-kid=\"2-10-2-2-4-2\" data-name=\"issue reference\">\n                        ISSUE 01 / PAGE 08\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto max-w-[1280px] px-8 grid md:grid-cols-2 gap-12 py-12 border-b hair\" data-kid=\"2-10-3\" data-name=\"use case 2-3 container\">\n            <div class=\"reveal md:pr-10 md:border-r hair\" data-kid=\"2-10-3-1\" data-name=\"use case 2 content\">\n                <div class=\"eyebrow\" data-kid=\"2-10-3-1-1\" data-name=\"label\">\n                    Use case — Grant disbursement\n                </div>\n                <h3 class=\"f-serif text-[26px] leading-[1.15] mt-2.5\" data-kid=\"2-10-3-1-2\" data-name=\"headline\">\n                    A funder deposits once; recipients draw down on their own schedule.\n                </h3>\n                <p class=\"mt-4 text-[14px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-10-3-1-3\" data-name=\"description\">\n                    A grants committee deploys a pool weighted 4000 / 2500 / 2000 / 1500 across four workstreams and funds it in a single transaction. Because withdrawals are pull-based, no recipient can be paid late by an administrator forgetting to send a transfer — and the funder can audit the drawdown from\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-10-3-1-3-1\" data-name=\"endpoint\">\n                        /pools/{address}/withdrawals\n                    </span>\n                    .\n                </p>\n                <div class=\"mt-5 f-mono text-[10.5px] text-[#2A3439]/60\" data-kid=\"2-10-3-1-4\" data-name=\"page number\">\n                    PAGE 09\n                </div>\n            </div>\n            <div class=\"reveal\" data-kid=\"2-10-3-2\" data-name=\"use case 3 content\">\n                <div class=\"eyebrow\" data-kid=\"2-10-3-2-1\" data-name=\"label\">\n                    Use case — OSS contributor payouts\n                </div>\n                <h3 class=\"f-serif text-[26px] leading-[1.15] mt-2.5\" data-kid=\"2-10-3-2-2\" data-name=\"headline\">\n                    Sponsorship income routed to the people who shipped the release.\n                </h3>\n                <p class=\"mt-4 text-[14px] leading-[1.75] text-[#2A3439]/75\" data-kid=\"2-10-3-2-3\" data-name=\"description\">\n                    A maintainer group of nine deploys one pool per major version, so each release's weighting is a permanent record rather than a spreadsheet edit. Contributors check\n                    <span class=\"f-mono text-[12px]\" data-kid=\"2-10-3-2-3-1\" data-name=\"endpoint\">\n                        /payees/{address}/earnings\n                    </span>\n                    to see pending amounts across every pool they appear in, without touching a block explorer.\n                </p>\n                <div class=\"mt-5 f-mono text-[10.5px] text-[#2A3439]/60\" data-kid=\"2-10-3-2-4\" data-name=\"page number\">\n                    PAGE 10\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 9. SECURITY -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-11\" data-name=\"security model section\" id=\"security\">\n        <div class=\"eyebrow reveal\" data-kid=\"2-11-1\" data-name=\"section label\">\n            Section 07 — Security model\n        </div>\n        <h2 class=\"reveal f-serif text-[40px] lg:text-[46px] leading-[1.08] mt-3\" data-kid=\"2-11-2\" data-name=\"headline\">\n            What is\n            <em class=\"italic\" data-kid=\"2-11-2-1\" data-name=\"italic headline emphasize\">\n                proven\n            </em>\n            , and what is merely tested.\n        </h2>\n        <div class=\"mt-12 grid grid-cols-12 gap-10\" data-kid=\"2-11-3\" data-name=\"security analysis grid\">\n            <div class=\"col-span-12 lg:col-span-7\" data-kid=\"2-11-3-1\" data-name=\"text column\">\n                <div class=\"space-y-7 text-[15px] leading-[1.85] text-[#2A3439]/80\" data-kid=\"2-11-3-1-1\" data-name=\"paragraphs container\">\n                    <p class=\"reveal prose-p\" data-kid=\"2-11-3-1-1-1\" data-name=\"paragraph 1\" data-note=\"n1\">\n                        The attack surface is deliberately small. A pool has one write path that changes allocation —\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-11-3-1-1-1-1\" data-name=\"initialize function name\">\n                            initialize()\n                        </span>\n                        — and it runs exactly once, inside the same transaction as the clone. Every constraint on payees and shares is asserted there: matching array lengths, a payee count between 2 and 20, no zero address, no duplicates, and a share sum of exactly 10,000.\n                    </p>\n                    <p class=\"reveal prose-p\" data-kid=\"2-11-3-1-1-2\" data-name=\"paragraph 2\" data-note=\"n2\">\n                        Double-payment is prevented arithmetically rather than by a flag.\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-11-3-1-1-2-1\" data-name=\"release function name\">\n                            release()\n                        </span>\n                        computes the delta between what a payee is entitled to and what has already been sent, then transfers that delta and adds it to\n                        <span class=\"f-mono text-[12.5px]\" data-kid=\"2-11-3-1-1-2-2\" data-name=\"released state variable\">\n                            released[token][payee]\n                        </span>\n                        . Calling it twice in a row is harmless: the second call computes zero.\n                    </p>\n                    <p class=\"reveal prose-p\" data-kid=\"2-11-3-1-1-3\" data-name=\"paragraph 3\" data-note=\"n3\">\n                        Conservation of funds is the one property fuzzed as an invariant, across randomized sequences of deposits and releases in any order, with any number of payees. It is the property that would have to break for anyone to lose money.\n                    </p>\n                    <p class=\"reveal prose-p\" data-kid=\"2-11-3-1-1-4\" data-name=\"paragraph 4\" data-note=\"n4\">\n                        Re-initialization is blocked by the standard clone-init guard, so a freshly cloned pool cannot be hijacked between deployment and first use — the factory clones and initializes atomically, and any later attempt reverts.\n                    </p>\n                    <p class=\"reveal prose-p\" data-kid=\"2-11-3-1-1-5\" data-name=\"paragraph 5\" data-note=\"n5\">\n                        Gas is measured, not assumed: the clone path is benchmarked against a full deployment so the cost claim in PRODUCT.md is a number in a test report rather than a marketing line.\n                    </p>\n                    <p class=\"reveal\" data-kid=\"2-11-3-1-1-6\" data-name=\"paragraph 6\">\n                        Out of scope by design: the dashboard and indexer are unaudited convenience layers. They can be wrong, stale or offline without any effect on custody, because they never hold keys or funds.\n                    </p>\n                </div>\n                <div class=\"reveal mt-10 border-y hair py-8 text-center bg-[#E3DAC9]/25\" data-kid=\"2-11-3-1-2\" data-name=\"invariant box\">\n                    <div class=\"eyebrow\" data-kid=\"2-11-3-1-2-1\" data-name=\"label\">\n                        Invariant\n                    </div>\n                    <div class=\"f-mono text-[14px] sm:text-[17px] mt-3\" data-kid=\"2-11-3-1-2-2\" data-name=\"formula\">\n                        totalReceived == totalReleased + sum(pending)\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-span-12 lg:col-span-5 lg:pl-6 lg:border-l hair space-y-5\" data-kid=\"2-11-3-2\" data-name=\"test list column\">\n                <div class=\"eyebrow\" data-kid=\"2-11-3-2-1\" data-name=\"label\">\n                    Margin — test table, DESIGN.md §5\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-2\" data-name=\"test 1\" id=\"n1\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#0070BB]\" data-kid=\"2-11-3-2-2-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px] k\" data-kid=\"2-11-3-2-2-2\" data-name=\"test name\">\n                        test_initialize_validates_shares\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-2-3\" data-name=\"test description\">\n                        unit — reverts if shares don't sum to 10,000\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-3\" data-name=\"test 2\" id=\"n2\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#0070BB]\" data-kid=\"2-11-3-2-3-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px] k\" data-kid=\"2-11-3-2-3-2\" data-name=\"test name\">\n                        test_release_twice_second_call_pays_zero_delta\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-3-3\" data-name=\"test description\">\n                        unit — no double-payment\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-4\" data-name=\"test 3\" id=\"n3\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#0070BB]\" data-kid=\"2-11-3-2-4-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px] k\" data-kid=\"2-11-3-2-4-2\" data-name=\"test name\">\n                        invariant_conservation_of_funds\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-4-3\" data-name=\"test description\">\n                        fuzz/invariant — holds across randomized deposit/release sequences\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-5\" data-name=\"test 4\" id=\"n4\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#0070BB]\" data-kid=\"2-11-3-2-5-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px] k\" data-kid=\"2-11-3-2-5-2\" data-name=\"test name\">\n                        test_cannot_reinitialize\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-5-3\" data-name=\"test description\">\n                        unit — second initialize() call reverts\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-6\" data-name=\"test 5\" id=\"n5\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#0070BB]\" data-kid=\"2-11-3-2-6-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px] k\" data-kid=\"2-11-3-2-6-2\" data-name=\"test name\">\n                        test_gas_clone_vs_full_deploy\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-6-3\" data-name=\"test description\">\n                        benchmark — clone deploy gas documented and compared\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-7\" data-name=\"test 6\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#2A3439]/30\" data-kid=\"2-11-3-2-7-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px]\" data-kid=\"2-11-3-2-7-2\" data-name=\"test name\">\n                        test_initialize_rejects_duplicate_payee\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-7-3\" data-name=\"test description\">\n                        unit — reverts on duplicate address\n                    </div>\n                </div>\n                <div class=\"reveal relative pl-6\" data-kid=\"2-11-3-2-8\" data-name=\"test 7\">\n                    <span class=\"leader absolute left-0 top-3 w-4 h-px bg-[#2A3439]/30\" data-kid=\"2-11-3-2-8-1\" data-name=\"leader line\">\n                    </span>\n                    <div class=\"f-mono text-[11.5px]\" data-kid=\"2-11-3-2-8-2\" data-name=\"test name\">\n                        test_deposit_eth_updates_totalReceived\n                    </div>\n                    <div class=\"mt-1 text-[12.5px] text-[#2A3439]/70\" data-kid=\"2-11-3-2-8-3\" data-name=\"test description\">\n                        unit — totalReceived(address(0)) increases by amount\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 10. FAQ -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-24\" data-kid=\"2-12\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"border-t hair pt-10 grid grid-cols-12 gap-10\" data-kid=\"2-12-1\" data-name=\"faq section container\">\n            <div class=\"col-span-12 lg:col-span-3\" data-kid=\"2-12-1-1\" data-name=\"sidebar container\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-12-1-1-1\" data-name=\"section label\">\n                    Section 08 — Questions\n                </div>\n                <p class=\"reveal mt-4 text-[13.5px] leading-[1.7] text-[#2A3439]/70\" data-kid=\"2-12-1-1-2\" data-name=\"faq summary\">\n                    The most common questions are about things PayPool deliberately does not do. Each was a decision, and each is documented.\n                </p>\n                <div class=\"reveal f-mono text-[10.5px] text-[#2A3439]/50 mt-6\" data-kid=\"2-12-1-1-3\" data-name=\"faq count label\">\n                    05 QUESTIONS\n                </div>\n            </div>\n            <div class=\"col-span-12 lg:col-span-9 divide-y divide-[#2A3439]/15 border-t hair\" data-kid=\"2-12-1-2\" data-name=\"faq questions list\">\n                <div class=\"faq py-7\" data-kid=\"2-12-1-2-1\" data-name=\"faq item 1\">\n                    <div class=\"faq-q flex items-start justify-between gap-8\" data-kid=\"2-12-1-2-1-1\" data-name=\"faq question header\">\n                        <h3 class=\"f-serif italic text-[27px] leading-[1.2]\" data-kid=\"2-12-1-2-1-1-1\" data-name=\"question text\">\n                            Can I change the shares after deploying?\n                        </h3>\n                        <span class=\"faq-ico f-mono text-[18px] text-[#0070BB] shrink-0 leading-none pt-1.5\" data-kid=\"2-12-1-2-1-1-2\" data-name=\"toggle icon\">\n                            +\n                        </span>\n                    </div>\n                    <div class=\"faq-body\" data-kid=\"2-12-1-2-1-2\" data-name=\"faq answer body\">\n                        <p class=\"pt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[72ch]\" data-kid=\"2-12-1-2-1-2-1\" data-name=\"answer text\">\n                            No, and that's the point. A mutable split would need an authority to mutate it, which reintroduces exactly the trusted party PayPool removes. If your weighting changes, deploy a new pool — cloning is cheap — and point future income at it. Past income stays governed by the terms it arrived under.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"faq py-7\" data-kid=\"2-12-1-2-2\" data-name=\"faq item 2\">\n                    <div class=\"faq-q flex items-start justify-between gap-8\" data-kid=\"2-12-1-2-2-1\" data-name=\"faq question header\">\n                        <h3 class=\"f-serif italic text-[27px] leading-[1.2]\" data-kid=\"2-12-1-2-2-1-1\" data-name=\"question text\">\n                            Does one pool work across several chains?\n                        </h3>\n                        <span class=\"faq-ico f-mono text-[18px] text-[#0070BB] shrink-0 leading-none pt-1.5\" data-kid=\"2-12-1-2-2-1-2\" data-name=\"toggle icon\">\n                            +\n                        </span>\n                    </div>\n                    <div class=\"faq-body\" data-kid=\"2-12-1-2-2-2\" data-name=\"faq answer body\">\n                        <p class=\"pt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[72ch]\" data-kid=\"2-12-1-2-2-2-1\" data-name=\"answer text\">\n                            A pool instance lives on one chain. Multi-chain and cross-chain pools are out of scope for v1: bridging would add a trust assumption bigger than the one we removed. The deployment is portable though — chain id, RPC and factory address are all configuration, currently set to Base Sepolia (84532).\n                        </p>\n                    </div>\n                </div>\n                <div class=\"faq py-7\" data-kid=\"2-12-1-2-3\" data-name=\"faq item 3\">\n                    <div class=\"faq-q flex items-start justify-between gap-8\" data-kid=\"2-12-1-2-3-1\" data-name=\"faq question header\">\n                        <h3 class=\"f-serif italic text-[27px] leading-[1.2]\" data-kid=\"2-12-1-2-3-1-1\" data-name=\"question text\">\n                            Does the dashboard ever hold my funds?\n                        </h3>\n                        <span class=\"faq-ico f-mono text-[18px] text-[#0070BB] shrink-0 leading-none pt-1.5\" data-kid=\"2-12-1-2-3-1-2\" data-name=\"toggle icon\">\n                            +\n                        </span>\n                    </div>\n                    <div class=\"faq-body\" data-kid=\"2-12-1-2-3-2\" data-name=\"faq answer body\">\n                        <p class=\"pt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[72ch]\" data-kid=\"2-12-1-2-3-2-1\" data-name=\"answer text\">\n                            Never. It holds no keys and has no custody path. Transactions are signed in your wallet via viem/wagmi and go directly to the pool contract; the dashboard's only privilege is reading a Postgres cache of public event logs.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"faq py-7\" data-kid=\"2-12-1-2-4\" data-name=\"faq item 4\">\n                    <div class=\"faq-q flex items-start justify-between gap-8\" data-kid=\"2-12-1-2-4-1\" data-name=\"faq question header\">\n                        <h3 class=\"f-serif italic text-[27px] leading-[1.2]\" data-kid=\"2-12-1-2-4-1-1\" data-name=\"question text\">\n                            Do I have to trust the indexer's numbers?\n                        </h3>\n                        <span class=\"faq-ico f-mono text-[18px] text-[#0070BB] shrink-0 leading-none pt-1.5\" data-kid=\"2-12-1-2-4-1-2\" data-name=\"toggle icon\">\n                            +\n                        </span>\n                    </div>\n                    <div class=\"faq-body\" data-kid=\"2-12-1-2-4-2\" data-name=\"faq answer body\">\n                        <p class=\"pt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[72ch]\" data-kid=\"2-12-1-2-4-2-1\" data-name=\"answer text\">\n                            No. Call\n                            <span class=\"f-mono text-[12.5px]\" data-kid=\"2-12-1-2-4-2-1-1\" data-name=\"pending payment function name\">\n                                pendingPayment(payee, token)\n                            </span>\n                            on the contract and compare. The indexer is a convenience layer, not a source of truth — it reports its own honesty through\n                            <span class=\"f-mono text-[12.5px]\" data-kid=\"2-12-1-2-4-2-1-2\" data-name=\"health endpoint\">\n                                /health\n                            </span>\n                            , which flips from healthy to degraded past a configurable lag threshold.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"faq py-7\" data-kid=\"2-12-1-2-5\" data-name=\"faq item 5\">\n                    <div class=\"faq-q flex items-start justify-between gap-8\" data-kid=\"2-12-1-2-5-1\" data-name=\"faq question header\">\n                        <h3 class=\"f-serif italic text-[27px] leading-[1.2]\" data-kid=\"2-12-1-2-5-1-1\" data-name=\"question text\">\n                            Why\n                            <span class=\"f-mono not-italic text-[20px]\" data-kid=\"2-12-1-2-5-1-1-1\" data-name=\"clone function name\">\n                                Clones.clone\n                            </span>\n                            and not CREATE2?\n                        </h3>\n                        <span class=\"faq-ico f-mono text-[18px] text-[#0070BB] shrink-0 leading-none pt-1.5\" data-kid=\"2-12-1-2-5-1-2\" data-name=\"toggle icon\">\n                            +\n                        </span>\n                    </div>\n                    <div class=\"faq-body\" data-kid=\"2-12-1-2-5-2\" data-name=\"faq answer body\">\n                        <p class=\"pt-5 text-[14.5px] leading-[1.8] text-[#2A3439]/75 max-w-[72ch]\" data-kid=\"2-12-1-2-5-2-1\" data-name=\"answer text\">\n                            Sequential\n                            <span class=\"f-mono text-[12.5px]\" data-kid=\"2-12-1-2-5-2-1-1\" data-name=\"create function name\">\n                                CREATE\n                            </span>\n                            means pool addresses aren't predictable before deployment, which avoids the front-running-a-vanity-address class of issue. If deterministic addresses become a requirement,\n                            <span class=\"f-mono text-[12.5px]\" data-kid=\"2-12-1-2-5-2-1-2\" data-name=\"clone deterministic function name\">\n                                cloneDeterministic\n                            </span>\n                            is a documented upgrade path — a deliberate trade, not an oversight.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 11. CTA + FOOTER -->\n    <section class=\"mx-auto max-w-[1280px] px-8 pt-28 pb-24\" data-kid=\"2-13\" data-name=\"call-to-action section\" id=\"cta\">\n        <div class=\"grid grid-cols-12 gap-10 items-end\" data-kid=\"2-13-1\" data-name=\"cta container\">\n            <div class=\"col-span-12 lg:col-span-7\" data-kid=\"2-13-1-1\" data-name=\"cta headline container\">\n                <div class=\"eyebrow reveal\" data-kid=\"2-13-1-1-1\" data-name=\"get started label\">\n                    Get started\n                </div>\n                <h2 class=\"reveal f-serif italic text-[54px] lg:text-[68px] leading-[1.02] mt-4\" data-kid=\"2-13-1-1-2\" data-name=\"cta headline\">\n                    Deploy a pool today.\n                </h2>\n            </div>\n            <div class=\"col-span-12 lg:col-span-5\" data-kid=\"2-13-1-2\" data-name=\"cta description container\">\n                <p class=\"reveal text-[14px] leading-[1.8] text-[#2A3439]/70\" data-kid=\"2-13-1-2-1\" data-name=\"cta description\">\n                    Clone the repo, run\n                    <span class=\"f-mono text-[12.5px]\" data-kid=\"2-13-1-2-1-1\" data-name=\"forge test command\">\n                        forge test\n                    </span>\n                    , deploy the factory to Base Sepolia and create your first split in one transaction.\n                </p>\n            </div>\n        </div>\n        <div class=\"reveal mt-10 border-t hair pt-8 flex flex-wrap items-center gap-8\" data-kid=\"2-13-2\" data-name=\"cta buttons and footer\">\n            <a class=\"bg-[#0070BB] text-[#F8F8FF] text-[13px] font-medium px-8 py-4 hover:bg-[#2A3439]\" data-kid=\"2-13-2-1\" data-name=\"deploy button\" href=\"#\">\n                Deploy a pool\n            </a>\n            <a class=\"text-[13px] text-[#2A3439]/75 border-b hair pb-0.5 hover:text-[#0070BB]\" data-kid=\"2-13-2-2\" data-name=\"view source link\" href=\"#\">\n                View source on GitHub\n            </a>\n            <span class=\"f-mono text-[10.5px] text-[#2A3439]/50 ml-auto\" data-kid=\"2-13-2-3\" data-name=\"chain status footer\">\n                Base Sepolia · chain id 84532 · factory 0x2E1b…7A04\n            </span>\n        </div>\n    </section>\n    <footer class=\"border-t hair bg-[#E3DAC9]/25\" data-kid=\"2-14\" data-name=\"footer\">\n        <div class=\"mx-auto max-w-[1280px] px-8 py-14 grid grid-cols-2 md:grid-cols-5 gap-10\" data-kid=\"2-14-1\" data-name=\"footer links container\">\n            <div class=\"col-span-2 md:col-span-1\" data-kid=\"2-14-1-1\" data-name=\"footer logo info\">\n                <div class=\"f-serif text-[20px]\" data-kid=\"2-14-1-1-1\" data-name=\"logo\">\n                    PayPool\n                </div>\n                <p class=\"mt-3 text-[12.5px] leading-[1.7] text-[#2A3439]/65 max-w-[26ch]\" data-kid=\"2-14-1-1-2\" data-name=\"copyright note\">\n                    Trustless, on-chain revenue splitting. Early build — see TODO.md for the current phase.\n                </p>\n            </div>\n            <div data-kid=\"2-14-1-2\" data-name=\"footer product links\">\n                <div class=\"eyebrow\" data-kid=\"2-14-1-2-1\" data-name=\"product label\">\n                    Product\n                </div>\n                <ul class=\"mt-4 space-y-2 text-[12.5px] text-[#2A3439]/75\" data-kid=\"2-14-1-2-2\" data-name=\"link list\">\n                    <li data-kid=\"2-14-1-2-2-1\" data-name=\"item 1\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-2-2-1-1\" data-name=\"how it works link\" href=\"#how\">\n                            How it works\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-2-2-2\" data-name=\"item 2\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-2-2-2-1\" data-name=\"dashboard link\" href=\"#dashboard\">\n                            Dashboard\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-2-2-3\" data-name=\"item 3\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-2-2-3-1\" data-name=\"guarantees link\" href=\"#trustless\">\n                            Guarantees\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-2-2-4\" data-name=\"item 4\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-2-2-4-1\" data-name=\"faq link\" href=\"#faq\">\n                            Scope & FAQ\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"2-14-1-3\" data-name=\"footer docs links\">\n                <div class=\"eyebrow\" data-kid=\"2-14-1-3-1\" data-name=\"docs label\">\n                    Documentation\n                </div>\n                <ul class=\"mt-4 space-y-2 f-mono text-[11.5px] text-[#2A3439]/75\" data-kid=\"2-14-1-3-2\" data-name=\"link list\">\n                    <li data-kid=\"2-14-1-3-2-1\" data-name=\"item 1\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-3-2-1-1\" data-name=\"readme link\" href=\"#\">\n                            README.md\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-3-2-2\" data-name=\"item 2\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-3-2-2-1\" data-name=\"architecture link\" href=\"#\">\n                            ARCHITECTURE.md\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-3-2-3\" data-name=\"item 3\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-3-2-3-1\" data-name=\"design link\" href=\"#\">\n                            DESIGN.md\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-3-2-4\" data-name=\"item 4\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-3-2-4-1\" data-name=\"security link\" href=\"#\">\n                            SECURITY.md\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-3-2-5\" data-name=\"item 5\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-3-2-5-1\" data-name=\"contributing link\" href=\"#\">\n                            CONTRIBUTING.md\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"2-14-1-4\" data-name=\"footer build links\">\n                <div class=\"eyebrow\" data-kid=\"2-14-1-4-1\" data-name=\"build label\">\n                    Build\n                </div>\n                <ul class=\"mt-4 space-y-2 f-mono text-[11.5px] text-[#2A3439]/75\" data-kid=\"2-14-1-4-2\" data-name=\"build list\">\n                    <li data-kid=\"2-14-1-4-2-1\" data-name=\"item 1\">\n                        forge test\n                    </li>\n                    <li data-kid=\"2-14-1-4-2-2\" data-name=\"item 2\">\n                        arq worker.WorkerSettings\n                    </li>\n                    <li data-kid=\"2-14-1-4-2-3\" data-name=\"item 3\">\n                        npm run dev\n                    </li>\n                    <li data-kid=\"2-14-1-4-2-4\" data-name=\"item 4\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-4-2-4-1\" data-name=\"todo link\" href=\"#\">\n                            TODO.md\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"2-14-1-5\" data-name=\"footer legal links\">\n                <div class=\"eyebrow\" data-kid=\"2-14-1-5-1\" data-name=\"legal label\">\n                    Legal\n                </div>\n                <ul class=\"mt-4 space-y-2 text-[12.5px] text-[#2A3439]/75\" data-kid=\"2-14-1-5-2\" data-name=\"link list\">\n                    <li data-kid=\"2-14-1-5-2-1\" data-name=\"item 1\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-5-2-1-1\" data-name=\"mit link\" href=\"#\">\n                            MIT License\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-5-2-2\" data-name=\"item 2\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-5-2-2-1\" data-name=\"disclaimer link\" href=\"#\">\n                            Disclaimer\n                        </a>\n                    </li>\n                    <li data-kid=\"2-14-1-5-2-3\" data-name=\"item 3\">\n                        <a class=\"hover:text-[#0070BB]\" data-kid=\"2-14-1-5-2-3-1\" data-name=\"threat model link\" href=\"#\">\n                            Threat model\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"border-t hair\" data-kid=\"2-14-2\" data-name=\"bottom bar\">\n            <div class=\"mx-auto max-w-[1280px] px-8 py-4 flex flex-wrap justify-between gap-4 f-mono text-[10.5px] text-[#2A3439]/55\" data-kid=\"2-14-2-1\" data-name=\"bottom bar layout\">\n                <span data-kid=\"2-14-2-1-1\" data-name=\"copyright text\">\n                    © 2026 PayPool · MIT licensed\n                </span>\n                <span data-kid=\"2-14-2-1-2\" data-name=\"disclaimer text\">\n                    Testnet only — not audited. Do not use with funds you can't lose.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\";\n  new Lenis({ autoRaf: true });\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n/* hero */\ngsap.from(\"#hero-h1\", {y:26, autoAlpha:0, duration:1, ease:\"power3.out\"});\ngsap.from(\".hero-r\", {y:18, autoAlpha:0, duration:.8, stagger:.12, delay:.25, ease:\"power2.out\"});\ngsap.from(\"#hero-fig\", {autoAlpha:0, filter:\"blur(12px)\", duration:1.1, delay:.2, ease:\"power2.out\"});\n\n/* hero arcs draw */\ndocument.querySelectorAll(\".arc\").forEach(function(p){\n  var L = p.getTotalLength();\n  p.style.strokeDasharray = L;\n  gsap.fromTo(p, {strokeDashoffset:L}, {strokeDashoffset:0, duration:1.4, delay:.5, ease:\"power2.inOut\"});\n});\n\n/* generic reveals */\ngsap.utils.toArray(\".reveal\").forEach(function(el){\n  gsap.from(el, {y:22, autoAlpha:0, duration:.8, ease:\"power2.out\",\n    scrollTrigger:{trigger:el, start:\"top 88%\"}});\n});\n\n/* timeline line scrub */\nvar tlWrap = document.querySelector(\"#how .relative\");\nif(tlWrap){\n  gsap.to(\"#tl-line\", {height:\"100%\", ease:\"none\",\n    scrollTrigger:{trigger:tlWrap, start:\"top 70%\", end:\"bottom 80%\", scrub:true}});\n}\n\n/* leader lines */\ngsap.utils.toArray(\".leader\").forEach(function(el){\n  gsap.fromTo(el, {scaleX:0}, {scaleX:1, duration:.6, ease:\"power2.out\",\n    scrollTrigger:{trigger:el, start:\"top 92%\"}});\n});\n\n/* counters */\ngsap.utils.toArray(\".count\").forEach(function(el){\n  var to = +el.dataset.to, fmt = el.dataset.fmt;\n  var o = {v:0};\n  gsap.to(o, {v:to, duration:1.6, ease:\"power2.out\",\n    scrollTrigger:{trigger:el, start:\"top 99%\", once:true},\n    onUpdate:function(){ var n = Math.round(o.v); el.textContent = fmt ? n.toLocaleString(\"en-US\") : n; }});\n});\n\n/* path toggle */\nvar pa=document.getElementById(\"pathA\"), pb=document.getElementById(\"pathB\"),\n    mid=document.getElementById(\"midRow\"), pool=document.getElementById(\"poolRow\"),\n    cap=document.getElementById(\"pathCap\");\nvar on=\"px-4 py-2 bg-[#2A3439] text-[#F8F8FF]\", off=\"px-4 py-2\";\nfunction setPath(usePP){\n  if(usePP){\n    gsap.to(mid,{autoAlpha:0,height:0,paddingTop:0,paddingBottom:0,duration:.35,ease:\"power2.inOut\",onComplete:function(){mid.style.display=\"none\";}});\n    pool.style.display=\"flex\";\n    gsap.fromTo(pool,{autoAlpha:0,y:-6},{autoAlpha:1,y:0,duration:.4,delay:.15,ease:\"power2.out\"});\n    cap.textContent=\"1 hop · no custody · payout enforced by code\";\n    pb.className=on+\" border-l border-[rgba(42,52,57,0.15)]\"; pa.className=off;\n  } else {\n    gsap.to(pool,{autoAlpha:0,duration:.25,onComplete:function(){pool.style.display=\"none\";}});\n    mid.style.display=\"flex\";\n    gsap.to(mid,{autoAlpha:1,height:\"auto\",paddingTop:14,paddingBottom:14,duration:.4,delay:.1,ease:\"power2.out\"});\n    cap.textContent=\"2 hops · custody at hop 1 · payout depends on policy\";\n    pa.className=on; pb.className=off+\" border-l border-[rgba(42,52,57,0.15)]\";\n  }\n}\npa.addEventListener(\"click\",function(){setPath(false);});\npb.addEventListener(\"click\",function(){setPath(true);});\n\n/* faq */\ndocument.querySelectorAll(\".faq\").forEach(function(f){\n  var q=f.querySelector(\".faq-q\"), b=f.querySelector(\".faq-body\"), i=f.querySelector(\".faq-ico\");\n  q.addEventListener(\"click\",function(){\n    var open = b.style.maxHeight && b.style.maxHeight!==\"0px\";\n    document.querySelectorAll(\".faq\").forEach(function(o){\n      o.querySelector(\".faq-body\").style.maxHeight=\"0px\";\n      o.querySelector(\".faq-ico\").textContent=\"+\";\n    });\n    if(!open){ b.style.maxHeight = b.scrollHeight+\"px\"; i.textContent=\"–\"; }\n  });\n});\n(function(){\n  var f0=document.querySelector(\".faq\");\n  var b0=f0.querySelector(\".faq-body\");\n  b0.style.maxHeight=b0.scrollHeight+\"px\";\n  f0.querySelector(\".faq-ico\").textContent=\"–\";\n})();\n\n/* chart */\nnew Chart(document.getElementById(\"depChart\"),{\n  type:\"line\",\n  data:{labels:[\"678\",\"700\",\"742\",\"790\",\"831\",\"877\",\"902\",\"940\",\"988\"],\n    datasets:[{data:[0.25,1.25,1.75,2.25,3.00,3.50,4.10,4.60,5.00],\n      borderColor:\"#0070BB\",borderWidth:1.5,pointRadius:2,pointBackgroundColor:\"#0070BB\",\n      tension:.25,fill:false}]},\n  options:{responsive:true,maintainAspectRatio:false,animation:{duration:900},\n    plugins:{legend:{display:false},tooltip:{backgroundColor:\"#2A3439\",bodyFont:{family:\"JetBrains Mono\",size:10},displayColors:false}},\n    scales:{x:{grid:{display:false},border:{color:\"rgba(42,52,57,0.15)\"},ticks:{font:{size:9,family:\"JetBrains Mono\"},color:\"rgba(42,52,57,0.55)\"}},\n            y:{grid:{color:\"rgba(42,52,57,0.08)\"},border:{display:false},ticks:{font:{size:9,family:\"JetBrains Mono\"},color:\"rgba(42,52,57,0.55)\"}}}}\n});\n</script>\n",
