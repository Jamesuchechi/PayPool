      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500&family=JetBrains+Mono:wght@400;500;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n.fh{font-family:'Space Grotesk',sans-serif}\n.fb{font-family:'Fira Sans',sans-serif}\n.fm{font-family:'JetBrains Mono',ui-monospace,monospace}\n.flow{stroke-dasharray:26 74;animation:march 2.2s linear infinite}\n@keyframes march{to{stroke-dashoffset:-100}}\n.mq{animation:mq 26s linear infinite}\n@keyframes mq{to{transform:translateX(-50%)}}\n.mq-slow{animation:mq 44s linear infinite}\n.blink{animation:blink 1s steps(2,start) infinite}\n@keyframes blink{50%{opacity:0}}\n.grid-bg{background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:64px 64px}\n.cta-mag{position:relative;overflow:hidden}\n.cta-mag .glow{position:absolute;width:180px;height:180px;border-radius:9999px;background:radial-gradient(circle,rgba(255,255,255,.55),transparent 65%);pointer-events:none;left:0;top:0;transform:translate(-50%,-50%);opacity:0}\n.clipbtn{clip-path:polygon(0 0,100% 0,100% 68%,calc(100% - 14px) 100%,0 100%)}\n.acc-body{overflow:hidden}\n</style>\n<div class=\"fb bg-[#010B13] text-white antialiased selection:bg-[#00FF40] selection:text-[#010B13]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- NAV -->\n    <header class=\"sticky top-0 z-50 bg-[#010B13]/90 backdrop-blur-md border-b border-white/10\" data-kid=\"1-1\" data-name=\"sticky site header\">\n        <div class=\"max-w-[1240px] mx-auto px-6 h-16 flex items-center gap-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a class=\"fh font-bold text-[19px] tracking-tight flex items-center gap-2\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n                <span class=\"w-2.5 h-6 bg-[#00FF40] inline-block\" data-kid=\"1-1-1-1-1\" data-name=\"brand identifier color block\">\n                </span>\n                PayPool\n            </a>\n            <nav class=\"hidden lg:flex items-center gap-7 fb text-[14px] text-white/55\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-1-1-2-1\" data-name=\"how it works navigation link\" href=\"#how\">\n                    How it works\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-1-1-2-2\" data-name=\"contracts navigation link\" href=\"#contracts\">\n                    Contracts\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-1-1-2-3\" data-name=\"architecture navigation link\" href=\"#arch\">\n                    Architecture\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-1-1-2-4\" data-name=\"security navigation link\" href=\"#security\">\n                    Security\n                </a>\n                <a class=\"hover:text-[#00FF40]\" data-kid=\"1-1-1-2-5\" data-name=\"documentation navigation link\" href=\"#faq\">\n                    Docs\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header utility container\">\n                <span class=\"hidden md:inline-flex fm text-[11px] text-white/60 border border-white/15 bg-[#002147]/60 px-3 py-1.5 items-center gap-2\" data-kid=\"1-1-1-3-1\" data-name=\"chain network status indicator\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#00FF40]\" data-kid=\"1-1-1-3-1-1\" data-name=\"active network connection dot\">\n                    </span>\n                    Base Sepolia · 84532\n                </span>\n                <a class=\"fh font-bold text-[13px] bg-[#00FF40] text-[#010B13] px-4 py-2.5 clipbtn hover:bg-[#5cff85]\" data-kid=\"1-1-1-3-2\" data-name=\"primary deploy call-to-action button\" href=\"#cta\">\n                    Deploy a pool\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- HERO -->\n    <section class=\"relative grid-bg overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <img alt=\"abstract wireframe funnel splitting into streams\" class=\"pointer-events-none absolute -top-24 right-[-10%] w-[1100px] max-w-none opacity-[0.28] mix-blend-screen blur-[2px]\" data-kid=\"1-2-1\" data-name=\"background abstract wireframe image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/c7f2e29f6f814b22bd144f16b25b0953.jpg\"/>\n        <div class=\"pointer-events-none absolute inset-0 bg-gradient-to-b from-[#010B13]/40 via-[#010B13]/70 to-[#010B13]\" data-kid=\"1-2-2\" data-name=\"hero section overlay gradient\">\n        </div>\n        <div class=\"relative max-w-[1240px] mx-auto px-6 pt-20 pb-24 grid lg:grid-cols-[1.02fr_1fr] gap-14 items-center\" data-kid=\"1-2-3\" data-name=\"hero content container\">\n            <div data-kid=\"1-2-3-1\" data-name=\"hero copy and interactive section\">\n                <div class=\"hero-el fm text-[11px] text-[#00FF40] tracking-[0.25em] uppercase mb-6 flex items-center gap-3\" data-kid=\"1-2-3-1-1\" data-name=\"hero subheadline indicator\">\n                    <span class=\"w-8 h-px bg-[#00FF40]\" data-kid=\"1-2-3-1-1-1\" data-name=\"horizontal line decoration\">\n                    </span>\n                    Solidity 0.8.24 · MIT · 0 admin keys\n                </div>\n                <h1 class=\"hero-el fh text-[58px] xl:text-[72px] leading-[0.93] font-bold tracking-[-0.03em]\" data-kid=\"1-2-3-1-2\" data-name=\"main hero headline\">\n                    Revenue that\n                    <br data-kid=\"1-2-3-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#00FF40]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2\" data-name=\"typewriter text element\" data-reason=\"text content cycled by typewriter script\" id=\"tw\">\n                    </span>\n                    <span class=\"text-[#00FF40] blink\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-3\" data-name=\"typing cursor indicator\" data-reason=\"blink animation toggles opacity\">\n                        _\n                    </span>\n                    <br data-kid=\"1-2-3-1-2-4\" data-name=\"headline line break\"/>\n                    by contract.\n                </h1>\n                <p class=\"hero-el mt-7 text-[17px] leading-relaxed text-white/60 max-w-[520px]\" data-kid=\"1-2-3-1-3\" data-name=\"hero description text\">\n                    Trustless, on-chain revenue splitting. Deploy a pool, define payees and shares, and let anyone send funds to it — each payee withdraws their exact proportional share at any time.\n                </p>\n                <div class=\"hero-el mt-9 flex flex-wrap items-center gap-4\" data-kid=\"1-2-3-1-4\" data-name=\"hero call-to-action group\">\n                    <a class=\"cta-mag fh font-bold text-[15px] bg-[#00FF40] text-[#010B13] px-7 py-4 clipbtn\" data-kid=\"1-2-3-1-4-1\" data-name=\"primary deploy call-to-action\" href=\"#cta\">\n                        <span class=\"glow\" data-dynamic=\"true\" data-kid=\"1-2-3-1-4-1-1\" data-name=\"magnetic button glow effect\" data-reason=\"glow position updated on pointer move\">\n                        </span>\n                        <span class=\"relative\" data-kid=\"1-2-3-1-4-1-2\" data-name=\"call-to-action label\">\n                            Deploy a pool\n                        </span>\n                    </a>\n                    <a class=\"fh font-medium text-[15px] border border-white/20 text-white/80 px-7 py-4 hover:border-[#00FF40] hover:text-[#00FF40] flex items-center gap-2\" data-kid=\"1-2-3-1-4-2\" data-name=\"secondary contract documentation link\" href=\"#contracts\">\n                        <i class=\"ti ti-code text-[16px]\" data-kid=\"1-2-3-1-4-2-1\" data-name=\"code icon\">\n                        </i>\n                        Read the contract\n                    </a>\n                </div>\n                <div class=\"hero-el mt-12 grid grid-cols-3 gap-4 border-t border-white/10 pt-6\" data-kid=\"1-2-3-1-5\" data-name=\"hero metrics grid\">\n                    <div data-kid=\"1-2-3-1-5-1\" data-name=\"basis-point precision metric\">\n                        <div class=\"fm text-[22px] text-white\" data-kid=\"1-2-3-1-5-1-1\" data-name=\"metric value text\">\n                            10,000\n                        </div>\n                        <div class=\"fm text-[10px] text-white/40 mt-1.5 uppercase tracking-wider\" data-kid=\"1-2-3-1-5-1-2\" data-name=\"metric label text\">\n                            basis-point precision\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-3-1-5-2\" data-name=\"payees per pool metric\">\n                        <div class=\"fm text-[22px] text-white\" data-kid=\"1-2-3-1-5-2-1\" data-name=\"metric value text\">\n                            2–20\n                        </div>\n                        <div class=\"fm text-[10px] text-white/40 mt-1.5 uppercase tracking-wider\" data-kid=\"1-2-3-1-5-2-2\" data-name=\"metric label text\">\n                            payees per pool\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-3-1-5-3\" data-name=\"admin keys metric\">\n                        <div class=\"fm text-[22px] text-white\" data-kid=\"1-2-3-1-5-3-1\" data-name=\"metric value text\">\n                            0\n                        </div>\n                        <div class=\"fm text-[10px] text-white/40 mt-1.5 uppercase tracking-wider\" data-kid=\"1-2-3-1-5-3-2\" data-name=\"metric label text\">\n                            admin keys\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- LIVE SPLIT DIAGRAM -->\n            <div class=\"hero-diagram relative border border-white/12 bg-[#002147]/45 p-5 backdrop-blur-sm\" data-kid=\"1-2-3-2\" data-name=\"live split diagram container\">\n                <div class=\"absolute -top-px -left-px w-3 h-3 border-l-2 border-t-2 border-[#00FF40]\" data-kid=\"1-2-3-2-1\" data-name=\"diagram corner decoration top\">\n                </div>\n                <div class=\"absolute -bottom-px -right-px w-3 h-3 border-r-2 border-b-2 border-[#FF00FF]\" data-kid=\"1-2-3-2-2\" data-name=\"diagram corner decoration bottom\">\n                </div>\n                <div class=\"flex items-center justify-between fm text-[10px] text-white/45 mb-3\" data-kid=\"1-2-3-2-3\" data-name=\"diagram status header\">\n                    <span data-kid=\"1-2-3-2-3-1\" data-name=\"diagram pool address text\">\n                        POOL 0x7a3f9c2b…c21b\n                    </span>\n                    <span class=\"text-[#00FF40] flex items-center gap-1.5\" data-kid=\"1-2-3-2-3-2\" data-name=\"diagram live status label\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#00FF40] blink\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"live status indicator\" data-reason=\"blink animation toggles opacity\">\n                        </span>\n                        LIVE\n                    </span>\n                </div>\n                <svg class=\"w-full\" data-kid=\"1-2-3-2-4\" data-name=\"live split svg graphic\" viewbox=\"0 0 420 246\">\n                    <defs>\n                        <filter id=\"glow\">\n                            <fegaussianblur result=\"b\" stddeviation=\"2.5\">\n                            </fegaussianblur>\n                            <femerge>\n                                <femergenode in=\"b\">\n                                </femergenode>\n                                <femergenode in=\"SourceGraphic\">\n                                </femergenode>\n                            </femerge>\n                        </filter>\n                    </defs>\n                    <rect fill=\"#010B13\" height=\"30\" stroke=\"#ffffff33\" width=\"120\" x=\"150\" y=\"6\">\n                    </rect>\n                    <text fill=\"#fff\" font-family=\"JetBrains Mono, monospace\" font-size=\"11\" text-anchor=\"middle\" x=\"210\" y=\"26\">\n                        deposit 2.4 ETH\n                    </text>\n                    <path d=\"M210 36 V70\" stroke=\"#ffffff1a\" stroke-width=\"10\">\n                    </path>\n                    <path class=\"dpath flow\" d=\"M210 36 V70\" filter=\"url(#glow)\" stroke=\"#00FF40\" stroke-width=\"3\">\n                    </path>\n                    <rect fill=\"#002147\" height=\"42\" stroke=\"#00FF40\" stroke-width=\"1.5\" width=\"180\" x=\"120\" y=\"70\">\n                    </rect>\n                    <text fill=\"#00FF40\" font-family=\"JetBrains Mono, monospace\" font-size=\"11\" text-anchor=\"middle\" x=\"210\" y=\"88\">\n                        PayPool.sol\n                    </text>\n                    <text fill=\"#ffffff80\" font-family=\"JetBrains Mono, monospace\" font-size=\"9\" text-anchor=\"middle\" x=\"210\" y=\"104\">\n                        totalReceived 12.8041 ETH\n                    </text>\n                    <path d=\"M160 112 V148 Q160 163 145 163 H60 Q45 163 45 178 V204\" fill=\"none\" stroke=\"#ffffff14\" stroke-width=\"12\">\n                    </path>\n                    <path class=\"dpath flow\" d=\"M160 112 V148 Q160 163 145 163 H60 Q45 163 45 178 V204\" fill=\"none\" filter=\"url(#glow)\" stroke=\"#00FF40\" stroke-width=\"12\">\n                    </path>\n                    <path d=\"M190 112 V156 Q190 170 175 170 H162 Q147 170 147 184 V204\" fill=\"none\" stroke=\"#ffffff14\" stroke-width=\"7.5\">\n                    </path>\n                    <path class=\"dpath flow\" d=\"M190 112 V156 Q190 170 175 170 H162 Q147 170 147 184 V204\" fill=\"none\" stroke=\"#3B82F6\" stroke-width=\"7.5\" style=\"animation-delay:.45s\">\n                    </path>\n                    <path d=\"M230 112 V156 Q230 170 245 170 H258 Q271 170 271 184 V204\" fill=\"none\" stroke=\"#ffffff14\" stroke-width=\"6\">\n                    </path>\n                    <path class=\"dpath flow\" d=\"M230 112 V156 Q230 170 245 170 H258 Q271 170 271 184 V204\" fill=\"none\" stroke=\"#FF00FF\" stroke-width=\"6\" style=\"animation-delay:.9s\">\n                    </path>\n                    <path d=\"M260 112 V148 Q260 163 275 163 H360 Q375 163 375 178 V204\" fill=\"none\" stroke=\"#ffffff14\" stroke-width=\"4.5\">\n                    </path>\n                    <path class=\"dpath flow\" d=\"M260 112 V148 Q260 163 275 163 H360 Q375 163 375 178 V204\" fill=\"none\" stroke=\"#ffffff99\" stroke-width=\"4.5\" style=\"animation-delay:1.35s\">\n                    </path>\n                    <g font-family=\"JetBrains Mono, monospace\" font-size=\"9\">\n                        <rect fill=\"#010B13\" height=\"34\" stroke=\"#00FF4055\" width=\"74\" x=\"8\" y=\"204\">\n                        </rect>\n                        <text fill=\"#00FF40\" text-anchor=\"middle\" x=\"45\" y=\"218\">\n                            4000 bps\n                        </text>\n                        <text fill=\"#ffffffaa\" text-anchor=\"middle\" x=\"45\" y=\"231\">\n                            40.00%\n                        </text>\n                        <rect fill=\"#010B13\" height=\"34\" stroke=\"#3B82F655\" width=\"74\" x=\"110\" y=\"204\">\n                        </rect>\n                        <text fill=\"#60A5FA\" text-anchor=\"middle\" x=\"147\" y=\"218\">\n                            2500 bps\n                        </text>\n                        <text fill=\"#ffffffaa\" text-anchor=\"middle\" x=\"147\" y=\"231\">\n                            25.00%\n                        </text>\n                        <rect fill=\"#010B13\" height=\"34\" stroke=\"#FF00FF55\" width=\"74\" x=\"234\" y=\"204\">\n                        </rect>\n                        <text fill=\"#FF00FF\" text-anchor=\"middle\" x=\"271\" y=\"218\">\n                            2000 bps\n                        </text>\n                        <text fill=\"#ffffffaa\" text-anchor=\"middle\" x=\"271\" y=\"231\">\n                            20.00%\n                        </text>\n                        <rect fill=\"#010B13\" height=\"34\" stroke=\"#ffffff33\" width=\"74\" x=\"338\" y=\"204\">\n                        </rect>\n                        <text fill=\"#ffffffcc\" text-anchor=\"middle\" x=\"375\" y=\"218\">\n                            1500 bps\n                        </text>\n                        <text fill=\"#ffffffaa\" text-anchor=\"middle\" x=\"375\" y=\"231\">\n                            15.00%\n                        </text>\n                    </g>\n                </svg>\n                <div class=\"fm text-[10.5px] border-t border-white/10 mt-4\" data-kid=\"1-2-3-2-5\" data-name=\"pending payouts list\">\n                    <div class=\"flex justify-between py-2 border-b border-white/5\" data-kid=\"1-2-3-2-5-1\" data-name=\"payee pending payout item\">\n                        <span class=\"text-white/50\" data-kid=\"1-2-3-2-5-1-1\" data-name=\"payee address text\">\n                            0x9f21…4ab8\n                        </span>\n                        <span class=\"text-[#00FF40]\" data-kid=\"1-2-3-2-5-1-2\" data-name=\"payee amount label\">\n                            <span class=\"cnt\" data-dynamic=\"true\" data-kid=\"1-2-3-2-5-1-2-1\" data-name=\"pending amount counter\" data-reason=\"text value updated by counter script\" data-to=\"0.4211\">\n                                0.0000\n                            </span>\n                            ETH pending\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between py-2 border-b border-white/5\" data-kid=\"1-2-3-2-5-2\" data-name=\"payee pending payout item\">\n                        <span class=\"text-white/50\" data-kid=\"1-2-3-2-5-2-1\" data-name=\"payee address text\">\n                            0x3c8d…71e0\n                        </span>\n                        <span class=\"text-[#60A5FA]\" data-kid=\"1-2-3-2-5-2-2\" data-name=\"payee amount label\">\n                            <span class=\"cnt\" data-dynamic=\"true\" data-kid=\"1-2-3-2-5-2-2-1\" data-name=\"pending amount counter\" data-reason=\"text value updated by counter script\" data-to=\"0.2632\">\n                                0.0000\n                            </span>\n                            ETH pending\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between py-2 border-b border-white/5\" data-kid=\"1-2-3-2-5-3\" data-name=\"payee pending payout item\">\n                        <span class=\"text-white/50\" data-kid=\"1-2-3-2-5-3-1\" data-name=\"payee address text\">\n                            0xbb14…09f2\n                        </span>\n                        <span class=\"text-[#FF00FF]\" data-kid=\"1-2-3-2-5-3-2\" data-name=\"payee amount label\">\n                            <span class=\"cnt\" data-dynamic=\"true\" data-kid=\"1-2-3-2-5-3-2-1\" data-name=\"pending amount counter\" data-reason=\"text value updated by counter script\" data-to=\"0.2105\">\n                                0.0000\n                            </span>\n                            ETH pending\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between py-2\" data-kid=\"1-2-3-2-5-4\" data-name=\"payee pending payout item\">\n                        <span class=\"text-white/50\" data-kid=\"1-2-3-2-5-4-1\" data-name=\"payee address text\">\n                            0x6e07…d3a5\n                        </span>\n                        <span class=\"text-white/70\" data-kid=\"1-2-3-2-5-4-2\" data-name=\"payee amount label\">\n                            <span class=\"cnt\" data-dynamic=\"true\" data-kid=\"1-2-3-2-5-4-2-1\" data-name=\"pending amount counter\" data-reason=\"text value updated by counter script\" data-to=\"0.1579\">\n                                0.0000\n                            </span>\n                            ETH pending\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- EVENT MARQUEE -->\n    <div class=\"border-y border-white/10 bg-[#002147]/40 py-3 overflow-hidden\" data-kid=\"1-3\" data-name=\"event marquee section\">\n        <div class=\"flex w-max mq fm text-[12px] text-white/45\" data-kid=\"1-3-1\" data-name=\"event list animation container\">\n            <div class=\"flex shrink-0\" data-kid=\"1-3-1-1\" data-name=\"primary event row\">\n                <span class=\"px-6\" data-kid=\"1-3-1-1-1\">\n                    PaymentReceived(address,address,uint256)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-1-2\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-1-3\">\n                    PaymentReleased(address,address,uint256)\n                </span>\n                <span class=\"text-[#FF00FF]\" data-kid=\"1-3-1-1-4\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-1-5\">\n                    SplitterCreated(address,address,address[],uint256[],string)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-1-6\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-1-7\">\n                    release(payee,token)\n                </span>\n                <span class=\"text-[#FF00FF]\" data-kid=\"1-3-1-1-8\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-1-9\">\n                    pendingPayment(payee,token)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-1-10\">\n                    ·\n                </span>\n            </div>\n            <div aria-hidden=\"true\" class=\"flex shrink-0\" data-kid=\"1-3-1-2\" data-name=\"duplicated event row\">\n                <span class=\"px-6\" data-kid=\"1-3-1-2-1\">\n                    PaymentReceived(address,address,uint256)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-2-2\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-2-3\">\n                    PaymentReleased(address,address,uint256)\n                </span>\n                <span class=\"text-[#FF00FF]\" data-kid=\"1-3-1-2-4\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-2-5\">\n                    SplitterCreated(address,address,address[],uint256[],string)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-2-6\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-2-7\">\n                    release(payee,token)\n                </span>\n                <span class=\"text-[#FF00FF]\" data-kid=\"1-3-1-2-8\">\n                    ·\n                </span>\n                <span class=\"px-6\" data-kid=\"1-3-1-2-9\">\n                    pendingPayment(payee,token)\n                </span>\n                <span class=\"text-[#00FF40]\" data-kid=\"1-3-1-2-10\">\n                    ·\n                </span>\n            </div>\n        </div>\n    </div>\n    <!-- HOW IT WORKS -->\n    <section class=\"max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-4\" data-name=\"how it works section\" id=\"how\">\n        <div class=\"flex items-end justify-between flex-wrap gap-6 mb-14\" data-kid=\"1-4-1\" data-name=\"section header container\">\n            <h2 class=\"reveal fh text-[44px] leading-[1] font-bold tracking-[-0.02em] max-w-lg\" data-kid=\"1-4-1-1\" data-name=\"section headline\">\n                Three transactions.\n                <br data-kid=\"1-4-1-1-1\" data-name=\"headline break\"/>\n                No trusted party.\n            </h2>\n            <p class=\"reveal fm text-[12px] text-white/45 max-w-sm leading-relaxed\" data-kid=\"1-4-1-2\" data-name=\"section description\">\n                Every deposit and withdrawal is an on-chain event. The dashboard reads those events — it never holds a key.\n            </p>\n        </div>\n        <div class=\"relative\" data-kid=\"1-4-2\" data-name=\"steps grid container\">\n            <svg class=\"hidden lg:block absolute left-0 right-0 top-[86px] w-full h-6 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-4-2-1\" data-name=\"svg step connector line\" data-reason=\"stroke-dashoffset updated by scroll script\" preserveaspectratio=\"none\" viewbox=\"0 0 1200 24\">\n                <path d=\"M20 12 H1180\" fill=\"none\" id=\"chainPath\" opacity=\"0.55\" stroke=\"#00FF40\" stroke-dasharray=\"7 7\" stroke-width=\"1.5\">\n                </path>\n            </svg>\n            <div class=\"grid lg:grid-cols-3 gap-6 relative\" data-kid=\"1-4-2-2\" data-name=\"steps content grid\">\n                <div class=\"reveal relative bg-[#002147]/50 border border-[#00FF40]/30 p-6 shadow-[0_0_40px_-18px_#00FF40]\" data-kid=\"1-4-2-2-1\" data-name=\"first step feature card\">\n                    <div class=\"flex items-center justify-between mb-5\" data-kid=\"1-4-2-2-1-1\" data-name=\"feature icon container\">\n                        <div class=\"w-10 h-10 border border-[#00FF40]/40 bg-[#010B13] grid place-items-center text-[#00FF40] text-[19px]\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"code icon\">\n                            <i class=\"ti ti-code\" data-kid=\"1-4-2-2-1-1-1-1\" data-name=\"icon\">\n                            </i>\n                        </div>\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"step number indicator\">\n                            01\n                        </span>\n                    </div>\n                    <h3 class=\"fh text-[21px] font-bold\" data-kid=\"1-4-2-2-1-2\" data-name=\"feature title\">\n                        Create a pool\n                    </h3>\n                    <p class=\"text-[14px] text-white/55 mt-2 leading-relaxed\" data-kid=\"1-4-2-2-1-3\" data-name=\"feature description\">\n                        A factory clone fixes the payee list and shares forever. Sum must equal 10,000.\n                    </p>\n                    <pre class=\"fm text-[10.5px] leading-[1.85] mt-5 bg-[#010B13] border border-white/10 p-3 overflow-x-auto text-white/70\" data-kid=\"1-4-2-2-1-4\" data-name=\"code snippet block\">factory.<span class=\"text-[#00FF40]\" data-kid=\"1-4-2-2-1-4-1\">createPool</span>(\n  [<span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-1-4-2\">0x9f21…4ab8</span>, <span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-1-4-3\">0x3c8d…71e0</span>,\n   <span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-1-4-4\">0xbb14…09f2</span>, <span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-1-4-5\">0x6e07…d3a5</span>],\n  [<span class=\"text-[#FF00FF]\" data-kid=\"1-4-2-2-1-4-6\">4000</span>, <span class=\"text-[#FF00FF]\" data-kid=\"1-4-2-2-1-4-7\">2500</span>, <span class=\"text-[#FF00FF]\" data-kid=\"1-4-2-2-1-4-8\">2000</span>, <span class=\"text-[#FF00FF]\" data-kid=\"1-4-2-2-1-4-9\">1500</span>],\n  <span class=\"text-white/45\" data-kid=\"1-4-2-2-1-4-10\">\"Band Royalties\"</span>\n);</pre>\n                </div>\n                <div class=\"reveal relative bg-[#002147]/50 border border-[#00FF40]/30 p-6 shadow-[0_0_40px_-18px_#00FF40]\" data-kid=\"1-4-2-2-2\" data-name=\"second step feature card\">\n                    <div class=\"flex items-center justify-between mb-5\" data-kid=\"1-4-2-2-2-1\" data-name=\"feature icon container\">\n                        <div class=\"w-10 h-10 border border-[#00FF40]/40 bg-[#010B13] grid place-items-center text-[#00FF40] text-[19px]\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"coins icon\">\n                            <i class=\"ti ti-coins\" data-kid=\"1-4-2-2-2-1-1-1\" data-name=\"icon\">\n                            </i>\n                        </div>\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-4-2-2-2-1-2\" data-name=\"step number indicator\">\n                            02\n                        </span>\n                    </div>\n                    <h3 class=\"fh text-[21px] font-bold\" data-kid=\"1-4-2-2-2-2\" data-name=\"feature title\">\n                        Fund it\n                    </h3>\n                    <p class=\"text-[14px] text-white/55 mt-2 leading-relaxed\" data-kid=\"1-4-2-2-2-3\" data-name=\"feature description\">\n                        Anyone sends ETH or any standard ERC-20 straight to the pool address.\n                    </p>\n                    <div class=\"fm text-[10.5px] mt-5 bg-[#010B13] border border-white/10 p-3 space-y-2\" data-kid=\"1-4-2-2-2-4\" data-name=\"transaction details list\">\n                        <div class=\"flex justify-between\" data-kid=\"1-4-2-2-2-4-1\">\n                            <span class=\"text-white/40\" data-kid=\"1-4-2-2-2-4-1-1\">\n                                tx\n                            </span>\n                            <span class=\"text-white/75\" data-kid=\"1-4-2-2-2-4-1-2\">\n                                0x4c1e…9a72\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between\" data-kid=\"1-4-2-2-2-4-2\">\n                            <span class=\"text-white/40\" data-kid=\"1-4-2-2-2-4-2-1\">\n                                block\n                            </span>\n                            <span class=\"text-white/75\" data-kid=\"1-4-2-2-2-4-2-2\">\n                                12,345,700\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between\" data-kid=\"1-4-2-2-2-4-3\">\n                            <span class=\"text-white/40\" data-kid=\"1-4-2-2-2-4-3-1\">\n                                value\n                            </span>\n                            <span class=\"text-[#00FF40]\" data-kid=\"1-4-2-2-2-4-3-2\">\n                                0.3100 ETH\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between\" data-kid=\"1-4-2-2-2-4-4\">\n                            <span class=\"text-white/40\" data-kid=\"1-4-2-2-2-4-4-1\">\n                                token\n                            </span>\n                            <span class=\"text-white/75\" data-kid=\"1-4-2-2-2-4-4-2\">\n                                address(0)\n                            </span>\n                        </div>\n                        <div class=\"border-t border-white/10 pt-2 text-[#00FF40]\" data-kid=\"1-4-2-2-2-4-5\">\n                            PaymentReceived ✓ confirmed\n                        </div>\n                    </div>\n                </div>\n                <div class=\"reveal relative bg-[#002147]/50 border border-[#00FF40]/30 p-6 shadow-[0_0_40px_-18px_#00FF40]\" data-kid=\"1-4-2-2-3\" data-name=\"third step feature card\">\n                    <div class=\"flex items-center justify-between mb-5\" data-kid=\"1-4-2-2-3-1\" data-name=\"feature icon container\">\n                        <div class=\"w-10 h-10 border border-[#00FF40]/40 bg-[#010B13] grid place-items-center text-[#00FF40] text-[19px]\" data-kid=\"1-4-2-2-3-1-1\" data-name=\"download icon\">\n                            <i class=\"ti ti-download\" data-kid=\"1-4-2-2-3-1-1-1\" data-name=\"icon\">\n                            </i>\n                        </div>\n                        <span class=\"fm text-[11px] text-white/30\" data-kid=\"1-4-2-2-3-1-2\" data-name=\"step number indicator\">\n                            03\n                        </span>\n                    </div>\n                    <h3 class=\"fh text-[21px] font-bold\" data-kid=\"1-4-2-2-3-2\" data-name=\"feature title\">\n                        Withdraw\n                    </h3>\n                    <p class=\"text-[14px] text-white/55 mt-2 leading-relaxed\" data-kid=\"1-4-2-2-3-3\" data-name=\"feature description\">\n                        Pull-based. Anyone can call\n                        <span class=\"fm text-white/80\" data-kid=\"1-4-2-2-3-3-1\" data-name=\"code inline snippet\">\n                            release()\n                        </span>\n                        on behalf of a payee — funds only ever go to the payee.\n                    </p>\n                    <pre class=\"fm text-[10.5px] leading-[1.85] mt-5 bg-[#010B13] border border-white/10 p-3 overflow-x-auto text-white/70\" data-kid=\"1-4-2-2-3-4\" data-name=\"code snippet block\">pool.<span class=\"text-[#00FF40]\" data-kid=\"1-4-2-2-3-4-1\">release</span>(\n  <span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-3-4-2\">0x9f21…4ab8</span>,   <span class=\"text-white/35\" data-kid=\"1-4-2-2-3-4-3\">// payee</span>\n  <span class=\"text-[#60A5FA]\" data-kid=\"1-4-2-2-3-4-4\">address(0)</span>       <span class=\"text-white/35\" data-kid=\"1-4-2-2-3-4-5\">// native ETH</span>\n);\n<span class=\"text-white/35\" data-kid=\"1-4-2-2-3-4-6\">// → PaymentReleased 0.4211 ETH</span></pre>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- TRUSTLESS GUARANTEES -->\n    <section class=\"relative overflow-hidden border-y border-white/10\" data-kid=\"1-5\" data-name=\"trustless guarantees section\">\n        <img alt=\"abstract decentralized nodes versus centralized hub texture\" class=\"pointer-events-none absolute inset-0 w-full h-full object-cover opacity-[0.10] blur-[3px] mix-blend-screen\" data-kid=\"1-5-1\" data-name=\"background texture image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/4ea6a0e0a5fa4391976b2e692526529c.jpg\"/>\n        <div class=\"pointer-events-none absolute inset-0 bg-[#010B13]/80\" data-kid=\"1-5-2\" data-name=\"overlay layer\">\n        </div>\n        <div class=\"relative max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-5-3\" data-name=\"guarantees content container\">\n            <h2 class=\"reveal fh text-[44px] leading-[1] font-bold tracking-[-0.02em] mb-3\" data-kid=\"1-5-3-1\" data-name=\"section headline\">\n                Where does the money actually sit?\n            </h2>\n            <p class=\"reveal text-white/55 max-w-xl mb-14 text-[16px]\" data-kid=\"1-5-3-2\" data-name=\"section description\">\n                Existing splitters solve the contract problem and stop there. The mechanism matters more than the marketing.\n            </p>\n            <div class=\"grid lg:grid-cols-2 gap-0 border border-white/10\" data-kid=\"1-5-3-3\" data-name=\"comparison grid container\">\n                <div class=\"p-8 bg-[#1a0508]/60 border-b lg:border-b-0 lg:border-r border-dashed border-white/15\" data-kid=\"1-5-3-3-1\" data-name=\"centralized approach card\">\n                    <div class=\"fm text-[11px] uppercase tracking-[0.2em] text-[#ff5c6e] mb-6\" data-kid=\"1-5-3-3-1-1\" data-name=\"approach label\">\n                        The spreadsheet way\n                    </div>\n                    <svg class=\"w-full mb-7\" data-kid=\"1-5-3-3-1-2\" data-name=\"diagram visualization\" viewbox=\"0 0 380 170\">\n                        <g fill=\"#ffffff99\" font-family=\"JetBrains Mono, monospace\" font-size=\"9\">\n                            <rect fill=\"#010B13\" height=\"26\" stroke=\"#ffffff33\" width=\"80\" x=\"10\" y=\"10\">\n                            </rect>\n                            <text text-anchor=\"middle\" x=\"50\" y=\"27\">\n                                clients\n                            </text>\n                            <path d=\"M90 23 H150\" stroke=\"#ff5c6e\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\">\n                            </path>\n                            <rect fill=\"#2a070c\" height=\"46\" stroke=\"#ff5c6e\" stroke-width=\"1.5\" width=\"90\" x=\"150\" y=\"60\">\n                            </rect>\n                            <text fill=\"#ff8a96\" text-anchor=\"middle\" x=\"195\" y=\"80\">\n                                one human\n                            </text>\n                            <text fill=\"#ffffff77\" text-anchor=\"middle\" x=\"195\" y=\"94\">\n                                holds 100%\n                            </text>\n                            <path d=\"M90 23 Q120 23 150 62\" fill=\"none\" stroke=\"#ff5c6e\" stroke-width=\"1.5\">\n                            </path>\n                            <path d=\"M195 106 V130 M195 130 H60 M60 130 V148 M195 130 H330 M330 130 V148 M195 130 V148\" fill=\"none\" stroke=\"#ff5c6e55\" stroke-dasharray=\"3 3\" stroke-width=\"1.2\">\n                            </path>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#ffffff22\" width=\"60\" x=\"30\" y=\"148\">\n                            </rect>\n                            <text text-anchor=\"middle\" x=\"60\" y=\"161\">\n                                payee\n                            </text>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#ffffff22\" width=\"60\" x=\"165\" y=\"148\">\n                            </rect>\n                            <text text-anchor=\"middle\" x=\"195\" y=\"161\">\n                                payee\n                            </text>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#ffffff22\" width=\"60\" x=\"300\" y=\"148\">\n                            </rect>\n                            <text text-anchor=\"middle\" x=\"330\" y=\"161\">\n                                payee\n                            </text>\n                            <text fill=\"#ff8a96\" font-size=\"8\" x=\"255\" y=\"86\">\n                                manual, discretionary\n                            </text>\n                        </g>\n                    </svg>\n                    <ul class=\"space-y-3 text-[14px] text-white/60\" data-kid=\"1-5-3-3-1-3\" data-name=\"feature bullet points list\">\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-1-3-1\">\n                            <span class=\"fm text-[#ff5c6e]\" data-kid=\"1-5-3-3-1-3-1-1\">\n                                —\n                            </span>\n                            Custodian can pay late, pay wrong, or not pay.\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-1-3-2\">\n                            <span class=\"fm text-[#ff5c6e]\" data-kid=\"1-5-3-3-1-3-2-1\">\n                                —\n                            </span>\n                            Splits live in a doc that anyone with edit access can change.\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-1-3-3\">\n                            <span class=\"fm text-[#ff5c6e]\" data-kid=\"1-5-3-3-1-3-3-1\">\n                                —\n                            </span>\n                            Platform alternatives take a cut and can freeze funds.\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-1-3-4\">\n                            <span class=\"fm text-[#ff5c6e]\" data-kid=\"1-5-3-3-1-3-4-1\">\n                                —\n                            </span>\n                            Verification means asking someone and believing them.\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"p-8 bg-[#002147]/50\" data-kid=\"1-5-3-3-2\" data-name=\"decentralized approach card\">\n                    <div class=\"fm text-[11px] uppercase tracking-[0.2em] text-[#00FF40] mb-6\" data-kid=\"1-5-3-3-2-1\" data-name=\"approach label\">\n                        PayPool\n                    </div>\n                    <svg class=\"w-full mb-7\" data-kid=\"1-5-3-3-2-2\" data-name=\"diagram visualization\" viewbox=\"0 0 380 170\">\n                        <g fill=\"#ffffff99\" font-family=\"JetBrains Mono, monospace\" font-size=\"9\">\n                            <rect fill=\"#010B13\" height=\"26\" stroke=\"#ffffff33\" width=\"80\" x=\"10\" y=\"10\">\n                            </rect>\n                            <text text-anchor=\"middle\" x=\"50\" y=\"27\">\n                                clients\n                            </text>\n                            <path class=\"flow\" d=\"M90 23 Q140 23 172 58\" fill=\"none\" stroke=\"#00FF40\" stroke-width=\"1.5\">\n                            </path>\n                            <rect fill=\"#010B13\" height=\"48\" stroke=\"#00FF40\" stroke-width=\"1.5\" width=\"110\" x=\"140\" y=\"58\">\n                            </rect>\n                            <text fill=\"#00FF40\" text-anchor=\"middle\" x=\"195\" y=\"78\">\n                                PayPool.sol\n                            </text>\n                            <text fill=\"#ffffff77\" text-anchor=\"middle\" x=\"195\" y=\"93\">\n                                immutable\n                            </text>\n                            <path class=\"flow\" d=\"M170 106 V126 Q170 138 120 138 L60 138 V148\" fill=\"none\" stroke=\"#00FF40\" stroke-width=\"1.5\">\n                            </path>\n                            <path class=\"flow\" d=\"M195 106 V148\" fill=\"none\" stroke=\"#3B82F6\" stroke-width=\"1.5\" style=\"animation-delay:.4s\">\n                            </path>\n                            <path class=\"flow\" d=\"M222 106 V126 Q222 138 272 138 L330 138 V148\" fill=\"none\" stroke=\"#FF00FF\" stroke-width=\"1.5\" style=\"animation-delay:.8s\">\n                            </path>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#00FF4055\" width=\"60\" x=\"30\" y=\"148\">\n                            </rect>\n                            <text fill=\"#00FF40\" text-anchor=\"middle\" x=\"60\" y=\"161\">\n                                payee\n                            </text>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#3B82F655\" width=\"60\" x=\"165\" y=\"148\">\n                            </rect>\n                            <text fill=\"#60A5FA\" text-anchor=\"middle\" x=\"195\" y=\"161\">\n                                payee\n                            </text>\n                            <rect fill=\"none\" height=\"18\" stroke=\"#FF00FF55\" width=\"60\" x=\"300\" y=\"148\">\n                            </rect>\n                            <text fill=\"#FF00FF\" text-anchor=\"middle\" x=\"330\" y=\"161\">\n                                payee\n                            </text>\n                            <text fill=\"#00FF40\" font-size=\"8\" x=\"262\" y=\"80\">\n                                pull-based\n                            </text>\n                        </g>\n                    </svg>\n                    <ul class=\"space-y-3 text-[14px] text-white/70\" data-kid=\"1-5-3-3-2-3\" data-name=\"feature bullet points list\">\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-2-3-1\">\n                            <span class=\"fm text-[#00FF40]\" data-kid=\"1-5-3-3-2-3-1-1\">\n                                ✓\n                            </span>\n                            <span data-kid=\"1-5-3-3-2-3-1-2\">\n                                <span class=\"fm text-white\" data-kid=\"1-5-3-3-2-3-1-2-1\">\n                                    Immutable payee list\n                                </span>\n                                — set once in\n                                <span class=\"fm\" data-kid=\"1-5-3-3-2-3-1-2-2\">\n                                    initialize()\n                                </span>\n                                , reverts on any second call.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-2-3-2\">\n                            <span class=\"fm text-[#00FF40]\" data-kid=\"1-5-3-3-2-3-2-1\">\n                                ✓\n                            </span>\n                            <span data-kid=\"1-5-3-3-2-3-2-2\">\n                                <span class=\"fm text-white\" data-kid=\"1-5-3-3-2-3-2-2-1\">\n                                    No admin keys\n                                </span>\n                                — no owner, no pause, no upgrade proxy.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-2-3-3\">\n                            <span class=\"fm text-[#00FF40]\" data-kid=\"1-5-3-3-2-3-3-1\">\n                                ✓\n                            </span>\n                            <span data-kid=\"1-5-3-3-2-3-3-2\">\n                                <span class=\"fm text-white\" data-kid=\"1-5-3-3-2-3-3-2-1\">\n                                    Pull-based withdrawals\n                                </span>\n                                — anyone may trigger\n                                <span class=\"fm\" data-kid=\"1-5-3-3-2-3-3-2-2\">\n                                    release()\n                                </span>\n                                , funds route only to the payee.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-5-3-3-2-3-4\">\n                            <span class=\"fm text-[#00FF40]\" data-kid=\"1-5-3-3-2-3-4-1\">\n                                ✓\n                            </span>\n                            <span data-kid=\"1-5-3-3-2-3-4-2\">\n                                <span class=\"fm text-white\" data-kid=\"1-5-3-3-2-3-4-2-1\">\n                                    address(0) = ETH\n                                </span>\n                                — one accounting path for native and ERC-20.\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- DASHBOARD PREVIEW -->\n    <section class=\"max-w-[1240px] mx-auto px-6 py-24\" data-kid=\"1-6\" data-name=\"dashboard preview section\">\n        <div class=\"max-w-2xl mb-16\" data-kid=\"1-6-1\" data-name=\"section intro container\">\n            <div class=\"reveal fm text-[11px] text-[#FF00FF] uppercase tracking-[0.22em] mb-4\" data-kid=\"1-6-1-1\" data-name=\"section subheadline\">\n                Dashboard · convenience layer, not source of truth\n            </div>\n            <h2 class=\"reveal fh text-[44px] leading-[1] font-bold tracking-[-0.02em]\" data-kid=\"1-6-1-2\" data-name=\"section headline\">\n                You shouldn't need a block explorer to know what you're owed.\n            </h2>\n        </div>\n        <div class=\"relative pt-10\" data-kid=\"1-6-2\" data-name=\"dashboard visualization container\">\n            <div class=\"absolute -top-2 left-6 right-6 lg:left-10 lg:right-10 z-10 grid grid-cols-3 gap-4\" data-kid=\"1-6-2-1\" data-name=\"dashboard metric cards row\">\n                <div class=\"reveal bg-[#002147] border border-[#00FF40]/35 p-4 shadow-[0_16px_40px_-30px_#00FF40]\" data-kid=\"1-6-2-1-1\" data-name=\"total received metric card\">\n                    <div class=\"fm text-[10px] text-white/40 uppercase tracking-[0.16em]\" data-kid=\"1-6-2-1-1-1\" data-name=\"metric label\">\n                        Total received\n                    </div>\n                    <div class=\"fm text-[24px] lg:text-[28px] text-[#00FF40] mt-1\" data-dynamic=\"true\" data-kid=\"1-6-2-1-1-2\" data-name=\"metric value\" data-reason=\"counter updated by script on scroll\">\n                        <span class=\"cnt\" data-kid=\"1-6-2-1-1-2-1\" data-to=\"1.0528\">\n                            0.0000\n                        </span>\n                        ETH\n                    </div>\n                </div>\n                <div class=\"reveal bg-[#002147] border border-white/12 p-4\" data-kid=\"1-6-2-1-2\" data-name=\"total released metric card\">\n                    <div class=\"fm text-[10px] text-white/40 uppercase tracking-[0.16em]\" data-kid=\"1-6-2-1-2-1\" data-name=\"metric label\">\n                        Total released\n                    </div>\n                    <div class=\"fm text-[24px] lg:text-[28px] text-white mt-1\" data-dynamic=\"true\" data-kid=\"1-6-2-1-2-2\" data-name=\"metric value\" data-reason=\"counter updated by script on scroll\">\n                        <span class=\"cnt\" data-kid=\"1-6-2-1-2-2-1\" data-to=\"0.6317\">\n                            0.0000\n                        </span>\n                        ETH\n                    </div>\n                </div>\n                <div class=\"reveal bg-[#002147] border border-[#FF00FF]/35 p-4\" data-kid=\"1-6-2-1-3\" data-name=\"pending metric card\">\n                    <div class=\"fm text-[10px] text-white/40 uppercase tracking-[0.16em]\" data-kid=\"1-6-2-1-3-1\" data-name=\"metric label\">\n                        Pending\n                    </div>\n                    <div class=\"fm text-[24px] lg:text-[28px] text-[#FF00FF] mt-1\" data-dynamic=\"true\" data-kid=\"1-6-2-1-3-2\" data-name=\"metric value\" data-reason=\"counter updated by script on scroll\">\n                        <span class=\"cnt\" data-kid=\"1-6-2-1