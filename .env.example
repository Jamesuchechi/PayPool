# PayPool Root Environment Variables

# --- Local Docker PostgreSQL Setup ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paypool

# --- Production Cloud PostgreSQL (Neon / Supabase) Setup Example ---
# NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/paypool?sslmode=require

# --- Blockchain RPC Configuration ---
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# --- Indexer Polling Tuning ---
CONFIRMATION_DEPTH=5
POLL_INTERVAL_SECONDS=15
BATCH_SIZE=2000
